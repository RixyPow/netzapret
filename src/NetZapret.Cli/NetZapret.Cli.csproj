<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!--
      Прежнее имя, netzapret, отдано окну: программа теперь оконная, и это
      её имя. Консоль осталась инструментом разработчика — watch, rules,
      test, — и в поставку не входит.

      Переименовать одну без другой нельзя: обе кладутся в одну папку,
      Windows не различает регистр, и netzapret.dll рядом с NetZapret.dll
      оказывались одним файлом.
    -->
    <AssemblyName>NetZapretOld</AssemblyName>
    <RootNamespace>NetZapret.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetZapret.Core\NetZapret.Core.csproj" />
    <ProjectReference Include="..\NetZapret.Wfp\NetZapret.Wfp.csproj" />
    <ProjectReference Include="..\NetZapret.Etw\NetZapret.Etw.csproj" />
    <ProjectReference Include="..\NetZapret.Subscriptions\NetZapret.Subscriptions.csproj" />
    <ProjectReference Include="..\NetZapret.Proxy\NetZapret.Proxy.csproj" />
    <ProjectReference Include="..\NetZapret.Zapret\NetZapret.Zapret.csproj" />
    <ProjectReference Include="..\NetZapret.Supervisor\NetZapret.Supervisor.csproj" />
    <ProjectReference Include="..\NetZapret.Dns\NetZapret.Dns.csproj" />
  </ItemGroup>

</Project>
