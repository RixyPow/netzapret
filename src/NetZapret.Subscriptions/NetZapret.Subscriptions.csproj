<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Под Windows и под чистый net8.0 — его берёт приложение для Android
    (docs/android.md). TargetFramework из Directory.Build.props гасится:
    пока он задан, MSBuild не делит сборку по TargetFrameworks.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net8.0</TargetFrameworks>
    <TargetFramework></TargetFramework>
  </PropertyGroup>

  <!--
    ZXing.Net — чтение QR-кодов с ключами (01.10): встроенного распознавания
    в Windows нет. Apache-2.0, назван в docs/THIRD-PARTY.md.
  -->
  <ItemGroup>
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetZapret.Core\NetZapret.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetZapret.Core.Tests" />
  </ItemGroup>

</Project>
