<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Под Windows и под чистый net8.0 — его берёт приложение для Android
    (docs/android.md). TargetFramework из Directory.Build.props гасится:
    пока он задан, MSBuild не делит сборку по TargetFrameworks.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net8.0</TargetFrameworks>
    <TargetFramework></TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Нужен ради кодовой страницы 866: планировщик отвечает в кодировке OEM,
      а .NET Core устаревшие страницы по умолчанию не содержит, и обращение
      к ним падает с NotSupportedException.
    -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetZapret.Core\NetZapret.Core.csproj" />
    <ProjectReference Include="..\NetZapret.Proxy\NetZapret.Proxy.csproj" />
    <ProjectReference Include="..\NetZapret.Zapret\NetZapret.Zapret.csproj" />
    <ProjectReference Include="..\NetZapret.Etw\NetZapret.Etw.csproj" />
  </ItemGroup>

</Project>
