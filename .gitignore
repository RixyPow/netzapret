bin/
obj/

# Развёрнутая копия, из которой программа запускается — см. build.cmd.
# Туда же складываются движки: sing-box и нужная часть Zapret.
build/
engines/

# Готовый дистрибутив — см. pack.cmd. Внутри чужие движки, им не место
# в репозитории; архив прикладывается к релизу.
dist/
*.user
*.suo
.vs/
artifacts/

# Внешние движки: качаются отдельно, в репозиторий не кладутся — своя
# версионность, свои лицензии, десятки мегабайт. Каталог остаётся ради
# инструкции в нём, иначе после клонирования непонятно, что туда класть.
tools/*
!tools/README.md

# Рантайм-артефакты диспетчера
logs/
runtime/

# Распакованный исходный пак флагов. В репозитории лежат только вырезанные
# из него PNG и уведомление о лицензии; полутысяча SVG и файлов чужого
# репозитория здесь не нужна.
gui/NetZapret.Gui/Assets/flags/flag-icons-main/

# Кэш значков сайтов: берётся у самих сайтов и восстанавливается сам.
runtime/icons/

# Отчёты проверки блокировок. Пишутся при каждом прогоне и хранят снимок
# сети конкретного человека — какие сайты он проверяет, каким оператором
# пользуется, что у него прибито в hosts.
reports/
config/subscription.cache.json

# Личные настройки: содержат ссылку на подписку, а она равносильна паролю —
# по ней выдаётся весь список серверов с учётными данными. Однажды файл уже
# попал в историю коммитов, и её пришлось переписывать целиком.
# Образец без ключа лежит рядом: config/netzapret.example.json
config/netzapret.json

# Список подписок из раздела VPN. Причина та же и цена та же: внутри
# несколько ссылок, и каждая равносильна паролю.
config/subscriptions.json

# Учётная запись WARP: закрытый ключ WireGuard и ключ доступа к самой записи.
# Ровно та же цена, что у ссылки подписки, — с этим файлом чужой человек
# ходит в интернет от вашего имени.
config/warp.json

# Личные маршруты. Файл ведёт сама программа и переписывает при каждой правке
# из меню, так что в истории он давал бы шум вместо смысла. Отсутствие файла
# не ошибка: он создаётся при первом сохранении.
config/rules.user.yaml

# Порядок пресетов, разложенный руками в окне. Личная раскладка одного
# человека: в репозитории она давала бы шум, а её отсутствие не ошибка —
# без файла список идёт по алфавиту.
config/preset-order.json

# Черновая записка, оставшаяся от прошлой работы. В репозиторий не идёт,
# но и удалять её не нам: лежит на диске, если ещё пригодится.
docs/rollback-todo.md
