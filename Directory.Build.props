<Project>

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <!--
      Библиотеки src/ собираются ещё и под чистый net8.0 — его берёт
      приложение для Android. Там x64 неверен: телефон — arm64, и сборка
      под одну платформу не загрузилась бы. Во внутренней сборке
      мультитаргета TargetFramework задан глобально, поэтому условие
      здесь, в props, видит именно его.
    -->
    <PlatformTarget Condition="'$(TargetFramework)' == 'net8.0'">AnyCPU</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Сборка должна повторяться у постороннего человека, иначе «соберите сами
    и сверьте» — пустой совет. Проверено 2026-09-07: две подряд у нас дают
    один и тот же SHA256, но этого мало — совпадать должно и на чужой машине.

    Deterministic компилятор включает сам; здесь важнее второе. Без
    DeterministicSourcePaths в файл попадают абсолютные пути сборочной машины,
    и у собравшего в другой папке выходит другой файл при том же исходнике.
    Заодно это утечка: в выпущенном netzapret.exe лежала строка
    C:\Users\<имя>\Projects\netzapret\..., то есть имя пользователя уезжало
    каждому скачавшему.

    Версию пакета SDK задаёт global.json — она влияет на IL не меньше.
  -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <DeterministicSourcePaths Condition="'$(Configuration)' == 'Release'">true</DeterministicSourcePaths>

    <!--
      Нужен для DeterministicSourcePaths вне непрерывной сборки: без него
      MSBuild жалуется, что корень исходников не задан. Отображение делает
      то же, что сделал бы сервер сборки, — заменяет корень на нейтральный.
    -->
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    Сведения о продукте попадают в свойства собранных файлов: у распространяемой
    программы они видны в «Свойствах» файла, и пустые поля там выглядят так же,
    как у winws2.exe, чью лицензию нам пришлось выяснять на стороне.
  -->
  <PropertyGroup>
    <Product>NetZapret</Product>
    <Company>RixyPow</Company>
    <Copyright>Copyright (c) 2026 RixyPow. MIT License.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/RixyPow/netzapret</RepositoryUrl>

    <!--
      Ноль в старшем разряде намеренно: единица означала бы обещание, что формат
      правил и поведение не поменяются под теми, кто уже поставил. Формат ещё
      растёт — секция capture, тип ipset и два режима работы появились последними.
      Без явного значения .NET подставляет 1.0.0, и файл заявлял бы стабильность,
      которой нет, вдобавок расходясь с тегом релиза.
    -->
    <Version>1.1.2</Version>
  </PropertyGroup>

  <!--
    Проект целиком x64-only: WFP-интероп содержит зашитые смещения полей
    структур для x64 ABI. Сборка под x86/ARM64 даст молча неверный разбор,
    поэтому лучше упасть на этапе компиляции.
    Сторож — только для сборки под Windows: чистый net8.0 (Android) WFP
    не зовёт, а x64 ему как раз нельзя. Условие у цели, а не у свойства:
    TargetPlatformIdentifier известен лишь после разбора TargetFramework.
  -->
  <Target Name="GuardAgainstNonX64" BeforeTargets="Build"
          Condition="'$(TargetPlatformIdentifier)' == 'Windows'">
    <Error Condition="'$(PlatformTarget)' != 'x64'"
           Text="NetZapret собирается только под x64 (WFP-интероп завязан на x64 layout)." />
  </Target>

</Project>
