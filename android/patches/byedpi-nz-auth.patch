+/*
+ * NetZapret: имя и пароль SOCKS5 (RFC 1929) из переменной окружения
+ * NZ_BYEDPI_AUTH=имя:пароль. На телефоне любое приложение может открыть
+ * 127.0.0.1 чужого приложения, а ByeDPI ходит мимо VPN: без пароля через
+ * него узнаётся настоящий адрес, а сам ответ 05 00 выдаёт средство обхода.
+ * С паролем на приветствие без метода 0x02 ByeDPI молчит и закрывает
+ * соединение — сканеру нечего опознать.
+ */
+static const char *nz_auth_user, *nz_auth_pass;
+static size_t nz_auth_ulen, nz_auth_plen;
+static int nz_auth_init;
+
+static int nz_auth_enabled(void)
+{
+    if (!nz_auth_init) {
+        nz_auth_init = 1;
+        const char *v = getenv("NZ_BYEDPI_AUTH");
+        const char *sep = v ? strchr(v, ':') : 0;
+        if (sep && sep != v && sep[1] && (sep - v) < 256 && strlen(sep + 1) < 256) {
+            char *copy = strdup(v);
+            if (copy) {
+                copy[sep - v] = 0;
+                nz_auth_user = copy;
+                nz_auth_pass = copy + (sep - v) + 1;
+                nz_auth_ulen = strlen(nz_auth_user);
+                nz_auth_plen = strlen(nz_auth_pass);
+            }
+        }
+    }
+    return nz_auth_user != 0;
+}
+
+/* Сравнение за время, не зависящее от совпавшей части. */
+static int nz_same(const char *a, size_t alen, const char *b, size_t blen)
+{
+    uint8_t diff = (uint8_t)(alen != blen);
+    for (size_t i = 0; i < alen && i < blen; i++)
+        diff |= (uint8_t)(a[i] ^ b[i]);
+    return diff == 0;
+}
+
+/* 0 — без пароля, 1 — ждём имя и пароль, -1 — закрыть. */
