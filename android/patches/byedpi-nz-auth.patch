+/*
+ * NetZapret: срок и лимит соединениям, ещё не назвавшим пароль.
+ *
+ * ByeDPI не закрывает клиента, который молчит: таймеры у него ставятся
+ * только исходящим соединениям (desync.c, extend.c), а -T — это
+ * TCP_USER_TIMEOUT того же исходящего сокета. Пул постоянный: при -c 1024
+ * в нём 2049 мест (init_pool(max_open * 2 + 1)), и при полном пуле
+ * on_accept закрывает каждое новое соединение, а процесс живёт — NzByeDpi
+ * его не перезапустит. Приложению с правом INTERNET хватило бы найти порт
+ * перебором 127.0.0.1 и занять все места молчащими соединениями, пароль
+ * для этого не нужен: «десинк» и весь невыведенный TCP телефона
+ * (DesyncSocksDefault) стояли бы до перезапуска NetZapret. Прочитано
+ * в коде 27.10, на телефоне не проверено.
+ *
+ * Поэтому, только когда задан пароль (без него ByeDPI работает как был):
+ *  - NZ_PREAUTH_MS на приветствие и пароль. sing-box на 127.0.0.1
+ *    проходит их за доли миллисекунды; 3 с — с запасом телефону под нагрузкой;
+ *  - не больше NZ_PREAUTH_MAX ожидающих пароля разом, и лишнее вытесняет
+ *    самое старое из них, а не отказывает новому. Срока одного мало: 2048
+ *    мест по 3 с держит и тот, кто открывает ~700 соединений в секунду.
+ *    Отказ новому отдал бы лимит тому, кто стучит чаще sing-box, а при
+ *    вытеснении старейшего соединению sing-box нужно лишь успеть пройти
+ *    пароль, пока не придут NZ_PREAUTH_MAX чужих. Аутентифицированным
+ *    остаётся весь прочий пул;
+ *  - не больше NZ_ACCEPT_BURST приёмов за проход цикла. on_accept принимает,
+ *    пока очередь не опустеет, и поток соединений вытеснил бы ожидающее
+ *    sing-box в том же проходе, раньше, чем цикл дочитает его приветствие.
+ *    Так у него не меньше NZ_PREAUTH_MAX / NZ_ACCEPT_BURST = 16 проходов.
+ *    Слушатель в epoll без EPOLLET: оставшиеся в очереди он отдаст снова.
+ */
+#define NZ_PREAUTH_MS 3000
+#define NZ_PREAUTH_MAX 128
+#define NZ_ACCEPT_BURST 8
+
+/* Место новому ожидающему: при полном лимите закрыть самое старое. */
+static void nz_preauth_make_room(struct poolhd *pool)
+{
+    if (pool->nz_preauth < NZ_PREAUTH_MAX) {
+        return;
+    }
+    /* Срок у всех ожидающих один, а set_timer держит таймеры по возрастанию
+       срока — первое ожидающее в списке и есть старейшее. Таймеры исходящих
+       соединений перед ним просто пропускаются. */
+    for (struct eval *v = pool->tv_start; v; v = v->tv_next) {
+        if (!v->nz_preauth) {
+            continue;
+        }
+        /* Каждое 1024-е — в журнал: виден сам натиск, а не тысячи строк. */
+        static unsigned long evicted;
+        if (evicted++ % 1024 == 0) {
+            LOG(LOG_E, "nz: over %d connections without password, "
+                "closing oldest (%lu so far)\n", NZ_PREAUTH_MAX, evicted);
+        }
+        del_event(pool, v);
+        return;
+    }
+}
+
+/* Срок на пароль — только соединению, которое ждёт запроса SOCKS. */
+static void nz_preauth_start(struct poolhd *pool, struct eval *val)
+{
+    if (!nz_auth_enabled() || val->cb != &on_request) {
+        return;
+    }
+    val->nz_preauth = 1;
+    pool->nz_preauth++;
+    set_timer(pool, val, NZ_PREAUTH_MS);
+}
+
+/* Пароль принят — это sing-box: срок и место в лимите снимаются сразу.
+   Оставленный таймер сработал бы позже в on_tunnel как POLLTIMEOUT,
+   и тот принял бы его за таймер десинка (on_timeout). */
+static void nz_preauth_done(struct poolhd *pool, struct eval *val)
+{
+    if (!val->nz_preauth) {
+        return;
+    }
+    val->nz_preauth = 0;
+    pool->nz_preauth--;
+    remove_timer(pool, val);
+}
