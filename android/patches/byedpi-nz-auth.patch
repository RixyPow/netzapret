         if (buffer[i] == S_AUTH_NONE) {
@@ -170,6 +224,30 @@ static int auth_socks5(int fd, const char *buffer, ssize_t n)
     return c != S_AUTH_BAD ? 0 : -1;
 }
 
+/* Подсогласование RFC 1929: 01 ulen имя plen пароль. */
+static int auth_socks5_pass(int fd, const char *buffer, ssize_t n)
+{
+    if (n < 3 || (uint8_t)buffer[0] != 0x01) {
+        return -1;
+    }
+    size_t ulen = (uint8_t)buffer[1];
+    if ((ssize_t)(2 + ulen + 1) > n) {
+        return -1;
+    }
+    size_t plen = (uint8_t)buffer[2 + ulen];
+    if ((ssize_t)(3 + ulen + plen) != n) {
+        return -1;
+    }
+    int ok = nz_same(buffer + 2, ulen, nz_auth_user, nz_auth_ulen)
+        & nz_same(buffer + 3 + ulen, plen, nz_auth_pass, nz_auth_plen);
+    uint8_t a[2] = { 0x01, ok ? 0x00 : 0x01 };
+    if (send(fd, (char *)a, sizeof(a), 0) < 0) {
+        uniperror("send");
+        return -1;
+    }
+    return ok ? 0 : -1;
+}
