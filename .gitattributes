# Нормализуем переводы строк при коммите, в рабочем каталоге — как принято в ОС.
* text=auto

# Батники читает cmd.exe, и он требует CRLF: с LF строка вида "if ... (" рвётся
# и выполняется как отдельная команда. Явно, потому что text=auto тут полагается
# на угадывание.
*.cmd text eol=crlf
*.bat text eol=crlf

# Скрипты для sh, наоборот, ломаются от CR: интерпретатор читает его как часть
# имени команды.
*.sh text eol=lf

# Двоичное — не трогать.
*.png binary
*.ico binary
*.dll binary
*.exe binary
*.bundle binary
