# Нормализуем переводы строк при коммите, в рабочем каталоге — как принято в ОС.
* text=auto

# Батники читает cmd.exe, и он требует CRLF: с LF строка вида "if ... (" рвётся
# и выполняется как отдельная команда. Явно, потому что text=auto тут полагается
# на угадывание.
*.cmd text eol=crlf
*.bat text eol=crlf

# Скрипты для sh, наоборот, ломаются от CR: интерпретатор читает его как часть
# имени команды.
*.sh text eol=lf

# Правки чужих исходников (android/patches/) ложатся на файлы из git archive
# с LF (engines.ps1). При core.autocrlf=true — умолчании Git для Windows —
# свежая выписка отдала бы правку с CRLF, и git apply отказал бы на каждом
# куске (проверено 27.10 на byedpi-nz-auth.patch: conev.c, conev.h, main.c,
# proxy.c, proxy.h — «patch does not apply»). Рабочая копия, где правку
# писал инструмент с LF, этого не видит.
*.patch text eol=lf

# Двоичное — не трогать.
*.png binary
*.ico binary
*.dll binary
*.exe binary
*.bundle binary
*.bin binary
*.sys binary
*.sqlite3 binary

# Копия файлов Zapret GUI — побайтно, как у них (ZapretGuiCopy): списки
# с CRLF, у шаблонов фильтра последняя строка без перевода. Нормализация
# концов дала бы в архиве не те файлы, что в установке. Дифф по тексту
# при этом остаётся — -text снимает только перевод концов строк.
vendor/zapret-gui/** -text
