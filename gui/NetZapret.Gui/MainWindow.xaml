<Window x:Class="NetZapret.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NetZapret.Gui.Views"
        Title="NetZapret"
        Height="720" Width="1080"
        MinHeight="560" MinWidth="880"
        Background="{StaticResource Backdrop}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            Боковое меню. Полоса, а не вкладки: разделов девять, и все они
            равноправны — проверку блокировок нельзя прятать глубже
            остальных, она и отличает нас от любого клиента VPN.
        -->
        <Border Grid.Column="0" Background="{StaticResource Backdrop}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top" Margin="22,26,22,22">
                    <TextBlock Text="NetZapret" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionLabel" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>

                <!--
                    Строка о правах внизу и вполголоса. Сказать о них надо —
                    окно работает с полными правами, и человек вправе это
                    знать, — но каждый раз кричать об этом незачем.
                -->
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}"
                           Margin="22,0,22,18" TextWrapping="Wrap"
                           Text="Работает от администратора: иначе не поставить драйвер перехвата и не поднять TUN." />

                <!--
                    Полоса прокручивается: разделов девять, и на невысоком
                    окне последний иначе уезжает за нижний край — а уехавшего
                    пункта не существует, его не найти.
                -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <StackPanel x:Name="Rail">
                        <RadioButton Style="{StaticResource RailItem}" Content="Главная" Tag="status" IsChecked="True" Checked="OnSection" />
                        <RadioButton Style="{StaticResource RailItem}" Content="VPN" Tag="vpn" Checked="OnSection" />
                        <RadioButton Style="{StaticResource RailItem}" Content="Десинк" Tag="desync" Checked="OnSection" />
                        <RadioButton Style="{StaticResource RailItem}" Content="Маршруты" Tag="routes" Checked="OnSection" />
                        <RadioButton Style="{StaticResource RailItem}" Content="Проверка блокировок" Tag="check" Checked="OnSection" />
                        <RadioButton Style="{StaticResource RailItem}" Content="DNS" Tag="dns" Checked="OnSection" />
                        <RadioButton Style="{StaticResource RailItem}" Content="Файл hosts" Tag="hosts" Checked="OnSection" />
                        <RadioButton Style="{StaticResource RailItem}" Content="Журнал" Tag="log" Checked="OnSection" />
                        <RadioButton Style="{StaticResource RailItem}" Content="Ещё" Tag="more" Checked="OnSection" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <ContentControl x:Name="Section">
                <views:StatusView />
            </ContentControl>

            <!--
                Предложение перезапустить движки. Внизу справа и само уходит:
                почти всё, что меняется в окне, применяется перезапуском,
                и говорить об этом строкой в глубине раздела значит не сказать
                вовсе. Но и держать перед глазами нельзя — правок за один
                заход бывает десяток.
            -->
            <Border x:Name="Toast" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,28,24" MaxWidth="460"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Accent}" BorderThickness="1"
                    CornerRadius="10" Padding="18,15">
                <StackPanel>
                    <TextBlock x:Name="ToastTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ToastBody" Style="{StaticResource Caption}"
                               Margin="0,6,0,0" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Style="{StaticResource Ghost}" Content="Позже"
                                Padding="16,7" Margin="0,0,8,0" Click="OnToastLater" />
                        <Button x:Name="ToastAct" Style="{StaticResource Primary}"
                                Content="Перезапустить" Padding="18,8" Click="OnToastRestart" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
