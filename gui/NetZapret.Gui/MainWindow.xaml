<Window x:Class="NetZapret.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NetZapret.Gui.Views"
        xmlns:local="clr-namespace:NetZapret.Gui"
        Title="NetZapret"
        Height="720" Width="1080"
        MinHeight="560" MinWidth="880"
        Background="{DynamicResource Backdrop}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <!--
        Масштаб окна из «Ещё» → «Шрифт и размер»: всё окно целиком, как
        «масштаб» в Telegram. Стекло считается в координатах этой же сетки,
        поэтому от масштаба не съезжает.
    -->
    <Grid x:Name="Root" LayoutTransform="{DynamicResource UiScaleTransform}">
        <Grid.ColumnDefinitions>
            <!--
                Ширину задаёт сама полоса меню (RailBorder): 236 или 72 свёрнутой
                (11.11, ApplyRail). 236 — шире на значок с отступом (30.09): под них
                ушло 30 точек, а самой длинной подписи, «Проверке блокировок», нужна
                прежняя ширина.
            -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            Фон темы: картинка и затемнение цветом подложки, под меню и под
            содержимым. У встроенных тем картинки нет, и оба слоя сливаются
            с подложкой окна. Не ловят мышь: под ними ничего нет, а над ними
            всё окно.
        -->
        <Rectangle x:Name="BackdropLayer" Grid.ColumnSpan="2" IsHitTestVisible="False" Fill="{DynamicResource BackdropImage}" />
        <Rectangle Grid.ColumnSpan="2" IsHitTestVisible="False" Fill="{DynamicResource Backdrop}"
                   Opacity="{DynamicResource BackdropDim}" />

        <!--
            Боковое меню. Полоса, а не вкладки: разделов девять, и все они
            равноправны — проверку блокировок нельзя прятать глубже
            остальных, она и отличает нас от любого клиента VPN.
        -->
        <Border Grid.Column="0" x:Name="RailBorder" Style="{StaticResource RailPanel}" Width="236">
            <DockPanel LastChildFill="True">

                <!--
                    Плитка рядом с именем — владелец 19.10 («это тоже делай»),
                    по макету «Главной»; до того было решено «логотипа нет —
                    пока оставим что есть». До 21.10 — буквы «NZ» цветами наоборот
                    к странице; с 21.10 — эмблема в трёх цветах темы.
                -->
                <!--
                    Эмблема и стрелка справа от имени сворачивают и разворачивают
                    меню (13.11, владелец; 12.11 эмблема вела на «Главную»). Эмблема — на оси значков меню (x 33), поэтому при
                    сворачивании не сдвигается (ApplyRail).
                -->
                <Grid x:Name="LogoRow" DockPanel.Dock="Top" Margin="13,24,8,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="RailCollapse" Grid.Column="2" Style="{StaticResource IconGhost}" Content="&#xE76B;"
                            FontSize="12" Padding="7,6" MinWidth="0" VerticalAlignment="Center" Focusable="False"
                            Click="OnRailToggle" ToolTip="Свернуть меню" />

                    <!--
                        С 21.10 — эмблема вместо букв «NZ» (владелец: «эмблему в левом
                        верхнем тоже поменяй на новую»): три фигуры из svg в цветах
                        темы (LogoTop, LogoBand, LogoBottom; Emblem). Кривая первой
                        и с обводкой — в стыках заливок иначе просвечивает шов;
                        обводка в 5 точек svg — пиксель на плитке в 40 при 125 %.
                    -->
                    <Viewbox x:Name="LogoMark" Width="40" Height="40" VerticalAlignment="Center" Margin="0,0,13,0"
                             Cursor="Hand" ToolTip="Свернуть меню" MouseLeftButtonUp="OnLogoClick">
                        <Canvas Width="256" Height="256" Clip="{x:Static local:Emblem.Outline}">
                            <Path Data="{x:Static local:Emblem.Band}" Fill="{DynamicResource LogoBand}"
                                  Stroke="{DynamicResource LogoBand}" StrokeThickness="5" StrokeLineJoin="Round" />
                            <Path Data="{x:Static local:Emblem.Top}" Fill="{DynamicResource LogoTop}" />
                            <Path Data="{x:Static local:Emblem.Bottom}" Fill="{DynamicResource LogoBottom}" />
                        </Canvas>
                    </Viewbox>

                    <StackPanel x:Name="LogoText" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="NetZapret" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionLabel" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!--
                    «Что нужно сделать?» (11.11, по образцу стенда разработчика):
                    поиск по задачам разделов, Ctrl+K. Сама строка — кнопка: искать
                    начинают в палитре (PaletteLayer), которая ложится поверх неё,
                    — так один путь и у развёрнутого меню, и у свёрнутого до значков.
                -->
                <Button x:Name="SearchButton" DockPanel.Dock="Top" Margin="8,0,10,10" Click="OnPaletteOpen"
                        Cursor="Hand" Focusable="False" ToolTip="Найти, где что сделать (Ctrl+K)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Box" Height="38" CornerRadius="10" BorderThickness="1.5" Padding="16,0"
                                    BorderBrush="{DynamicResource Border}" Background="{DynamicResource Surface}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Muted}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid x:Name="SearchContent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="14"
                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                        <TextBlock x:Name="SearchLabel" Grid.Column="1" Text="Что сделать?" Foreground="{DynamicResource Muted}"
                                   Margin="9,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Border x:Name="SearchChip" Grid.Column="2" CornerRadius="5" BorderThickness="1.5"
                                BorderBrush="{DynamicResource Border}" Padding="5,1" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl+K" FontSize="10.5" Foreground="{DynamicResource Faint}" />
                        </Border>
                    </Grid>
                </Button>

                <!--
                    Полоса прокручивается: разделов девять, и на невысоком
                    окне последний иначе уезжает за нижний край — а уехавшего
                    пункта не существует, его не найти.
                -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <!--
                        Две группы (владелец, 23.09). Пунктов одиннадцать,
                        и подряд они читались стеной. Каждый день открывают
                        первые четыре; остальное — инструменты разбора,
                        к которым идут, когда что-то не так. «Ещё» отдельно:
                        это настройки программы, а не часть работы с сетью.
                    -->
                    <StackPanel x:Name="Rail">
                        <RadioButton x:Name="RailStatus" Style="{StaticResource RailItem}" Content="Главная" Tag="status" local:MenuIcon.Glyph="&#xE80F;" IsChecked="True" Checked="OnSection" />
                        <RadioButton Style="{StaticResource RailItem}" Content="VPN" Tag="vpn" local:MenuIcon.Glyph="&#xE774;" Checked="OnSection" />
                        <RadioButton Style="{StaticResource RailItem}" Content="Десинк" Tag="desync" local:MenuIcon.Glyph="&#xE9E9;" Checked="OnSection" />
                        <RadioButton Style="{StaticResource RailItem}" Content="Маршруты" Tag="routes" local:MenuIcon.Glyph="&#xE816;" Checked="OnSection" />
                        <RadioButton Style="{StaticResource RailItem}" Content="TG Proxy" Tag="tgproxy" local:MenuIcon.Shape="{StaticResource TelegramPlane}" Checked="OnSection" />

                        <!-- Подпись группы, а не пункт: мельче и приглушённым (RailGroup). -->
                        <Border Style="{StaticResource RailGroupLine}" />
                        <TextBlock Style="{StaticResource RailGroup}" Text="Разбор" />
                        <RadioButton Style="{StaticResource RailItem}" Content="Проверка блокировок" Tag="check" local:MenuIcon.Glyph="&#xE721;" Checked="OnSection" />
                        <RadioButton Style="{StaticResource RailItem}" Content="Замер скорости" Tag="speed" local:MenuIcon.Glyph="&#xEC4A;" Checked="OnSection" />
                        <RadioButton Style="{StaticResource RailItem}" Content="DNS" Tag="dns" local:MenuIcon.Glyph="&#xE968;" Checked="OnSection" />
                        <RadioButton Style="{StaticResource RailItem}" Content="Файл hosts" Tag="hosts" local:MenuIcon.Glyph="&#xE8A5;" Checked="OnSection" />
                        <RadioButton Style="{StaticResource RailItem}" Content="Наблюдение" Tag="watch" local:MenuIcon.Glyph="&#xE9D2;" Checked="OnSection" />
                        <!-- «Журнал» — с 07.10 окном из «Диагностики» (LogWindow): место в меню отдано «TG Proxy». -->
                        <RadioButton Style="{StaticResource RailItem}" Content="Диагностика" Tag="doctor" local:MenuIcon.Glyph="&#xE9D9;" Checked="OnSection" />

                        <Border Style="{StaticResource RailGroupLine}" />
                        <TextBlock Style="{StaticResource RailGroup}" Text="Прочее" />
                        <RadioButton Style="{StaticResource RailItem}" Content="Оформление" Tag="look" local:MenuIcon.Glyph="&#xE790;" Checked="OnSection" />
                        <RadioButton x:Name="RailMore" Style="{StaticResource RailItem}" Content="Ещё" Tag="more" local:MenuIcon.Glyph="&#xE713;" Checked="OnSection" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" x:Name="SectionArea">
            <ContentControl x:Name="Section">
                <views:StatusView />
            </ContentControl>

            <!--
                «Маршруты» — своим местом: уход их прячет, а не отцепляет
                (21.10, OnSection). Отцепленные при возврате раскладывали сотню
                карточек заново — у владельца сторож писал 1,0–1,6 с.
            -->
            <ContentControl x:Name="RoutesHost" Visibility="Collapsed" />

            <!--
                Всплывающие карточки — стопкой внизу справа, чтобы две разом
                не легли одна на другую.
            -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24">

            <!--
                После обновления (владелец, 03.10): звезда на GitHub и канал.
                Один раз на каждую новую версию и всем — с 08.11 (до того
                только скрывшим карточку на «Главной»; UpdateGreeting). Сама не уходит —
                закрывается кнопкой: кнопки в ней и есть смысл.
            -->
            <Border x:Name="GreetingToast" Visibility="Collapsed" MaxWidth="500" Margin="0,0,0,12"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Warn}" BorderThickness="1.5"
                    CornerRadius="14" Padding="18,15">
                <StackPanel>
                    <!--
                        «Закрыть» — крестиком в углу (05.10): с кнопкой «Поддержать»
                        четыре кнопки в ряд в карточку не влезали.
                    -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE735;" FontSize="16"
                                   Foreground="{DynamicResource Warn}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" x:Name="GreetingTitle" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Style="{StaticResource IconGhost}" Content="&#xE711;" Margin="10,-4,-6,0"
                                Padding="6,4" MinWidth="0" VerticalAlignment="Top" Click="OnGreetingClose"
                                ToolTip="Закрыть" />
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Если программа помогает — поставьте звезду на GitHub и подпишитесь на канал. Поддержать можно и донатом." />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Style="{StaticResource Ghost}" Padding="14,7" Margin="0,0,8,0" Click="OnGreetingTelegram"
                                ToolTip="Новости в телеграм-канале">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource LineShape}" Data="{StaticResource TelegramPlane}" />
                                <TextBlock Text="Канал" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Ghost}" Padding="14,7" Margin="0,0,8,0" Click="OnGreetingDonate"
                                ToolTip="Донат через Tribute в Telegram">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource LineGlyph}" Text="&#xEB51;" Margin="0,0,8,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Поддержать" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Primary}" Padding="16,8" Click="OnGreetingStar"
                                ToolTip="Страница NetZapret на GitHub — звезда справа вверху">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE734;" Margin="0,0,8,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Звезда на GitHub" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--
                Предложение перезапустить движки. Внизу справа и само уходит:
                почти всё, что меняется в окне, применяется перезапуском,
                и говорить об этом строкой в глубине раздела значит не сказать
                вовсе. Но и держать перед глазами нельзя — правок за один
                заход бывает десяток.
            -->
            <Border x:Name="Toast" Visibility="Collapsed" MaxWidth="460"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                    CornerRadius="14" Padding="18,15">
                <StackPanel>
                    <TextBlock x:Name="ToastTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ToastBody" Style="{StaticResource Caption}"
                               Margin="0,6,0,0" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button x:Name="ToastLater" Style="{StaticResource Ghost}" Content="Позже"
                                Padding="16,7" Margin="0,0,8,0" Click="OnToastLater" />
                        <Button x:Name="ToastAct" Style="{StaticResource Primary}"
                                Content="Перезапустить" Padding="18,8" Click="OnToastRestart" />
                    </StackPanel>
                </StackPanel>
            </Border>

            </StackPanel>
        </Grid>

        <!--
            Палитра «Что нужно сделать?» (11.11). Слоем во всё окно, а не Popup:
            так её масштабирует «Размер» из «Оформления» вместе с окном, а щелчок
            мимо карточки ловит сам слой и закрывает её. Карточка встаёт строкой
            ввода ровно на строку поиска в меню (OnPaletteOpen) — поиск словно
            раскрывается вниз, как у стенда разработчика.
        -->
        <Grid x:Name="PaletteLayer" Grid.ColumnSpan="2" Visibility="Collapsed" Background="Transparent"
              MouseLeftButtonDown="OnPaletteBackdrop">
            <Grid x:Name="PaletteBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="560">
                <!--
                    Тень — отдельным пустым слоем: DropShadowEffect на карточке
                    с текстом снял бы с текста ClearType (как у Card, 27.10).
                -->
                <Border CornerRadius="12" Background="{DynamicResource Surface}" Margin="2">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.45" Color="Black" />
                    </Border.Effect>
                </Border>

                <!--
                    Непрозрачная подложка: у тем со стеклом Surface полупрозрачна,
                    и сквозь список читались меню и раздел под ним (снимок 11.11).
                -->
                <Border CornerRadius="12" Background="{DynamicResource Backdrop}" />

                <Border CornerRadius="12" BorderThickness="1.5" BorderBrush="{DynamicResource Border}"
                        Background="{DynamicResource Surface}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="35" Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="14"
                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                            <TextBox x:Name="PaletteInput" Grid.Column="1" Margin="7,0,6,0" VerticalAlignment="Center"
                                     Style="{StaticResource PaletteField}" local:Hint.Text="Что нужно сделать?"
                                     TextChanged="OnPaletteText" PreviewKeyDown="OnPaletteKey" />
                            <Border Grid.Column="2" CornerRadius="5" BorderThickness="1.5" BorderBrush="{DynamicResource Border}"
                                    Padding="5,1" VerticalAlignment="Center">
                                <TextBlock Text="Esc" FontSize="10.5" Foreground="{DynamicResource Faint}" />
                            </Border>
                        </Grid>

                        <Rectangle DockPanel.Dock="Top" Height="1" Fill="{DynamicResource Border}" />

                        <TextBlock x:Name="PaletteEmpty" DockPanel.Dock="Top" Style="{StaticResource Caption}" FontSize="13"
                                   Margin="18,14,18,16" TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="Ничего не нашлось. Попробуйте другими словами — или впишите сайт, например youtube.com." />

                        <ListBox x:Name="PaletteList" Background="Transparent" BorderThickness="0" Padding="0,6"
                                 MaxHeight="440" Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonUp="OnPaletteClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <EventSetter Event="MouseEnter" Handler="OnPaletteHover" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Row" Margin="6,1" Padding="10,8" CornerRadius="8" Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Raised}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="18" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}" FontSize="15"
                                                       TextAlignment="Center" Foreground="{DynamicResource Muted}" />
                                            <Path Data="{Binding Shape}" Width="14" Height="14" Stretch="Uniform"
                                                  Fill="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Where}" Style="{StaticResource Caption}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

