<UserControl x:Class="NetZapret.Gui.Views.SpeedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Chrome}">

    <!--
        Замер скорости — владелец 30.09: «давай попробуем сделать замер
        скорости прям в программе», «как спидтест», «на отдельной вкладке».
        От Speedtest — вид: крупные цифры скачивания и отдачи, задержка,
        дуга со стрелкой, одна кнопка.

        Своё здесь — выбор пути. Speedtest мерит то, как идёт его собственный
        трафик; нам нужно сравнить туннель с прямой сетью, и замер идёт либо
        через вход проверки движка, либо мимо всякого прокси.
    -->
    <ScrollViewer Style="{StaticResource PageScroll}" Padding="32,28,32,28">
        <StackPanel>
            <TextBlock Text="Замер скорости" Style="{StaticResource Title}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Задержка, скачивание и отдача — через туннель или напрямую. Меряется несколькими соединениями к серверу Cloudflare, около двадцати секунд." />

            <!--
                Карточка замера не шире 600: на широком окне цифры и дуга
                разъехались бы по углам. Остаток ширины остаётся справа пустым.
            -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="440" MaxWidth="600" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,20,20,20" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE896;" FontSize="12"
                                               Foreground="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="СКАЧИВАНИЕ" Style="{StaticResource GroupHead}" />
                                </StackPanel>
                                <TextBlock x:Name="DownText" Text="—" FontSize="40" FontWeight="Light"
                                           FontFamily="{DynamicResource DisplayFont}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                <TextBlock Text="Мбит/с" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE898;" FontSize="12"
                                               Foreground="{DynamicResource Warn}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="ОТДАЧА" Style="{StaticResource GroupHead}" />
                                </StackPanel>
                                <TextBlock x:Name="UpText" Text="—" FontSize="40" FontWeight="Light"
                                           FontFamily="{DynamicResource DisplayFont}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                <TextBlock Text="Мбит/с" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="ЗАДЕРЖКА" Style="{StaticResource GroupHead}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="PingText" Text="—" FontSize="40" FontWeight="Light"
                                           FontFamily="{DynamicResource DisplayFont}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                <TextBlock x:Name="JitterText" Text="мс" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!--
                            Дуга со стрелкой. Рисуется кодом (DrawDial): отметки
                            стоят по неравномерной шкале SpeedGauge, и держать
                            их координаты в разметке значило бы считать их руками.
                        -->
                        <Grid Width="320" Height="246" Margin="0,18,0,0">
                            <Canvas x:Name="Dial" Width="320" Height="246" />

                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2">
                                <TextBlock x:Name="NowText" FontSize="26" FontWeight="SemiBold"
                                           FontFamily="{DynamicResource DisplayFont}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="PhaseText" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Button x:Name="Go" Style="{StaticResource Primary}" Content="Начать" Click="OnGo"
                                HorizontalAlignment="Center" MinWidth="170" Margin="0,14,0,0" />

                        <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="0,12,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="ЧТО МЕРИТЬ" Style="{StaticResource GroupHead}" Margin="4,0,0,7" />

                    <!-- Путь. Выбранный обведён, как всякая строка выбора. -->
                    <Button x:Name="ViaTunnel" Style="{StaticResource Choice}" Click="OnTunnel">
                        <StackPanel>
                            <TextBlock Text="Через туннель" FontWeight="SemiBold" />
                            <TextBlock x:Name="TunnelLine" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="Direct" Style="{StaticResource Choice}" Click="OnDirect">
                        <StackPanel>
                            <TextBlock Text="Напрямую" FontWeight="SemiBold" />
                            <TextBlock x:Name="DirectLine" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="ПОСЛЕДНИЕ ЗАМЕРЫ" Style="{StaticResource GroupHead}" Margin="4,14,0,7" />

                    <Border Style="{StaticResource SettingsGroup}">
                        <StackPanel>
                            <StackPanel Margin="16,12">
                                <TextBlock Text="Через туннель" />
                                <TextBlock x:Name="TunnelResult" Style="{StaticResource Caption}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Style="{StaticResource RowLine}" />

                            <StackPanel Margin="16,12">
                                <TextBlock Text="Напрямую" />
                                <TextBlock x:Name="DirectResult" Style="{StaticResource Caption}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
