<UserControl x:Class="NetZapret.Gui.Views.DesyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Backdrop}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,28">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="980" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="Десинк" Style="{StaticResource Title}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Пресет решает, какой приём применяется к какому сервису. Трафик при этом никуда не уходит: пакеты правятся на лету, и сайт открывается напрямую." />

                <!--
                    Движка нет — и это первое, что надо сказать. Пресет
                    выбирается, сохраняется и не действует ничем: winws2
                    просто некому запустить.
                -->
                <Border x:Name="MissingCard" Style="{StaticResource Card}" Margin="0,20,0,0"
                        BorderBrush="{StaticResource Danger}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="MissingTitle" FontWeight="SemiBold" Foreground="{StaticResource Danger}" />
                        <TextBlock x:Name="MissingBody" Style="{StaticResource Caption}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Сейчас выбран" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="ChosenName" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ChosenDetail" Style="{StaticResource Caption}"
                                       Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="1" x:Name="OffButton" Style="{StaticResource Ghost}"
                                Content="Не запускать десинк" Click="OnOff" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="4,16,0,0" TextWrapping="Wrap" />

                <ItemsControl x:Name="Presets" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Choice}" BorderBrush="{Binding Edge}"
                                    Tag="{Binding Name}" Click="OnChoose">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                       TextTrimming="CharacterEllipsis" />

                                            <Border Background="{StaticResource Raised}" CornerRadius="5"
                                                    Padding="7,2" Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding VersionShown}">
                                                <TextBlock Text="{Binding Version}" Style="{StaticResource Mono}"
                                                           Foreground="{StaticResource Muted}" FontSize="11" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                   Margin="0,5,0,0" TextWrapping="Wrap" />

                                        <TextBlock Text="{Binding Fake}" Style="{StaticResource Caption}"
                                                   Foreground="{StaticResource Warn}"
                                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding FakeShown}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="выбран" Style="{StaticResource Mono}"
                                               Foreground="{StaticResource Accent}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding MarkShown}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource Caption}" Margin="4,10,0,0" TextWrapping="Wrap"
                           Text="Пресеты лежат в папке presets рядом с программой и едут в архиве вместе с ней. Свой можно положить туда же — он появится в списке при следующем заходе." />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
