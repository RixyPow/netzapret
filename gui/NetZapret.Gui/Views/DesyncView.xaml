<UserControl x:Class="NetZapret.Gui.Views.DesyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="clr-namespace:NetZapret.Gui"
             Background="{DynamicResource Chrome}"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" DragLeave="OnDragLeave">

    <!--
        Вид — по макету владельца (03.10): выбранный пресет крупной карточкой,
        game filter и перехват плитками в «Параметрах работы», каталог одной
        строкой, у каждого пресета своя кнопка «Применить» и меню «…».

        Строка пресета одна на оба списка. Списка два — наши и чужие, —
        а вид у строки один, и держать две копии разметки значило бы чинить
        каждую правку дважды.
    -->
    <UserControl.Resources>
        <DataTemplate x:Key="PresetItem">
            <Border Style="{StaticResource Card}" BorderBrush="{Binding Edge}"
                    Margin="0,0,0,10" Padding="20,12,12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                   Margin="0,4,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="{Binding Fake}" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource Warn}"
                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding FakeShown}" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="{DynamicResource Raised}" CornerRadius="7"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            Padding="9,3" Margin="0,0,16,0" VerticalAlignment="Center"
                            ToolTip="Версия Zapret GUI, для которой собран пресет"
                            Visibility="{Binding VersionShown}">
                        <TextBlock Text="{Binding Version}" Style="{StaticResource Mono}"
                                   Foreground="{DynamicResource Muted}" FontSize="11.5" />
                    </Border>

                    <!--
                        Выбор — кнопкой, а не нажатием на всю строку (макет
                        03.10): в строке есть и меню «…», и промахнуться мимо
                        него в выбор пресета значило бы сменить обход случайно.
                    -->
                    <Button Grid.Column="2" Style="{StaticResource Primary}" Content="Применить"
                            Padding="18,9" MinWidth="122" VerticalAlignment="Center"
                            Tag="{Binding Name}" Click="OnChoose"
                            Visibility="{Binding ApplyShown}" />

                    <Border Grid.Column="2" MinWidth="122" CornerRadius="10" Padding="18,8"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                            VerticalAlignment="Center" Visibility="{Binding MarkShown}">
                        <TextBlock Text="Выбран" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Accent}" />
                    </Border>

                    <Button Grid.Column="3" Style="{StaticResource IconGhost}" Content="&#xE712;"
                            Margin="8,0,0,0" VerticalAlignment="Center"
                            ToolTip="Ещё: открыть в редакторе, показать файл"
                            Tag="{Binding File}" Click="OnRowMore" />
                </Grid>
            </Border>
        </DataTemplate>

        <!--
            Строка каталога. Не кнопка: рецепт отсюда не выбирается.
            Выбор идёт по одному имени, в окне «Рецепт» на вкладке
            маршрутов, — а здесь читают, что вообще бывает и что из этого
            доступно с нынешним пресетом.
        -->
        <DataTemplate x:Key="RecipeItem">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10"
                    BorderBrush="{Binding Edge}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding What}" Style="{StaticResource Caption}"
                                       Margin="0,5,0,0" TextWrapping="Wrap" />

                            <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}"
                                       Margin="0,5,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding NoteShown}" />

                            <!--
                                Причина недоступности — цветом опасности
                                и рядом с рецептом, а не общей строкой
                                внизу: недоступных бывает несколько,
                                и у каждого причина своя.
                            -->
                            <TextBlock Text="{Binding Complaint}" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource Warn}"
                                       Margin="0,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding ComplaintShown}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Style="{StaticResource Ghost}" Content="Подключить модуль"
                                    Tag="{Binding Id}" Click="OnConnectModule"
                                    Visibility="{Binding FixShown}" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource Raised}" CornerRadius="6"
                            Padding="10,7" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Mono}"
                                   Foreground="{DynamicResource Muted}" FontSize="11"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Плитка в «Параметрах работы»: та же рамка, что у строки выбора, без нажатия. -->
        <Style x:Key="ParamTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,13" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer Style="{StaticResource PageScroll}" Padding="32,28,32,28">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="470" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Десинк" Style="{StaticResource Title}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Пресет решает, какой приём применяется к какому сервису. Трафик при этом никуда не уходит: пакеты правятся на лету, и сайт открывается напрямую." />
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource Ghost}" Click="OnOpenFolder"
                            VerticalAlignment="Center" ToolTip="Папка presets рядом с программой">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE838;" Margin="0,0,9,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Открыть папку" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!--
                    Движка нет — и это первое, что надо сказать. Пресет
                    выбирается, сохраняется и не действует ничем: winws2
                    просто некому запустить.
                -->
                <Border x:Name="MissingCard" Style="{StaticResource Card}" Margin="0,20,0,0"
                        BorderBrush="{DynamicResource Danger}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="MissingTitle" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" />
                        <TextBlock x:Name="MissingBody" Style="{StaticResource Caption}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--
                    Выбранный пресет. Кнопки «Не запускать десинк» нет
                    (владелец, 03.10): десинк выключается выключателем
                    на «Главной», и второй путь к тому же стоял на самом
                    видном месте вкладки.
                -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--
                            Картинка темы, если она есть (та же, что колонкой
                            на «Главной»), иначе — значок десинка: у встроенных
                            тем картинки нет, и SideArt там прозрачен.
                        -->
                        <Border Grid.Column="0" Width="92" Height="92" CornerRadius="14"
                                Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" Margin="0,0,20,0" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE9E9;" FontSize="34"
                                           Foreground="{DynamicResource Accent}" />
                                <Border CornerRadius="13" Background="{DynamicResource SideArt}" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Текущий пресет" Style="{StaticResource Caption}" />

                            <WrapPanel Margin="0,4,0,0">
                                <TextBlock x:Name="ChosenName" FontSize="22" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Margin="0,0,12,0" />

                                <!-- Пресет по умолчанию (AppSettings.DefaultPresetName) — им и советуем. -->
                                <Grid x:Name="Recommended" VerticalAlignment="Center" Visibility="Collapsed"
                                      ToolTip="Пресет по умолчанию: с ним NetZapret проверяется в первую очередь">
                                    <Border CornerRadius="7" Background="{DynamicResource Accent}" Opacity="0.16" />
                                    <Border CornerRadius="7" BorderBrush="{DynamicResource Accent}"
                                            BorderThickness="1" Opacity="0.45" />
                                    <TextBlock Text="Рекомендуется" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Accent}" Margin="10,3" />
                                </Grid>
                            </WrapPanel>

                            <TextBlock x:Name="ChosenDetail" Style="{StaticResource Caption}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="2" x:Name="EditButton" Style="{StaticResource Primary}"
                                Padding="20,11" VerticalAlignment="Center" Click="OnOpenPreset">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE70F;" Margin="0,0,9,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Открыть в редакторе" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="4,12,0,0" TextWrapping="Wrap" />

                <!--
                    Параметры поверх пресета — две плитки рядом, на узком
                    окне друг под другом (OnParamsSize): рядом в 580 точек
                    подписи ломались в столбик по слову.
                -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,14,16,16">
                    <StackPanel>
                        <TextBlock Text="Параметры работы" FontWeight="SemiBold" FontSize="15" Margin="2,0,0,12" />

                        <Grid x:Name="ParamsGrid" SizeChanged="OnParamsSize">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--
                                Game filter (владелец, 25.09: «делай тумблер на вкладке
                                десинк»). Поверх любого пресета, выключен по умолчанию:
                                экспериментальный, помогает ли играм — не проверено.
                            -->
                            <Button x:Name="GameFilterTile" Grid.Column="0" Style="{StaticResource Choice}"
                                    Margin="0" Click="OnGameFilter">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource IconTile}" Margin="0,0,14,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE7FC;"
                                                   Foreground="{DynamicResource Accent}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Game filter" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                            Content="Как у Flowseal: к любому пресету дописываются две секции для игр — порты 1024–65535, адреса облаков и хостингов из ipset-all. Трогаются только первые четыре пакета соединения: подделки сбивают фильтр провайдера, дальше игра идёт нетронутой.&#x0a;&#x0a;Может и помешать играм, которые работали: проверяйте игру на клиенте, открытом после перезапуска движков.&#x0a;&#x0a;Секции стоят последними и берут только то, что не взяли секции пресета, щит «напрямую» и свои рецепты. Выключенный не меняет в запуске движка ничего. Действует со следующего запуска движков." />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Text="Экспериментальный: может помочь играм, которые не подключаются или тормозят." />
                                    </StackPanel>

                                    <ToggleButton Grid.Column="2" x:Name="GameFilterSwitch" Style="{StaticResource Switch}"
                                                  IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!--
                                Ширина перехвата (владелец 03.10, после замера: новое
                                соединение через winws2 стоит ему 28–38 мс процессора,
                                и пачка новых стопорит соседние — игры в том числе).
                                Список, а не выключатель: уровней три, и видно, какой
                                стоит. Уровни — как режимы WinDivert у Zapret GUI.
                            -->
                            <Border x:Name="CaptureTile" Grid.Column="2" Style="{StaticResource ParamTile}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource IconTile}" Margin="0,0,14,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE945;"
                                                   Foreground="{DynamicResource Accent}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Перехват" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                            Content="Что десинк вообще видит. Всё, что под перехват попало, проходит через winws2 пакет за пакетом — даже если ни одна секция его не тронет, — и каждое новое соединение ему чего-то стоит. Что не попало, идёт обычным путём и не стоит ничего.&#x0a;&#x0a;ТОЛЬКО САЙТЫ — TCP 80 и 443 и QUIC (UDP 443). Игры и голос в других программах десинк не видит вовсе.&#x0a;&#x0a;КАК В ПРЕСЕТЕ — то, что задал его автор.&#x0a;&#x0a;ВСЁ — TCP и UDP на всех портах от 443: для подбора стратегии, когда «аккуратного» не хватает.&#x0a;&#x0a;На любом уровне звонки (STUN), обнаружение адреса Discord и WireGuard ловятся по содержимому. Game filter, если включён, расширяет перехват поверх уровня." />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Text="Уже — меньше нагрузки и задержек. Действует со следующего запуска движков." />
                                    </StackPanel>

                                    <ComboBox Grid.Column="2" x:Name="CaptureBox" Width="170"
                                              VerticalAlignment="Center"
                                              SelectionChanged="OnCapture">
                                        <ComboBoxItem Content="Только сайты" />
                                        <ComboBoxItem Content="Как в пресете" />
                                        <ComboBoxItem Content="Всё" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="CaptureHint" Style="{StaticResource Caption}"
                                   Margin="2,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--
                    Каталог стоит здесь, а не в конце вкладки, потому что
                    отвечает на вопрос о выбранном пресете: что он умеет.
                    Уехав под списки пресетов, он читался бы как перечень
                    сам по себе, ни к чему не относящийся.

                    Свёрнут по умолчанию, и это решение владельца от 20.09.
                    Рецептов одиннадцать, каждый с объяснением и набором
                    шагов; развёрнутый каталог отодвигает списки пресетов
                    за нижний край, а читают его редко — когда впервые
                    разбираются, чем вообще чинят имена.
                -->
                <Button Style="{StaticResource Choice}" Margin="0,12,0,0" Padding="16,14" Click="OnCatalogToggle">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource IconTile}" Margin="0,0,14,0"
                                VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE81E;"
                                       Foreground="{DynamicResource Accent}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="Каталог рецептов" FontWeight="SemiBold" />

                            <!--
                                Счёт годных виден и в свёрнутом виде: иначе
                                сворачивание прятало бы ровно тот ответ,
                                ради которого сюда заходят второй раз, —
                                сколько из каталога потянет этот пресет.
                            -->
                            <TextBlock x:Name="CatalogNote" Style="{StaticResource Caption}"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <!--
                            Та же фигура, что у папок в маршрутах и хостах:
                            один жест «свернуть/развернуть» — один рисунок
                            на весь экран. Справа, как в макете: слева плитка.
                        -->
                        <Path x:Name="CatalogChevron" Grid.Column="2"
                              Style="{StaticResource Chevron}" Margin="0,0,8,0" />
                    </Grid>
                </Button>

                <ItemsControl x:Name="Catalog" ItemTemplate="{StaticResource RecipeItem}"
                              Visibility="Collapsed" Margin="0,10,0,0" />

                <!--
                    Наши и чужие врозь. Universal ведём мы: они собраны
                    по нашим замерам и правятся вместе с программой. Всё
                    остальное досталось от Zapret и живёт своей жизнью —
                    смешивать их в одном списке значит отвечать за то,
                    чего мы не писали.

                    Поиск — рядом с заголовком наших и ищет в обоих списках:
                    пресетов семнадцать, и нужный среди них ищут по имени.
                -->
                <Grid Margin="0,24,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,0,16,0">
                        <TextBlock x:Name="OwnHeader" Text="Пресеты NetZapret" FontWeight="SemiBold" FontSize="18" />
                        <TextBlock x:Name="OwnNote" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Text="Ведём мы: собраны по замерам и правятся вместе с программой. Новые — сверху." />
                    </StackPanel>

                    <!--
                        Значок поверх поля, а не в шаблоне: шаблон общий.
                        Отступ поля слева 16 — WPF отдаёт его и рамке,
                        и прокрутке внутри (см. шаблон TextBox), так что
                        текст и подсказка встают с ~35, за значком.
                    -->
                    <Grid Grid.Column="1" Width="320" VerticalAlignment="Center">
                        <TextBox x:Name="Search" Padding="16,4,11,4" TextChanged="OnSearch"
                                 gui:Hint.Text="Поиск пресета…" />
                        <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE721;" FontSize="13"
                                   HorizontalAlignment="Left" Margin="13,0,0,0" IsHitTestVisible="False" />
                    </Grid>
                </Grid>

                <ItemsControl x:Name="Own" ItemTemplate="{StaticResource PresetItem}" />

                <TextBlock x:Name="OthersHeader" Text="Пресеты сообщества"
                           FontWeight="SemiBold" FontSize="18" Margin="4,20,0,4" />
                <TextBlock x:Name="OthersNote" Style="{StaticResource Caption}" Margin="4,0,0,10"
                           TextWrapping="Wrap"
                           Text="Достались от Zapret или положены вами. Работают, но за их состав мы не отвечаем." />

                <ItemsControl x:Name="Others" ItemTemplate="{StaticResource PresetItem}" />

                <TextBlock x:Name="NothingFound" Style="{StaticResource Caption}" Margin="4,4,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed" />

                <TextBlock Style="{StaticResource Caption}" Margin="4,14,0,0" TextWrapping="Wrap"
                           Text="Пресеты лежат в папке presets рядом с программой и едут в архиве вместе с ней. Свой можно перетащить прямо сюда — файл скопируется в папку и появится в списке." />

            </StackPanel>
        </Grid>
        </ScrollViewer>

        <!--
            Подсказка поверх раздела, пока над ним держат файл. Полупрозрачная
            заливка, а не подмена содержимого: видно, куда именно роняешь.

            Цвет берётся из темы, а прозрачность задаётся отдельно. Здесь
            стоял единственный на всю программу зашитый цвет — тёмная подложка
            числом, — и в светлой теме он был бы чёрной заплатой посреди белого.
        -->
        <Border x:Name="DropHint" Visibility="Collapsed" Opacity="0.94"
                Background="{DynamicResource Backdrop}" BorderBrush="{DynamicResource Accent}"
                BorderThickness="2" CornerRadius="14" Margin="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Отпустите — скопирую в папку пресетов"
                           FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" HorizontalAlignment="Center"
                           Text="Берутся только файлы .txt формата Zapret 2 GUI." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
