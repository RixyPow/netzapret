<Window x:Class="NetZapret.Gui.Views.RouteListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="clr-namespace:NetZapret.Gui"
        Title="Добавить списком" Width="640" Height="680" MinWidth="460" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Backdrop}">

    <!--
        Вставка списка в «Маршруты» (идея №14, владелец 19.10: «делай»).
        Один путь на всю вставку; размер меняется — список бывает в сотню строк.
        Разбор и решения — в RouteListInput, здесь только показ.
    -->
    <Window.Resources>
        <!-- Тот же сегмент, что у отбора в «Маршрутах» (RoutesView, RouteFilter). -->
        <Style x:Key="PathSegment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shape" Background="Transparent" CornerRadius="8" Padding="14,0" MinHeight="30">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Raised}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource AccentFill}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid LayoutTransform="{DynamicResource UiScaleTransform}" Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource Title}" FontSize="20" Text="Добавить списком" />

        <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Margin="0,8,0,12" TextWrapping="Wrap"
                   Text="Сайты или адреса — по строке, через запятую или пробел; ссылки тоже годятся. Имя означает зону: example.com покрывает и поддомены. Путь — один на весь список, поправить отдельный сайт можно потом в его строке." />

        <TextBox Grid.Row="2" x:Name="ListBox" AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" TextChanged="OnChanged"
                 gui:Hint.Text="7tv.app&#x0a;7tv.io&#x0a;203.0.113.0/24" />

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="Сводить к сайту" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="cdn.example.com станет example.com: длинные имена сетей доставки меняются, и правило на точное имя завтра не совпадёт ни с чем." />
            </StackPanel>

            <ToggleButton Grid.Column="1" x:Name="ToSite" Style="{StaticResource Switch}" IsChecked="True"
                          VerticalAlignment="Center" Click="OnChanged" />
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0">
            <TextBlock Text="Путь" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />

            <Border CornerRadius="11" Padding="3" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="PathDirect" Style="{StaticResource PathSegment}" GroupName="ListPath" Content="Напрямую" IsChecked="True" Checked="OnChanged" />
                    <RadioButton x:Name="PathDesync" Style="{StaticResource PathSegment}" GroupName="ListPath" Content="Десинк" Checked="OnChanged" />
                    <RadioButton x:Name="PathVpn" Style="{StaticResource PathSegment}" GroupName="ListPath" Content="Через VPN" Checked="OnChanged" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,14,0,0">
            <TextBlock Text="Папка" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="FolderBox" TextChanged="OnChanged" gui:Hint.Text="необязательно — например, Twitch" />
        </StackPanel>

        <TextBlock Grid.Row="6" x:Name="Summary" Style="{StaticResource Caption}" Margin="0,14,0,0" TextWrapping="Wrap" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource Ghost}" Content="Отмена" IsCancel="True" Margin="0,0,8,0" Click="OnCancel" />
            <Button x:Name="Confirm" Style="{StaticResource Primary}" Content="Добавить" Click="OnAdd" />
        </StackPanel>
    </Grid>
</Window>
