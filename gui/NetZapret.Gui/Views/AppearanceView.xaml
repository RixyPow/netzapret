<UserControl x:Class="NetZapret.Gui.Views.AppearanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Chrome}">

    <!--
        Оформление — своим разделом (владелец, 24.09: «давай вынесем
        оформление в отдельную вкладку»). Прежде лежало первой карточкой
        в «Ещё» и занимало там больше места, чем всё остальное вместе:
        темы, фон, шрифт, размер, меню трея.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,28">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="470" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="Оформление" Style="{StaticResource Title}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Тема, фон, шрифт, размер и меню в трее. Применяется сразу; настройки фона, шрифта и меню общие для всех тем." />

                <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="4,16,0,0" TextWrapping="Wrap" />


                <!--
                    Выбор темы плитками, как в Telegram (владелец, 23.09).
                    Плитка нарисована цветами самой темы; тема, не прошедшая
                    проверку контраста, видна приглушённой, а причина — в
                    подсказке и под плитками.
                -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Тема" FontWeight="SemiBold" />
                                <TextBlock x:Name="ThemeHint" Style="{StaticResource Caption}"
                                           Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Column="1" Style="{StaticResource Ghost}" VerticalAlignment="Top"
                                    Content="Папка тем" Click="OnThemesFolder" />
                        </Grid>

                        <ItemsControl x:Name="ThemeList" Margin="0,16,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Id}" Click="OnTheme" Margin="0,0,14,6" Cursor="Hand"
                                            ToolTip="{Binding Tip}" Opacity="{Binding Fade}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Button.Template>

                                        <StackPanel Width="112">
                                            <Border Height="84" CornerRadius="12" BorderThickness="2"
                                                    Background="{Binding Backdrop}" BorderBrush="{Binding Edge}">
                                                <Grid>
                                                    <Rectangle RadiusX="10" RadiusY="10" Fill="{Binding Image}" />
                                                    <Rectangle RadiusX="10" RadiusY="10" Fill="{Binding Backdrop}"
                                                               Opacity="{Binding Dim}" />

                                                    <Border Background="{Binding Surface}" CornerRadius="5"
                                                            Width="52" Height="14" Margin="10,10,0,0"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                    <Border Background="{Binding Fill}" CornerRadius="5"
                                                            Width="44" Height="14" Margin="0,30,10,0"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top" />

                                                    <Grid Width="18" Height="18" Margin="0,0,0,9"
                                                          HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                        <Ellipse Stroke="{Binding Ring}" StrokeThickness="1.5" />
                                                        <Ellipse Width="10" Height="10" Fill="{Binding Dot}"
                                                                 Visibility="{Binding DotShown}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="{Binding Name}" Foreground="{Binding NameColor}"
                                                       HorizontalAlignment="Center" Margin="0,7,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--
                            Своя тема прямо в программе (владелец, 24.09).
                            «Изменить» у встроенной создаёт новую: встроенные
                            не перезаписываются, иначе обновление программы
                            молча вернуло бы свой файл.
                        -->
                        <WrapPanel Margin="0,4,0,4">
                            <Button Style="{StaticResource Primary}" Content="Создать тему" Click="OnCreateTheme" Margin="0,0,8,8" />
                            <Button x:Name="EditThemeButton" Style="{StaticResource Ghost}" Content="Изменить" Click="OnEditTheme" Margin="0,0,8,8" />
                            <Button Style="{StaticResource Ghost}" Content="Выгрузить в файл…" Click="OnExportTheme" Margin="0,0,8,8" />
                            <Button Style="{StaticResource Ghost}" Content="Загрузить из файла…" Click="OnImportTheme" Margin="0,0,8,8" />
                        </WrapPanel>

                        <!--
                            Настройки оформления (владелец, 23.09: «добавь
                            настройки оформления, по типу размытие вкл/выкл»).
                            Хранятся у человека, а не в теме; видны, когда
                            у выбранной темы есть картинка фона.
                        -->
                        <StackPanel x:Name="LookPanel" Margin="0,8,0,0">
                            <Button Style="{StaticResource Choice}" Tag="background" Click="OnLook" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Картинка фона" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Text="Выключенная — остаются цвета темы, фон сплошной." />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="BackgroundSwitch" Style="{StaticResource Switch}"
                                                  IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource Choice}" Tag="blur" Click="OnLook" Margin="0,0,0,7"
                                    x:Name="BlurRow">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Размытие под карточками и меню" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Text="Матовое стекло: под карточками фон размыт, между ними — чёткий. Плотность стекла подбирается так, чтобы текст на нём читался." />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="BlurSwitch" Style="{StaticResource Switch}"
                                                  IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <Border x:Name="DimRow" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1.5" CornerRadius="14" Padding="16,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Затемнение фона" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Text="Только темнее задуманного: затемнение и есть то, чем тема читается." />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="DimChoice" Width="190" VerticalAlignment="Center"
                                              SelectionChanged="OnDim">
                                        <ComboBoxItem Content="как задумал автор" />
                                        <ComboBoxItem Content="темнее" />
                                        <ComboBoxItem Content="намного темнее" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="LookNone" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="У этой темы нет картинки фона — размытию и затемнению нечего делать." />

                        <!--
                            Шрифт и размер — здесь же, в оформлении (владелец,
                            24.09). Шрифт один на всю программу; в списке каждый
                            написан собой — выбирают глазами, а не по имени.
                            Применяется сразу: образец — само окно.
                        -->
                        <Grid Margin="0,14,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Шрифт" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Text="Один на всю программу. Не моноширинный держит цифры в таблицах чуть менее ровно." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="UiFontChoice" VerticalAlignment="Center"
                                      SelectionChanged="OnFontChoice">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontFamily="{Binding Family}" FontSize="14" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Размер" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Text="Всё окно целиком, как масштаб в Telegram, — вместе со списками, подсказками и окнами." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="ScaleChoice" VerticalAlignment="Center"
                                      SelectionChanged="OnFontChoice" />
                        </Grid>

                        <!--
                            Меню трея (владелец, 24.09: «добавь в настройки
                            оформления ещё и вид трея»). Не внутри блока фона:
                            тот виден только у тем с картинкой, а меню есть всегда.
                            Меню читает настройки при каждом открытии — сохранить
                            и есть применить.
                        -->
                        <TextBlock Text="Меню в трее" FontWeight="SemiBold" Margin="0,18,0,8" />

                        <Button Style="{StaticResource Choice}" Click="OnTrayBlur" Margin="0,0,0,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Размытие под меню" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                               Text="Под меню — размытое то, что было на экране. Выключенное — меню прозрачно по плотности ниже, и сквозь него видно окна." />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" x:Name="TrayBlurSwitch" Style="{StaticResource Switch}"
                                              IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Плотность подложки" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Text="Сколько цвета темы лежит под текстом меню. Меньше — виднее фон, но текст на пёстром читается хуже." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="TrayDensityChoice" VerticalAlignment="Center"
                                      SelectionChanged="OnTrayDensity" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
