<UserControl x:Class="NetZapret.Gui.Views.AppearanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="clr-namespace:NetZapret.Gui"
             Background="{DynamicResource Chrome}">

    <!--
        Оформление — своим разделом (владелец, 24.09: «давай вынесем
        оформление в отдельную вкладку»). Прежде лежало первой карточкой
        в «Ещё» и занимало там больше места, чем всё остальное вместе:
        темы, фон, шрифт, размер, меню трея.
    -->
    <UserControl.Resources>
        <!-- Строка с выключателем внутри группы: нажимается вся, своей рамки нет — рамка у группы. -->
        <Style x:Key="PlainRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="4,22,0,10" />
        </Style>

        <Style x:Key="GroupLine" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Border}" />
            <Setter Property="Margin" Value="0,10,0,10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScroll}" Padding="32,28,32,28">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="470" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="Оформление" Style="{StaticResource Title}" />

                <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="4,16,0,0" TextWrapping="Wrap" />


                <!--
                    Выбор темы плитками, как в Telegram (владелец, 23.09).
                    Плитка нарисована цветами самой темы; тема, не прошедшая
                    проверку контраста, видна приглушённой, а причина — в
                    подсказке и под плитками.
                -->
                <gui:Card Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Тема" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Своя тема — папка в themes\ рядом с программой: цвета, шрифты и фон. Формат — в themes\README.md." />
                                </StackPanel>
                                <TextBlock x:Name="ThemeHint" Style="{StaticResource Caption}"
                                           Margin="0,5,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                            </StackPanel>

                        </Grid>

                        <!--
                            Сеткой во всю ширину карточки (08.11): переносом плитки вставали
                            по пять-шесть с пустой полосой справа — шестая не влезала на
                            несколько точек (снимок владельца). Колонок — шесть на обычном окне
                            владельца и девять на развёрнутом (OnThemeListSize, Tag списка);
                            рисунок — Viewbox'ом, плитка 107–114 при прежних 112.
                        -->
                        <ItemsControl x:Name="ThemeList" Margin="0,16,-12,0" Focusable="False" Tag="6"
                                      SizeChanged="OnThemeListSize">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Id}" Click="OnTheme" Margin="0,0,12,10" Cursor="Hand"
                                            ToolTip="{Binding Tip}" Opacity="{Binding Fade}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Button.Template>

                                        <StackPanel>
                                            <Viewbox Stretch="Uniform">
                                            <Grid Width="112" Height="84">
                                                <Border Margin="1" CornerRadius="11" Padding="1" Background="{Binding Backdrop}">
                                                    <Grid>
                                                        <Rectangle RadiusX="10" RadiusY="10" Fill="{Binding Image}" />
                                                        <Rectangle RadiusX="10" RadiusY="10" Fill="{Binding Backdrop}"
                                                                   Opacity="{Binding Dim}" />

                                                        <Border Background="{Binding Surface}" CornerRadius="5"
                                                                Width="52" Height="14" Margin="10,10,0,0"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                        <Border Background="{Binding Fill}" CornerRadius="5"
                                                                Width="44" Height="14" Margin="0,30,10,0"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top" />

                                                        <Grid Width="18" Height="18" Margin="0,0,0,9"
                                                              HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                            <Ellipse Stroke="{Binding Ring}" StrokeThickness="1.5" />
                                                            <Ellipse Width="10" Height="10" Fill="{Binding Dot}"
                                                                     Visibility="{Binding DotShown}" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>

                                                <!--
                                                    Рамка — поверх картинки, отдельным слоем (владелец 27.10:
                                                    «скругления тонкие… рваные»). Border рисует рамку под своим
                                                    содержимым, и картинка со скруглением 10 заходила на неё
                                                    изнутри: на углах линия выходила тоньше сторон и с рваным краем.
                                                    Подложка — на точку внутри рамки: иначе её сглаженный край
                                                    темнил бы снаружи сглаженный край рамки.
                                                -->
                                                <Border CornerRadius="12" BorderThickness="2" BorderBrush="{Binding Edge}" />
                                            </Grid>
                                            </Viewbox>

                                            <TextBlock Text="{Binding Name}" Foreground="{Binding NameColor}"
                                                       HorizontalAlignment="Center" Margin="0,7,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--
                            Своя тема прямо в программе (владелец, 24.09).
                            «Изменить» у встроенной создаёт новую: встроенные
                            не перезаписываются, иначе обновление программы
                            молча вернуло бы свой файл.
                        -->
                        <!--
                            08.11: в ряду — «Создать тему», «Изменить» и «⋯»; файлы, папка тем
                            и «Удалить» — в меню (OnThemeMore). Шесть кнопок в ряд на окне
                            владельца не влезали, и «Папка тем» уезжала второй строкой.
                        -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                            <Button Style="{StaticResource Primary}" Content="Создать тему" Click="OnCreateTheme" Margin="0,0,8,0" />
                            <Button x:Name="EditThemeButton" Style="{StaticResource Ghost}" Content="Изменить" Click="OnEditTheme" Margin="0,0,8,0" />
                            <Button Style="{StaticResource IconGhost}" Content="&#xE712;" Click="OnThemeMore"
                                    ToolTip="Загрузить, выгрузить, папка тем, удалить" />
                        </StackPanel>
                    </StackPanel>
                </gui:Card>

                <!--
                    Настройки фона — у человека, а не в теме; видны, когда у темы есть
                    картинка. С 08.11 — группами-карточками со строками через черту, как
                    «Обслуживание» в «Ещё»: без подписей строки-кнопки вперемешку с голыми
                    строками и заголовками читались слепленными (снимок владельца 08.11).
                -->
                <TextBlock Text="Фон" Style="{StaticResource GroupTitle}" />
                <gui:Card Style="{StaticResource Card}" Padding="20,12">
                    <StackPanel>
                        <StackPanel x:Name="LookPanel">
                            <Button Style="{StaticResource PlainRow}" Tag="background" Click="OnLook">
                                <Grid MinHeight="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Картинка фона" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ToggleButton Grid.Column="1" x:Name="BackgroundSwitch" Style="{StaticResource Switch}"
                                                  IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Border Style="{StaticResource GroupLine}" />
                            <Button Style="{StaticResource PlainRow}" x:Name="BlurRow" Tag="blur" Click="OnLook">
                                <Grid MinHeight="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Размытие под карточками и меню" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ToggleButton Grid.Column="1" x:Name="BlurSwitch" Style="{StaticResource Switch}"
                                                  IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Border Style="{StaticResource GroupLine}" />
                            <Grid MinHeight="36" x:Name="DimRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Затемнение фона" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="DimChoice" VerticalAlignment="Center"
                                          SelectionChanged="OnDim">
                                    <ComboBoxItem Content="как задумал автор" />
                                    <ComboBoxItem Content="темнее" />
                                    <ComboBoxItem Content="намного темнее" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                        <TextBlock x:Name="LookNone" Style="{StaticResource Caption}" Margin="0,8,0,8"
                                   TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="У этой темы нет картинки фона." />
                    </StackPanel>
                </gui:Card>
                <!--
                    Шрифт один на всю программу, размер — всё окно целиком. Ширина «Главной» —
                    у каждой темы своя (AppSettings.HomeWideThemes).
                -->
                <TextBlock Text="Окно" Style="{StaticResource GroupTitle}" />
                <gui:Card Style="{StaticResource Card}" Padding="20,12">
                    <StackPanel>
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Шрифт" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="UiFontChoice" VerticalAlignment="Center"
                                      SelectionChanged="OnFontChoice">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontFamily="{Binding Family}" FontSize="14" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Border Style="{StaticResource GroupLine}" />
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Размер" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="ScaleChoice" VerticalAlignment="Center"
                                      SelectionChanged="OnFontChoice" />
                        </Grid>
                        <Border Style="{StaticResource GroupLine}" />
                        <Button Style="{StaticResource PlainRow}" Click="OnAnimations">
                            <Grid MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Анимации" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AnimationsNote" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                               Visibility="Collapsed" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" x:Name="AnimationsSwitch" Style="{StaticResource Switch}"
                                              IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Border Style="{StaticResource GroupLine}" />
                        <Button Style="{StaticResource PlainRow}" Click="OnHomeWidth">
                            <Grid MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="«Главная» на всю ширину — для этой темы" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Выключено — картинка темы в карточке справа. У каждой темы выбор свой." />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" x:Name="HomeWidthSwitch" Style="{StaticResource Switch}"
                                              IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </gui:Card>
                <!--
                    Меню читает настройки при каждом открытии — сохранить и есть применить.
                -->
                <TextBlock Text="Меню в трее" Style="{StaticResource GroupTitle}" />
                <gui:Card Style="{StaticResource Card}" Padding="20,12">
                    <StackPanel>
                        <Button Style="{StaticResource PlainRow}" Click="OnTrayBlur">
                            <Grid MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Размытие под меню" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="1" x:Name="TrayBlurSwitch" Style="{StaticResource Switch}"
                                              IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Border Style="{StaticResource GroupLine}" />
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Плотность подложки" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="TrayDensityChoice" VerticalAlignment="Center"
                                      SelectionChanged="OnTrayDensity" />
                        </Grid>
                    </StackPanel>
                </gui:Card>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
