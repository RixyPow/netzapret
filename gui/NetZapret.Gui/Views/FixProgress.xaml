<UserControl x:Class="NetZapret.Gui.Views.FixProgress"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">

    <!--
        Ход и итог подбора маршрута — строками и плашкой, а не абзацем
        (владелец 27.10: «сделай визуализацию этому, а не чтобы там был
        какой-то сплошной текст»). Шаги появляются по мере проверки,
        рецепты — группой с отступом, итог — сверху. Один на «Сайт не
        открывается?» в «Ещё» и на «Автоподбор» в окне пути маршрута.
    -->
    <StackPanel>
        <Border x:Name="Plate" Visibility="Collapsed" Background="{DynamicResource Raised}"
                BorderThickness="1.5" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="PlateGlyph" FontFamily="{StaticResource IconFont}" FontSize="20"
                           VerticalAlignment="Center" Margin="0,0,12,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="PlateHead" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="PlateNote" Style="{StaticResource Caption}" Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="2" x:Name="PlateAction" Style="{StaticResource Ghost}"
                        Click="OnPlateAction" Margin="12,0,0,0"
                        VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>

        <StackPanel x:Name="NowLine" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="13"
                       Foreground="{DynamicResource Warn}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock x:Name="NowText" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </StackPanel>

        <ItemsControl x:Name="Steps">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="{Binding Indent}" MinHeight="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Glyph}" Foreground="{Binding Tone}" FontSize="13"
                                   FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="{Binding Weight}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="340"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Detail}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
