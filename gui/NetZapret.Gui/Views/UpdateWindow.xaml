<Window x:Class="NetZapret.Gui.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Доступно обновление"
        Width="1000" Height="680" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Backdrop}"
        ShowInTaskbar="False">
    <!--
        Владелец 06.10, по образцу окна обновления Zapret GUI: при найденной
        версии — окно с «Что нового» за все версии между установленной
        и новой, «Подробностями» и кнопками «Открыть в браузере», «Telegram»,
        «Пропустить версию», «Позже», «Обновить». Карточка на «Главной»
        остаётся — она для тех, кто окно закрыл.
    -->
    <Window.Resources>
        <!-- Вкладка — тот же переключатель, что отбор в «Маршрутах». -->
        <Style x:Key="UpdateTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shape" Background="Transparent" CornerRadius="8" Padding="14,0" MinHeight="30">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Raised}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource AccentFill}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid LayoutTransform="{DynamicResource UiScaleTransform}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,22,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource IconTile}" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE895;" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="Heading" Text="Доступно обновление" Style="{StaticResource Title}" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Плашка версии справа в шапке — по макету владельца 06.10; крупнее — его же просьба. -->
            <Border Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0" CornerRadius="16"
                    Padding="30,12,30,14" BorderThickness="2" MinWidth="190"
                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}">
                <StackPanel>
                    <TextBlock x:Name="BadgeVersion" HorizontalAlignment="Center" FontSize="30" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}" />
                    <TextBlock x:Name="BadgeDate" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                               FontSize="14" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="24,16,24,0" CornerRadius="11" Padding="3" HorizontalAlignment="Left"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="NotesTab" Style="{StaticResource UpdateTab}" GroupName="UpdateTab"
                             Content="Что нового" IsChecked="True" Click="OnTab" />
                <RadioButton x:Name="DetailsTab" Style="{StaticResource UpdateTab}" GroupName="UpdateTab"
                             Content="Подробности" Click="OnTab" Margin="3,0,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="24,12,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="262" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <ScrollViewer x:Name="NotesScroll" Style="{StaticResource PageScroll}" Padding="20,16,20,18">
                        <StackPanel x:Name="Notes" />
                    </ScrollViewer>

                    <ScrollViewer x:Name="DetailsScroll" Style="{StaticResource PageScroll}" Padding="20,16,20,18"
                                  Visibility="Collapsed">
                        <StackPanel x:Name="Details" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--
                Лента версий — по макету владельца 06.10: точки на линии, новая
                и установленная помечены. Щелчок ведёт чейнджлог к версии,
                листание чейнджлога подсвечивает ту, что сейчас на экране.
            -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="ВЕРСИИ" Style="{StaticResource GroupHead}" Margin="18,14,0,6" />

                    <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}" Padding="8,0,8,12">
                        <StackPanel x:Name="Timeline" UseLayoutRounding="True" SnapsToDevicePixels="True" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="24,14,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Ghost}" Click="OnBrowser" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="13" Text="&#xE774;" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Открыть в браузере" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Ghost}" Click="OnTelegram" Padding="12,8" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="13" Text="&#xE724;" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Telegram" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SkipButton" Style="{StaticResource Ghost}" Content="Пропустить версию" Click="OnSkip" Padding="14,8" Margin="0,0,8,0" />
                <Button x:Name="LaterButton" Style="{StaticResource Ghost}" Content="Позже" Click="OnLater" Padding="14,8" />
                <Button x:Name="InstallButton" Style="{StaticResource Primary}" Click="OnInstall"
                        Padding="18,9" Margin="8,0,0,0" IsDefault="True" ToolTipService.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="13" Text="&#xE896;" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="Обновить" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
