<UserControl x:Class="NetZapret.Gui.Views.DnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Chrome}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,28">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="470" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="DNS" Style="{StaticResource Title}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Через кого туннель узнаёт адреса имён. Настройки Windows мы не трогаем — этот выбор действует внутри sing-box." />
                    </StackPanel>

                </Grid>

                <!--
                    Обзор резолверов, 23.09, по снимку владельца. Отвечает на то,
                    чего не видно по задержке: кто на самом деле отвечает на UDP
                    и подменяет ли он ответы. Замер в тот же день: Google,
                    Cloudflare и OpenDNS по UDP отвечали из RIPN-NS5-RU-MSK
                    и подменяли четыре закрытых имени из пяти, по DoH и DoT — сами.
                -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Обзор резолверов" FontWeight="SemiBold" VerticalAlignment="Center" />

                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Задержка по DoH, DoT и обычному UDP — лучшая из трёх.&#x0a;&#x0a;«Кто отвечает» — адрес, с которого на самом деле ходит наружу тот, кто ответил на UDP, и его сеть. Если спрашивали 8.8.8.8, а ответил резолвер российской сети, запрос перехвачен по дороге.&#x0a;&#x0a;«Подмена» — сколько из пяти давно закрытых имён резолвер по UDP разрешил не туда: в заглушку, в пустоту или в один адрес на всех. Одно расхождение адресов подменой не считается — у сетей доставки узлов десятки.&#x0a;&#x0a;Мерится сеть провайдера: запросы идут через адаптер мимо нашего туннеля." />
                                </StackPanel>

                                <TextBlock x:Name="SurveyStatus" Style="{StaticResource Caption}" Margin="0,5,0,0"
                                           TextWrapping="Wrap"
                                           Text="Кто на самом деле отвечает на DNS и подменяет ли ответы." />
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="SurveyButton" Style="{StaticResource Primary}"
                                    Content="Проверить" Click="OnSurvey" VerticalAlignment="Center" />
                        </Grid>

                        <Grid x:Name="SurveyHead" Margin="0,14,0,6" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="ПРОВАЙДЕР" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="1" Text="DoH" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="2" Text="DoT" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="3" Text="UDP" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="4" Text="КТО ОТВЕЧАЕТ НА UDP" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="5" Text="ПОДМЕНА" Style="{StaticResource Caption}" />
                        </Grid>

                        <ItemsControl x:Name="Survey">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Doh}" Style="{StaticResource Mono}" Foreground="{Binding DohColor}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Dot}" Style="{StaticResource Mono}" Foreground="{Binding DotColor}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Udp}" Style="{StaticResource Mono}" Foreground="{Binding UdpColor}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Real}" Style="{StaticResource Mono}" Foreground="{Binding RealColor}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Real}" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="5" Text="{Binding Spoof}" Style="{StaticResource Mono}" Foreground="{Binding SpoofColor}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Апстрим туннеля" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" />

                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Речь только о резолвере, которого спрашивает sing-box. Настройки DNS самой Windows не трогаются ни здесь, ни где-либо ещё.&#x0a;&#x0a;ЧЕРЕЗ ТУННЕЛЬ — запрос уходит внутри зашифрованного потока к серверу подписки. Оператору он неотличим от прочего трафика, перекрыть его отдельно нельзя. Цена: пока туннель не поднялся, имена не разрешаются вовсе — включая те, что открывались одним десинком.&#x0a;&#x0a;НАПРЯМУЮ — запрос уходит к выбранному резолверу своим соединением, по DoH. Работает независимо от туннеля, но виден оператору как обращение к известному резолверу, и его можно перекрыть. В августе 2026 несколько российских операторов так и сделали." />
                                </StackPanel>

                                <TextBlock x:Name="ChosenName" FontSize="16" FontWeight="SemiBold"
                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!--
                                Список, а не выключатель. Кнопка подписывалась
                                действием — «Спрашивать напрямую», — и после
                                нажатия нужный вариант словно пропадал: владелец
                                21.09 так и сказал, «нажал, и она пропала».
                                У списка оба варианта на виду, и видно, какой
                                стоит сейчас.
                            -->
                            <ComboBox Grid.Column="1" x:Name="TunnelMode" Width="188"
                                      VerticalAlignment="Center"
                                      SelectionChanged="OnThroughTunnel">
                                <ComboBoxItem Content="спрашивать напрямую" />
                                <ComboBoxItem Content="спрашивать через туннель" />
                            </ComboBox>
                        </Grid>

                        <TextBlock x:Name="TunnelHint" Style="{StaticResource Caption}"
                                   Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--
                    Что стоит у самой Windows. Не для правки — мы её настройки
                    не трогаем, — а чтобы было видно, кому уходят запросы всего,
                    что мимо туннеля.
                -->
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Резолверы системы" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="SystemValue" Style="{StaticResource Mono}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,7,0,0" TextWrapping="Wrap"
                                   Text="Их выдаёт сеть или задаёт адаптер. Мы их только читаем: подмена системного DNS ломает то, что от него зависит, и переживает удаление программы." />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="4,16,0,0" TextWrapping="Wrap" />

                <ItemsControl x:Name="Resolvers" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Choice}" BorderBrush="{Binding Edge}"
                                    Tag="{Binding Address}" Click="OnChoose">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                               FontSize="14" VerticalAlignment="Center" MinWidth="112" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                        <TextBlock Text="{Binding Address}" Style="{StaticResource Mono}"
                                                   Foreground="{DynamicResource Muted}" />
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding Latency}"
                                               Style="{StaticResource Mono}"
                                               Foreground="{Binding Color}"
                                               TextAlignment="Right" MinWidth="96"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="3" Text="сейчас" Style="{StaticResource Mono}"
                                               Foreground="{DynamicResource Accent}"
                                               Margin="14,0,0,0" MinWidth="48"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding MarkShown}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource Caption}" Margin="4,10,0,0" TextWrapping="Wrap"
                           Text="Задержка — по DoH из обзора выше. Нажмите на строку, чтобы туннель спрашивал этого резолвера." />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
