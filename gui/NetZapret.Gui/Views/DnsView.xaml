<UserControl x:Class="NetZapret.Gui.Views.DnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Backdrop}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,28">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="470" MaxWidth="1240" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="DNS" Style="{StaticResource Title}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Через кого туннель узнаёт адреса имён. Настройки Windows мы не трогаем — этот выбор действует внутри sing-box." />
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="RunButton" Style="{StaticResource Primary}"
                            Content="Проверить" Click="OnRun" VerticalAlignment="Center" />
                </Grid>

                <!--
                    Замер при поднятом туннеле занижает доступность, и молчать
                    об этом нельзя: человек решит, что резолвер мёртв, и уйдёт
                    менять рабочий на нерабочий.
                -->
                <Border x:Name="TunnelCard" Style="{StaticResource Card}" Margin="0,20,0,0"
                        BorderBrush="{DynamicResource Warn}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Туннель поднят — замер занизит доступность"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Warn}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Мы сами закрываем DoH к системным резолверам, чтобы Windows вернулась на обычный UDP, и наш собственный запрос попадает под то же правило. Для чистой картины остановите движки в разделе «Состояние»." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Апстрим туннеля" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="ChosenName" FontSize="16" FontWeight="SemiBold"
                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="TunnelButton" Style="{StaticResource Ghost}"
                                    Click="OnThroughTunnel" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock x:Name="TunnelHint" Style="{StaticResource Caption}"
                                   Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--
                    Что стоит у самой Windows. Не для правки — мы её настройки
                    не трогаем, — а чтобы было видно, кому уходят запросы всего,
                    что мимо туннеля.
                -->
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Резолверы системы" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="SystemValue" Style="{StaticResource Mono}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,7,0,0" TextWrapping="Wrap"
                                   Text="Их выдаёт сеть или задаёт адаптер. Мы их только читаем: подмена системного DNS ломает то, что от него зависит, и переживает удаление программы." />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="4,16,0,0" TextWrapping="Wrap" />

                <ItemsControl x:Name="Resolvers" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Choice}" BorderBrush="{Binding Edge}"
                                    Tag="{Binding Address}" Click="OnChoose">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                               FontSize="14" VerticalAlignment="Center" MinWidth="112" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                        <TextBlock Text="{Binding Address}" Style="{StaticResource Mono}"
                                                   Foreground="{DynamicResource Muted}" />
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding Latency}"
                                               Style="{StaticResource Mono}"
                                               Foreground="{Binding Color}"
                                               TextAlignment="Right" MinWidth="96"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="3" Text="сейчас" Style="{StaticResource Mono}"
                                               Foreground="{DynamicResource Accent}"
                                               Margin="14,0,0,0" MinWidth="48"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding MarkShown}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource Caption}" Margin="4,10,0,0" TextWrapping="Wrap"
                           Text="Проверяется настоящим запросом DoH, а не пингом: перекрывают именно запрос, и ICMP до 8.8.8.8 при этом ходит прекрасно. Берётся лучший из двух замеров — первый платит за установку TLS." />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
