<UserControl x:Class="NetZapret.Gui.Views.RoutesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="clr-namespace:NetZapret.Gui"
             Background="{DynamicResource Chrome}">

    <UserControl.Resources>
        <!-- Кнопка отбора по маршруту: выбранная залита цветом темы, прочие — голый текст. -->
        <Style x:Key="RouteFilter" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shape" Background="Transparent" CornerRadius="8" Padding="12,0" MinHeight="30">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Raised}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource AccentFill}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Шапка папки внутри карточки (макет 13.10): без своей рамки, подсветка под курсором. -->
        <Style x:Key="RouteHead" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shape" Background="Transparent" CornerRadius="10" Padding="8,8" MinHeight="52">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Raised}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка маршрута внутри карточки папки. -->
        <Style x:Key="RouteRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="MinHeight" Value="50" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Raised}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- «+ Добавить маршрут в эту папку»: пунктирная рамка, как в макете. -->
        <Style x:Key="DashedAdd" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid MinHeight="38">
                            <Rectangle x:Name="Frame" RadiusX="10" RadiusY="10" StrokeThickness="1.2"
                                       StrokeDashArray="4 3" Stroke="{DynamicResource Border}" Fill="Transparent" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Stroke" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Блокнот — контуром, а не знаком шрифта: подходящие знаки есть только
            в Segoe Fluent Icons (Windows 11), а на Windows 10 вышел бы пустой
            квадрат. Обложка, три кольца сверху и строки текста.
        -->
        <Geometry x:Key="NoteGlyph">M8,6 H24 A2,2 0 0 1 26,8 V28 A2,2 0 0 1 24,30 H8 A2,2 0 0 1 6,28 V8 A2,2 0 0 1 8,6 Z M11,3 V9 M16,3 V9 M21,3 V9 M10.5,15 H21.5 M10.5,20 H21.5 M10.5,25 H17.5</Geometry>
    </UserControl.Resources>

    <!--
        Три полосы вместо одного свитка на весь раздел, и это вынужденно,
        а не ради вида. Свиток снаружи отдаёт вложенному списку бесконечную
        высоту, а на бесконечной высоте VirtualizingStackPanel строит все
        строки разом — виртуализация выключается сама и молча. Сервисов
        пятьдесят пять, карточек под семьдесят, и в каждой список выбора,
        кнопка и картинка: об это прокрутка и спотыкалась.

        Прокручивается теперь один список — он и занимает всё, что осталось
        от полос сверху и снизу. Поиск с кнопками остаётся на виду, и это
        скорее к лучшему: прежде строка поиска уезжала вверх ровно тогда,
        когда доходили до найденного.

        Плата за это — две карточки, которые пришлось сделать сворачиваемыми:
        прибитые к верху во всю высоту, они съедали список. «Порядок
        вычисления» сворачивался и раньше, «Свой домен» — теперь тоже, тем же
        приёмом и с тем же значком.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="470" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="32,28,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--
                        Пояснение под заголовком переехало в подсказку.
                        Решение владельца 21.09: список маршрутов занимал
                        треть полосы, а прочитывают эти строки один раз
                        и больше к ним не возвращаются. Под заголовком — одна
                        строка о своих правилах и о перетаскивании (макет 13.10).
                    -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Маршруты" Style="{StaticResource Title}" />

                            <ContentControl Style="{StaticResource Info}" Margin="6,0,0,0"
                                            Content="Куда идёт каждый сервис: напрямую, через десинк или через туннель. Выбор пишется в config\rules.user.yaml и применяется при следующем запуске движков.&#x0a;&#x0a;Сервис вроде YouTube — папка, внутри — маршруты. Строки и папки перетаскиваются мышью: между строками — новый порядок, на папку — внутрь, на одиночный маршрут — новая папка из двух. Куда идёт маршрут, от этого не меняется.&#x0a;&#x0a;Имя означает зону: example.com покрывает и www.example.com, и cdn.example.com.&#x0a;&#x0a;Программа — папка из двух маршрутов: «Домены» и «Адреса». Сначала они пустые и выключены; пока идёт «Наблюдение» и включено автопополнение, туда дописывается всё, что программа открывает. Путь каждому выберите сами.&#x0a;&#x0a;«Десинк» означает «мимо туннеля, чинит пресет»: рецепт не назначается, и если имя не попало ни в один список пресета, с ним не сделают ничего.&#x0a;&#x0a;«Напрямую» — мимо туннеля и мимо десинка: имя уходит в исключения, и winws2 его не трогает вовсе, как и прибитое в hosts.&#x0a;&#x0a;Проверить, что применится, можно в «Проверке блокировок»." />
                        </StackPanel>

                        <TextBlock x:Name="OwnSummary" Style="{StaticResource Caption}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <!--
                            Список, а не кнопка. Кнопка подписывалась
                            действием — «По алфавиту», — и какой порядок
                            стоит сейчас, по ней было не понять; с третьим
                            вариантом стало бы вовсе не угадать.
                        -->
                        <ComboBox x:Name="Sort" Width="164" SelectedIndex="0" Margin="0,0,8,0"
                                  VerticalAlignment="Center" SelectionChanged="OnSort"
                                  ToolTip="По умолчанию — порядок каталога и ваш, оставленный перетаскиванием. Алфавит удобнее, когда ищешь конкретный сервис. По методу — когда хочешь увидеть, что у тебя вообще идёт через VPN.">
                            <ComboBoxItem Content="по умолчанию" />
                            <ComboBoxItem Content="по алфавиту" />
                            <ComboBoxItem Content="по методу" />
                        </ComboBox>

                        <Button x:Name="ExpandButton" Style="{StaticResource Ghost}"
                                Content="Раскрыть всё" Click="OnExpandAll" Margin="0,0,8,0"
                                ToolTip="Раскрывает все папки разом." />

                        <!-- Как «Настройки» у вкладки VPN (владелец, 05.10): то, что задают однажды. -->
                        <Button Style="{StaticResource Ghost}" Content="Настройки" Click="OnSettings" Margin="0,0,8,0"
                                ToolTip="Перезапуск Discord после смены маршрута, пополнение адресов его голоса." />

                        <Button x:Name="ReloadButton" Style="{StaticResource Ghost}"
                                Content="Перечитать" Click="OnReload"
                                ToolTip="Перечитывает правила, пресет и файл hosts с диска. Нужно, если правили их снаружи программы." />
                    </StackPanel>
                </Grid>

                <!--
                    Одно поле на поиск и на свой домен (владелец, 23.09).
                    Прежде их было два, и вписать имя значило сперва решить,
                    ищешь ты его или добавляешь. Теперь вписанное ищется,
                    а если такого нет и это похоже на имя сайта, под полем
                    появляется предложение добавить.

                    Рядом — отбор по маршруту (макет владельца 04.10) и, по макету
                    13.10, «Добавить папку» и «Добавить правило». Прежняя карточка
                    «Свой сайт или программа» с кнопкой программы ушла: программа —
                    пункт меню «Добавить правило», счёт своих правил — строка под
                    заголовком. В узком окне отбор с кнопками уходит под поле
                    (OnSearchRowSize).
                -->
                <Grid x:Name="SearchRow" Margin="0,16,0,0" SizeChanged="OnSearchRowSize">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="Search" TextChanged="OnSearch" KeyDown="OnSearchKey" VerticalAlignment="Center"
                             gui:Hint.Text="Найти сайт, программу или маршрут — или добавить свой" />

                    <StackPanel x:Name="SearchTools" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                        <Border x:Name="RouteFilters" CornerRadius="11" Padding="3" VerticalAlignment="Center"
                                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="FilterAll" Style="{StaticResource RouteFilter}" GroupName="RouteFilter" Tag="" IsChecked="True" Click="OnRouteFilter">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Все" />
                                        <TextBlock x:Name="CountAll" Margin="6,0,0,0" FontWeight="SemiBold" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource RouteFilter}" GroupName="RouteFilter" Tag="2" Click="OnRouteFilter" Margin="3,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Через VPN" />
                                        <TextBlock x:Name="CountVpn" Margin="6,0,0,0" FontWeight="SemiBold" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource RouteFilter}" GroupName="RouteFilter" Tag="1" Click="OnRouteFilter" Margin="3,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Десинк" />
                                        <TextBlock x:Name="CountDesync" Margin="6,0,0,0" FontWeight="SemiBold" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource RouteFilter}" GroupName="RouteFilter" Tag="0" Click="OnRouteFilter" Margin="3,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Напрямую" />
                                        <TextBlock x:Name="CountDirect" Margin="6,0,0,0" FontWeight="SemiBold" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <!--
                            Залита «Добавить правило», а не папка (владелец 13.10): правило —
                            главное действие раздела, папка только раскладывает уже добавленное.
                        -->
                        <Button Style="{StaticResource Ghost}" Margin="10,0,0,0" VerticalAlignment="Center"
                                Click="OnAddFolder" ToolTip="Пустая папка — перетащите в неё маршруты.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Добавить папку" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!--
                            Программа — пунктом этого меню, как «Добавить…» в Happ
                            (владелец 01.10): из запущенных или файлом. С 13.10 —
                            папка программы из доменов и адресов (ProgramRoutes).
                        -->
                        <Button x:Name="AddProgramButton" Style="{StaticResource Primary}" Margin="8,0,0,0"
                                VerticalAlignment="Center" Click="OnAddProgram"
                                ToolTip="Свой сайт, адрес или подсеть — или программа: папка из доменов и адресов, которые она открывает.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Добавить правило" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="AddOffer" Style="{StaticResource Card}" Margin="0,10,0,0"
                        Padding="16,11" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="AddOfferText" VerticalAlignment="Center" TextWrapping="Wrap" />

                        <Button Grid.Column="1" Style="{StaticResource Primary}" Margin="12,0,0,0"
                                Content="Добавить" Click="OnAddOwn" />
                    </Grid>
                </Border>

                <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="4,12,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!--
                Папки карточками в две колонки — макет владельца 13.10. Каждая
                следующая карточка встаёт в ту колонку, что короче (MasonryPanel),
                на узком окне колонка одна.

                Без виртуализации: колонки не разложить, не измерив все карточки
                выше. До 13.10 список был виртуальным, потому что каждая строка
                несла список выбора, и семьдесят их разом спотыкали прокрутку.
                Теперь выбор пути — кнопка с меню (OnRouteMenu), а строки
                свёрнутых папок не строятся вовсе: их ItemsControl скрыт и не
                меряется.
            -->
            <ItemsControl Grid.Row="1" x:Name="Services" Margin="0,14,0,0"
                          AllowDrop="True" PreviewDragOver="OnListDragOver">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="False" Focusable="False"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <gui:MasonryPanel ColumnWidth="520" Gap="14" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="6" Visibility="{Binding CardShown}">
                            <StackPanel>

                                <!--
                                    Шапка папки: стрелка, значок, имя и под ним итог —
                                    сколько маршрутов и куда идут. Свёрнутая папка
                                    говорит то же, что раскрытая. Перетаскивание
                                    (RoutesView.Drag.cs): папку тянут за шапку.
                                -->
                                <Button Style="{StaticResource RouteHead}" Click="OnFolder"
                                        PreviewMouseLeftButtonDown="OnDragPress" PreviewMouseMove="OnDragMove"
                                        AllowDrop="True" DragOver="OnRowDragOver" DragLeave="OnRowDragLeave" Drop="OnRowDrop"
                                        Visibility="{Binding HeaderShown}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Path Grid.Column="0" Style="{StaticResource Chevron}" Margin="4,0,12,0">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="{Binding ChevronAngle}" />
                                            </Path.RenderTransform>
                                        </Path>

                                        <Grid Grid.Column="1" Width="30" Height="30" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource Raised}" CornerRadius="7"
                                                    Visibility="{Binding LetterShown}">
                                                <TextBlock Text="{Binding Letter}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Muted}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="22"
                                                       Foreground="{DynamicResource Warn}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding FolderGlyphShown}" />

                                            <Image Source="{Binding Icon}" Stretch="Uniform" Margin="2"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding IconShown}" />
                                        </Grid>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Shown}" FontWeight="SemiBold" FontSize="14"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"
                                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Subtitle}" />
                                        </StackPanel>

                                        <!--
                                            Автопополнение программы (владелец 13.10:
                                            «у каждого процесса тумблер автопополнения»).
                                            Внутри кнопки шапки — щелчок до неё не доходит.
                                        -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                    Margin="12,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding ProgramShown}">
                                            <TextBlock Text="автопополнение" Style="{StaticResource Caption}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                                       ToolTip="{Binding AutoFillHint}" />
                                            <ToggleButton Style="{StaticResource Switch}"
                                                          IsChecked="{Binding AutoFill, Mode=OneWay}"
                                                          Tag="{Binding Program}" Click="OnAutoFill"
                                                          ToolTip="{Binding AutoFillHint}" />
                                        </StackPanel>

                                        <Button Grid.Column="4" Style="{StaticResource IconGhost}" Content="&#xE712;"
                                                Margin="10,0,0,0" Click="OnFolderMore"
                                                ToolTip="Переименовать, распустить, добавить маршрут" />
                                    </Grid>
                                </Button>

                                <ItemsControl ItemsSource="{Binding ShownParts}" Visibility="{Binding PartsShown}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!--
                                                Строка маршрута — без своей карточки, внутри
                                                карточки папки (макет 13.10). Подпись пути
                                                («десинк: multidisorder») — второй строкой
                                                рядом с числом имён: справа место кнопкам.
                                            -->
                                            <Border Style="{StaticResource RouteRow}"
                                                    PreviewMouseLeftButtonDown="OnDragPress" PreviewMouseMove="OnDragMove"
                                                    AllowDrop="True" DragOver="OnRowDragOver" DragLeave="OnRowDragLeave" Drop="OnRowDrop">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="⠿" FontSize="15"
                                                               Foreground="{DynamicResource Faint}"
                                                               VerticalAlignment="Center" Margin="2,0,10,0"
                                                               Cursor="SizeAll" Visibility="{Binding GripShown}"
                                                               ToolTip="Перетащите: между строками — новый порядок, на папку — внутрь" />

                                                    <Grid Grid.Column="1" Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource Raised}" CornerRadius="5"
                                                                Visibility="{Binding LetterShown}">
                                                            <TextBlock Text="{Binding Letter}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Muted}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>

                                                        <Image Source="{Binding Icon}" Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding IconShown}" />
                                                    </Grid>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Title}" />

                                                        <Grid Margin="0,3,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                                       MaxWidth="240" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                                            <TextBlock Grid.Column="1" Style="{StaticResource Caption}"
                                                                       Foreground="{Binding Color}" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding ModeHint}">
                                                                <Run Text=" · " Foreground="{DynamicResource Muted}" /><Run Text="{Binding Mode, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </Grid>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!--
                                                            Выбор пути — кнопкой с меню, а не списком
                                                            выбора: карточки не виртуализированы (OnRouteMenu).
                                                        -->
                                                        <Button Style="{StaticResource Ghost}" Padding="12,6" MinWidth="122"
                                                                Click="OnRouteMenu" IsEnabled="{Binding CanRoute}"
                                                                HorizontalContentAlignment="Stretch">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding RouteLabel}" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" FontFamily="{StaticResource IconFont}" Text="&#xE70D;"
                                                                           FontSize="10" Margin="10,1,0,0" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Button>

                                                        <!--
                                                            Список — квадратной кнопкой, как пин (владелец 13.10):
                                                            открывает файл в Блокноте (с 26.09 — ссылкой «список»
                                                            во второй строке). Скрытая, а не убранная: иначе
                                                            у строк без списка пин уезжал бы влево.
                                                        -->
                                                        <Button Style="{StaticResource Ghost}"
                                                                Padding="8,7" Margin="6,0,0,0"
                                                                Click="OnOpenList"
                                                                Visibility="{Binding ListShown}"
                                                                ToolTip="{Binding ListHint}">
                                                            <Path Data="{StaticResource NoteGlyph}" Stroke="{DynamicResource Text}"
                                                                  StrokeThickness="1.4" StrokeLineJoin="Round"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  Stretch="Uniform" Width="14" Height="14" />
                                                        </Button>

                                                        <!--
                                                            Пин у маршрута, а не у папки: адрес прибивается
                                                            конкретным именам. Что случится — в подсказке:
                                                            «снять» от «поставить» по картинке не отличить.
                                                        -->
                                                        <Button Style="{StaticResource Ghost}"
                                                                Padding="8,7" Margin="6,0,0,0"
                                                                Tag="{Binding Key}" Click="OnPin"
                                                                IsEnabled="{Binding CanPin}"
                                                                ToolTip="{Binding PinHint}">
                                                            <Path Data="{StaticResource PinGlyph}"
                                                                  Fill="{Binding PinColor}"
                                                                  Stretch="Uniform" Width="14" Height="14" />
                                                        </Button>

                                                        <!-- Папки и «убрать» у своего — в «⋯» (OnRouteMore). -->
                                                        <Button Style="{StaticResource IconGhost}" Content="&#xE712;" Margin="6,0,0,0"
                                                                Tag="{Binding Key}" Click="OnRouteMore"
                                                                Visibility="{Binding MoreShown}"
                                                                ToolTip="В новую папку, вынуть из папки, вернуть на место; у своего — убрать" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Пусто — перетащите сюда маршруты или добавьте свой." Style="{StaticResource Caption}"
                                           Margin="12,4,12,8" Visibility="{Binding EmptyShown}" />

                                <!-- По макету 13.10: свой сайт, адрес или подсеть — сразу в эту папку. -->
                                <Button Style="{StaticResource DashedAdd}" Margin="6,4,6,4"
                                        Click="OnAddIntoFolder" Visibility="{Binding AddShown}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Добавить маршрут в эту папку" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="2">

                <!--
                    Порядок вычисления и «сохранить / загрузить» — одной
                    полосой, и это исправление 23.09.

                    Отдельной карточкой над порядком нижняя полоса выросла
                    вдвое. Растёт она за счёт списка: тот берёт всё, что
                    осталось от полос сверху и снизу, и у владельца на окне
                    в 877 точек от него остались две с половиной строки.

                    До 30.09 здесь была «Книга» — свой формат «имя: маршрут»
                    с переводом туда и обратно. Владелец: делиться самим
                    файлом правил (RulesShare) — это одно и то же, а перевод
                    отстал от правил для программ и своих списков.

                    Порядок вычисления: список выше сгруппирован по сервисам —
                    так о маршрутах и думают, — но группировка прячет главное:
                    побеждает правило, до которого очередь доходит раньше.
                    Свёрнут по умолчанию: правил под сотню, и разворачивают
                    их, когда правило написано, а не срабатывает.
                -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource Choice}" Click="OnOrderToggle">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Path x:Name="OrderChevron" Grid.Column="0"
                                  Style="{StaticResource Chevron}" Margin="0,0,12,0" />

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Порядок вычисления" FontWeight="SemiBold" />
                                <TextBlock x:Name="OrderSummary" Style="{StaticResource Caption}"
                                           Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Маршруты файлом" FontWeight="SemiBold" VerticalAlignment="Center" />

                        <ContentControl Style="{StaticResource Info}" Margin="2,0,8,0"
                                        Content="Ваши маршруты — это файл config\rules.user.yaml: всё, что выбрано на этой вкладке, включая маршруты программ и правила по адресам. Его можно сохранить и отдать другому человеку: ссылок подписок и ключей в нём нет.&#x0a;&#x0a;Не едут с ним свои списки доменов (config\lists\own) и пины — их у каждой машины свои.&#x0a;&#x0a;Загрузка заменяет ваши маршруты целиком: перед этим покажет, что добавится, что уйдёт и что сменит маршрут, а прежний файл сохранит копией в runtime." />

                        <Button x:Name="ExportButton" Style="{StaticResource Ghost}"
                                Content="Сохранить" Click="OnSaveRoutes" Margin="0,0,8,0" Padding="12,7" />

                        <Button x:Name="ImportButton" Style="{StaticResource Ghost}"
                                Content="Загрузить" Click="OnLoadRoutes" Padding="12,7"
                                ToolTip="Прочитать маршруты из файла. Покажет, что изменится, и спросит перед записью." />
                    </StackPanel>
                </Grid>

                <!--
                    Противоречия в своих правилах и пинах (RouteClashes).
                    Показываются только когда есть: пустая строка
                    «противоречий нет» на каждом заходе превратилась
                    бы в шум, который перестают читать. Свой свиток —
                    по той же причине, что у порядка: полоса под списком
                    растёт за его счёт.
                -->
                <ScrollViewer x:Name="ClashesBox" MaxHeight="160" Margin="0,10,0,0"
                              VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ItemsControl x:Name="Clashes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Raised}" CornerRadius="6"
                                        Padding="10,8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Warn}" />
                                        <TextBlock Text="{Binding Outcome}" Style="{StaticResource Caption}"
                                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="OrderPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <Grid Margin="16,0,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="#" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="1" Text="ТИП" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="2" Text="ЗНАЧЕНИЕ" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="3" Text="РЕЖИМ" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="4" Text="СЕРВЕР" Style="{StaticResource Caption}" />
                    </Grid>

                    <!--
                        Своя высота и свой свиток. Полоса под списком больше
                        не растягивает раздел — растягивать некуда, — и сотня
                        правил, развёрнутая целиком, выдавила бы список
                        сервисов с экрана. Виртуализация здесь по той же
                        причине, что и там: строк под сотню, а видно десяток.
                    -->
                    <ItemsControl x:Name="Order" MaxHeight="320"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True" Focusable="False"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <!--
                                Свои правила таскаются за строку — в пределах
                                своей группы движка (RuleEngine.Tier). Ручка
                                слева видна только у них: заводские стоят
                                в rules.yaml, и переставлять их отсюда нечем.
                            -->
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,4" Padding="16,9"
                                        AllowDrop="True"
                                        PreviewMouseLeftButtonDown="OnRulePress"
                                        MouseMove="OnRuleDrag"
                                        DragOver="OnRuleDragOver"
                                        Drop="OnRuleDrop">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="⠿" Foreground="{DynamicResource Faint}"
                                                       Margin="-10,0,4,0" Cursor="SizeNS"
                                                       Visibility="{Binding GripShown}"
                                                       ToolTip="Перетащите, чтобы поменять порядок" />
                                            <TextBlock Text="{Binding Ordinal}"
                                                       Style="{StaticResource Mono}"
                                                       Foreground="{DynamicResource Muted}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding Kind}"
                                                   Style="{StaticResource Mono}"
                                                   Foreground="{DynamicResource Muted}" />

                                        <TextBlock Grid.Column="2" Text="{Binding Value}"
                                                   Style="{StaticResource Mono}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Value}" Margin="0,0,8,0" />

                                        <TextBlock Grid.Column="3" Text="{Binding Mode}"
                                                   Style="{StaticResource Mono}"
                                                   Foreground="{Binding Color}" />

                                        <TextBlock Grid.Column="4" Text="{Binding Server}"
                                                   Style="{StaticResource Mono}"
                                                   Foreground="{DynamicResource Muted}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="OrderNote" Style="{StaticResource Caption}"
                               Margin="4,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
