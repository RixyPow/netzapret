<UserControl x:Class="NetZapret.Gui.Views.RoutesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Backdrop}">

    <!--
        Три полосы вместо одного свитка на весь раздел, и это вынужденно,
        а не ради вида. Свиток снаружи отдаёт вложенному списку бесконечную
        высоту, а на бесконечной высоте VirtualizingStackPanel строит все
        строки разом — виртуализация выключается сама и молча. Сервисов
        пятьдесят пять, карточек под семьдесят, и в каждой список выбора,
        кнопка и картинка: об это прокрутка и спотыкалась.

        Прокручивается теперь один список — он и занимает всё, что осталось
        от полос сверху и снизу. Поиск с кнопками остаётся на виду, и это
        скорее к лучшему: прежде строка поиска уезжала вверх ровно тогда,
        когда доходили до найденного.

        Плата за это — две карточки, которые пришлось сделать сворачиваемыми:
        прибитые к верху во всю высоту, они съедали список. «Порядок
        вычисления» сворачивался и раньше, «Свой домен» — теперь тоже, тем же
        приёмом и с тем же значком.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="470" MaxWidth="1240" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="32,28,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--
                        Пояснение под заголовком переехало в подсказку.
                        Решение владельца 21.09: список маршрутов занимал
                        треть полосы, а прочитывают эти строки один раз
                        и больше к ним не возвращаются.
                    -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Маршруты" Style="{StaticResource Title}" />

                        <ContentControl Style="{StaticResource Info}" Margin="6,0,0,0"
                                        Content="Куда идёт каждый сервис: напрямую, через десинк или через туннель. Выбор пишется в config\rules.user.yaml и применяется при следующем запуске движков." />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SortButton" Style="{StaticResource Ghost}"
                                Content="По алфавиту" Click="OnSort" Margin="0,0,8,0"
                                ToolTip="Порядок каталога сверху ставит то, что ломается чаще. Алфавит удобнее, когда ищешь конкретный сервис." />

                        <Button x:Name="ExpandButton" Style="{StaticResource Ghost}"
                                Content="Раскрыть всё" Click="OnExpandAll" Margin="0,0,8,0"
                                ToolTip="Раскрывает все папки разом. Разворачиваются только те пять сервисов, у которых части ломаются врозь." />

                        <Button x:Name="ReloadButton" Style="{StaticResource Ghost}"
                                Content="Перечитать" Click="OnReload"
                                ToolTip="Перечитывает правила, пресет и файл hosts с диска. Нужно, если правили их снаружи программы." />
                    </StackPanel>
                </Grid>

                <!--
                    Свой домен. Каталог покрывает то, что мы предусмотрели,
                    а сайтов миллион: без этой строки направить seriesgraph.com
                    было нечем.

                    Не сворачивается, и это решение владельца от 20.09.
                    Свёрнутым он был, пока держал в себе перечень своих
                    правил и занимал треть полосы над списком. Перечень
                    переехал в общий список сервисов, и осталась форма
                    в одну строку — прятать её под щелчок значит ставить
                    щелчок между человеком и единственным тут действием.
                -->
                <!--
                    Поля те же, что у стиля Choice, которым карточка была
                    кнопкой: 16,13 против 18,16 у Card. Разница в три точки
                    заметна — карточка стоит в ряду с такими же, и смена
                    стиля не должна двигать её относительно соседей.
                -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,11">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Свой домен" FontWeight="SemiBold" VerticalAlignment="Center" />

                            <!--
                                Два абзаца оговорок, стоявшие под формой,
                                теперь здесь. Оба нужны — «десинк» без них
                                обещает больше, чем делает, — но занимали
                                они семьдесят точек высоты постоянно, ради
                                текста, который читают однажды.
                            -->
                            <ContentControl Style="{StaticResource Info}" Margin="4,0,0,0"
                                            Content="Имя означает зону: example.com покрывает и www.example.com, и cdn.example.com.&#x0a;&#x0a;«Десинк» означает «мимо туннеля, чинит пресет»: рецепт не назначается, и если имя не попало ни в один список пресета, с ним не сделают ничего.&#x0a;&#x0a;«Напрямую» — мимо туннеля и мимо десинка: имя уходит в исключения, и winws2 его не трогает вовсе, как и прибитое в hosts.&#x0a;&#x0a;Проверить, что применится, можно в «Проверке блокировок»." />
                        </StackPanel>

                        <TextBlock x:Name="OwnSummary" Style="{StaticResource Caption}"
                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="OwnPanel" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" x:Name="OwnDomain" Margin="0,0,8,0"
                                 KeyDown="OnOwnKey" />

                        <ComboBox Grid.Column="1" x:Name="OwnMode" Width="146" SelectedIndex="2" Margin="0,0,8,0">
                            <ComboBoxItem Content="напрямую" />
                            <ComboBoxItem Content="десинк" />
                            <ComboBoxItem Content="через VPN" />
                        </ComboBox>

                        <Button Grid.Column="2" Style="{StaticResource Primary}"
                                Content="Добавить" Click="OnAddOwn" />
                    </Grid>

                    <!--
                        Два абзаца пояснений отсюда ушли в подсказку
                        у заголовка карточки — см. выше. Держать их здесь
                        значило тратить семьдесят точек высоты постоянно
                        ради текста, который прочитывают однажды.
                    -->

                    <!--
                        Списка добавленных здесь больше нет: с 0.6.3 свои
                        домены стоят в общем списке сервисов ниже, наравне
                        с каталожными. Там им достаются значок сайта, пин,
                        выбор рецепта и поиск — всё то, чего эта карточка
                        не давала. Осталось ровно то, ради чего её открывают:
                        вписать имя.
                    -->
                </StackPanel>

                <!--
                    Поиск: частей под семьдесят, и глазами их не перебрать.
                    С подсказкой внутри: пустое поле без неё читается как
                    пустая карточка, поставленная по ошибке.
                -->
                <Grid Margin="0,18,0,0">
                    <TextBox x:Name="Search" TextChanged="OnSearch" />

                    <TextBlock x:Name="SearchHint" IsHitTestVisible="False"
                               Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="13,0,0,0"
                               Text="Поиск по сервису, части или домену" />
                </Grid>

                <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="4,12,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!--
                Единственное, что здесь прокручивается, и единственное, чему
                нужна виртуализация. Собственный свиток внутри шаблона — затем,
                что у ItemsControl своего нет вовсе, а без него список меряется
                на бесконечной высоте и строит все строки сразу.

                Переиспользование контейнеров, а не пересоздание: карточка
                части — это список выбора, кнопка и картинка, и заново собирать
                её на каждый оборот колеса ровно то же расточительство,
                от которого уходим.

                Шаг прокрутки в точках, а не в строках: строки разной высоты —
                свёрнутая папка в одну карточку и раскрытая в шесть, — и шаг
                строкой перепрыгивал бы через полэкрана.
            -->
            <ItemsControl Grid.Row="1" x:Name="Services" Margin="0,14,0,0"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True" Focusable="False"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!--
                            Шаг задают сами строки, не эта стопка: у папки
                            шапка, у одиночного его единственная строка,
                            и у обеих снизу одинаковые шесть. Стопка со
                            своим полем добавляла их второй раз, и под
                            одиночным сервисом выходило вдвое больше,
                            чем под свёрнутой папкой.
                        -->
                        <StackPanel>

                            <!--
                                Папка сервиса. Свёрнутая, но не немая:
                                в заголовке видно, куда идут её части, —
                                иначе, чтобы узнать про YouTube, пришлось бы
                                открывать YouTube, а чтобы окинуть взглядом
                                всё — открыть все двадцать две.
                            -->
                            <Button Style="{StaticResource Folder}" Click="OnFolder"
                                    Margin="0,0,0,6"
                                    Visibility="{Binding HeaderShown}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--
                                        Поле в 24 точки сохранено от прежней
                                        надписи: на нём выверено, что заголовок
                                        не ёрзает при раскрытии.
                                    -->
                                    <Path Grid.Column="0" Style="{StaticResource Chevron}"
                                          Margin="7,0,12,0">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="{Binding ChevronAngle}" />
                                        </Path.RenderTransform>
                                    </Path>

                                    <!--
                                        Значок той же меры, что у строки части.
                                        Без него шапка выходила ниже, и список
                                        шёл ступеньками: у папки одна высота,
                                        у одиночного сервиса другая.
                                    -->
                                    <Grid Grid.Column="1" Width="22" Height="22"
                                          Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource Raised}"
                                                CornerRadius="5"
                                                Visibility="{Binding LetterShown}">
                                            <TextBlock Text="{Binding Letter}" FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Muted}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <Image Source="{Binding Icon}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding IconShown}" />
                                    </Grid>

                                    <TextBlock Grid.Column="2" Text="{Binding Name}"
                                               FontWeight="SemiBold" FontSize="14"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="3" Text="{Binding Count}"
                                               Style="{StaticResource Caption}" Margin="10,0,12,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Column="4" Text="{Binding Summary}"
                                               Style="{StaticResource Mono}"
                                               Foreground="{Binding Color}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!--
                                Отступ слева только у вложенных: одиночный
                                сервис показывается без шапки, и сдвигать
                                его не от чего.
                            -->
                            <ItemsControl ItemsSource="{Binding Parts}"
                                          Visibility="{Binding PartsShown}"
                                          Margin="{Binding PartsMargin}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--
                                            Высота задана явно и одна на всех.
                                            Список выбора внутри строки выше
                                            простого текста в шапке папки,
                                            и без этого строки шли ступеньками.
                                        -->
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,6"
                                                Padding="14,10" MinHeight="64">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!--
                                                    Значок сайта, если он у нас есть.
                                                    Тянется с самого сайта и лежит
                                                    в кэше; чужим службам список имён
                                                    не отдаётся.
                                                -->
                                                <Grid Grid.Column="0" Width="22" Height="22"
                                                      Margin="{Binding IconMargin}"
                                                      VerticalAlignment="Center">
                                                    <Border Background="{DynamicResource Raised}"
                                                            CornerRadius="5"
                                                            Visibility="{Binding LetterShown}">
                                                        <TextBlock Text="{Binding Letter}" FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Muted}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <Image Source="{Binding Icon}" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Visibility="{Binding IconShown}" />
                                                </Grid>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Mode}" Style="{StaticResource Mono}"
                                                               Foreground="{Binding Color}"
                                                               VerticalAlignment="Center"
                                                               TextAlignment="Right" MinWidth="72" Margin="0,0,12,0" />

                                                    <ComboBox Width="132" SelectedIndex="{Binding Choice}"
                                                              Tag="{Binding Key}"
                                                              SelectionChanged="OnRoute"
                                                              DropDownClosed="OnRouteClosed"
                                                              IsEnabled="{Binding CanRoute}">
                                                        <ComboBoxItem Content="напрямую" />
                                                        <ComboBoxItem Content="десинк" />
                                                        <ComboBoxItem Content="через VPN" />
                                                    </ComboBox>

                                                    <!--
                                                        Пин у части, а не у сервиса: адрес
                                                        прибивается конкретным именам, и
                                                        у Discord голос лечится отдельно
                                                        от картинок.
                                                    -->
                                                    <!--
                                                        Значком, а не словом. Слово «пин»
                                                        занимало девяносто две точки ширины
                                                        в каждой из семидесяти строк, а сам
                                                        значок — двадцать.

                                                        Что именно случится, говорит подсказка:
                                                        у значка два состояния, и «снять» от
                                                        «поставить» по одной картинке
                                                        не отличить.
                                                    -->
                                                    <Button Style="{StaticResource Ghost}"
                                                            Padding="8,7" Margin="8,0,0,0"
                                                            Tag="{Binding Key}" Click="OnPin"
                                                            IsEnabled="{Binding CanPin}"
                                                            ToolTip="{Binding PinHint}">
                                                        <Path Data="{StaticResource PinGlyph}"
                                                              Fill="{Binding PinColor}"
                                                              Stretch="Uniform" Width="14" Height="14" />
                                                    </Button>

                                                    <!--
                                                        Убрать можно только своё. У каталожной
                                                        части убирать нечего: она не добавлена
                                                        человеком и никуда не денется — ей
                                                        меняют маршрут, а не существование.
                                                    -->
                                                    <Button Style="{StaticResource Ghost}"
                                                            Content="убрать" Padding="12,7"
                                                            Margin="8,0,0,0"
                                                            Tag="{Binding Key}" Click="OnRemoveOwn"
                                                            Visibility="{Binding RemoveShown}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="2">

                <!--
                    Порядок вычисления. Список выше сгруппирован по сервисам —
                    так о маршрутах и думают, — но группировка прячет главное:
                    побеждает правило, до которого очередь доходит раньше.
                    Перекрытое правило в файле есть, а не применяется никогда,
                    и увидеть это можно только в этом порядке.

                    Свёрнут по умолчанию: правил под сотню, и разворачивают
                    их, когда правило написано, а не срабатывает.
                -->
                <Button Style="{StaticResource Choice}" Margin="0,22,0,0" Click="OnOrderToggle">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Path x:Name="OrderChevron" Grid.Column="0"
                              Style="{StaticResource Chevron}" Margin="0,0,12,0" />

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Порядок вычисления" FontWeight="SemiBold" />
                            <TextBlock x:Name="OrderSummary" Style="{StaticResource Caption}"
                                       Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Button>

                <StackPanel x:Name="OrderPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <Grid Margin="16,0,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="#" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="1" Text="ТИП" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="2" Text="ЗНАЧЕНИЕ" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="3" Text="РЕЖИМ" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="4" Text="СЕРВЕР" Style="{StaticResource Caption}" />
                    </Grid>

                    <!--
                        Своя высота и свой свиток. Полоса под списком больше
                        не растягивает раздел — растягивать некуда, — и сотня
                        правил, развёрнутая целиком, выдавила бы список
                        сервисов с экрана. Виртуализация здесь по той же
                        причине, что и там: строк под сотню, а видно десяток.
                    -->
                    <ItemsControl x:Name="Order" MaxHeight="320"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True" Focusable="False"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,4" Padding="16,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Ordinal}"
                                                   Style="{StaticResource Mono}"
                                                   Foreground="{DynamicResource Muted}" />

                                        <TextBlock Grid.Column="1" Text="{Binding Kind}"
                                                   Style="{StaticResource Mono}"
                                                   Foreground="{DynamicResource Muted}" />

                                        <TextBlock Grid.Column="2" Text="{Binding Value}"
                                                   Style="{StaticResource Mono}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Value}" Margin="0,0,8,0" />

                                        <TextBlock Grid.Column="3" Text="{Binding Mode}"
                                                   Style="{StaticResource Mono}"
                                                   Foreground="{Binding Color}" />

                                        <TextBlock Grid.Column="4" Text="{Binding Server}"
                                                   Style="{StaticResource Mono}"
                                                   Foreground="{DynamicResource Muted}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="OrderNote" Style="{StaticResource Caption}"
                               Margin="4,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
