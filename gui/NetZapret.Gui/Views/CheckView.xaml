<UserControl x:Class="NetZapret.Gui.Views.CheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:gui="clr-namespace:NetZapret.Gui"
             Background="{DynamicResource Chrome}">

    <!--
        Вид по макету владельца 27.10: плитки-отборы, поиск, таблица и панель
        выбранного имени справа. Прежде строка таблицы несла всё сразу —
        TCP, TLS, порт 80, данные, — и новичок не находил в ней ответа
        «открывается ли». Теперь в таблице ответ, а замер по стадиям, адреса,
        почерк и что с этим делать — в панели. Колонки ширин — ресурсами:
        на узком окне «Сеть» и «Ответ» убираются (OnPageSize).
    -->
    <UserControl.Resources>
        <GridLength x:Key="StatusColumn">150</GridLength>
        <GridLength x:Key="LatencyColumn">68</GridLength>
        <GridLength x:Key="RouteColumn">118</GridLength>
        <GridLength x:Key="NetColumn">100</GridLength>
        <GridLength x:Key="WhyColumn">132</GridLength>
        <Visibility x:Key="TileIconShown">Visible</Visibility>

        <!-- Выбор глубины — как отборы в «Маршрутах»: один вид на одно и то же. -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shape" Background="Transparent" CornerRadius="8" Padding="12,0" MinHeight="30">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Raised}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource AccentFill}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Плитка счёта — она же отбор. Выбранная обводится цветом текста, а не
            зелёным: зелёный здесь значит «доступен», и обведённая им «Всего»
            читалась бы как «всё в порядке» (разбор макета 27.10).
        -->
        <Style x:Key="CountTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardEdge}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <gui:Card x:Name="Shape" Background="{DynamicResource Surface}"
                                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2"
                                  CornerRadius="14" Padding="16,12" gui:Glass.IsOn="True">
                            <ContentPresenter />
                        </gui:Card>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Muted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Значок плитки; на узком окне убирается, плитки остаются в один ряд (OnPageSize). -->
        <Style x:Key="TileIcon" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="{DynamicResource Raised}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Visibility" Value="{DynamicResource TileIconShown}" />
        </Style>

        <Style x:Key="TileNumber" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>

        <Style x:Key="PanelHead" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>

        <!-- Строка таблицы: подсветка под курсором, выбранная — полосой слева. -->
        <Style x:Key="CheckItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" Padding="16,0,10,0"
                                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Rectangle x:Name="Mark" Width="3" Margin="-16,8,0,8" HorizontalAlignment="Left"
                                           RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Accent}" Visibility="Collapsed" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Raised}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Raised}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Значок сайта, а нет его — первая буква на плашке. -->
        <DataTemplate x:Key="SiteMark">
            <Grid Width="26" Height="26">
                <Border CornerRadius="7" Background="{DynamicResource Raised}">
                    <TextBlock Text="{Binding Letter}" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Image Source="{Binding Icon}" Width="22" Height="22" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </DataTemplate>

        <!-- Точка и слово: стадии, пути, итог подбора. -->
        <DataTemplate x:Key="DotLine">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" Fill="{Binding Ink}" VerticalAlignment="Top" Margin="0,5,0,0"
                         HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0"
                           Visibility="{Binding NameShown}" />
                <TextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Muted}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Page" Margin="32,28,32,20" SizeChanged="OnPageSize">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка: заголовок, глубина, «Прервать» и «Проверить всё». -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                Заголовок переносится, а не обрезается. Обрезанный превращался
                в «Проверка блс»: строка, которая выглядит не тесной вёрсткой,
                а опечаткой.
            -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="Проверка блокировок" Style="{StaticResource Title}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Что закрыто в этой сети и чем это лечится." />
            </StackPanel>

            <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <!--
                    Глубина: быстрая — по имени с каждой части справочника, полная —
                    по два, точечная — один сервис или своё имя вчетверо глубже.
                    Когда чинят Discord, ответ нужен про Discord, а не про сорок
                    имён, из которых он одно.
                -->
                <Border CornerRadius="11" Padding="3" Margin="0,0,8,4" VerticalAlignment="Center"
                        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1.5">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ScopeQuick" Style="{StaticResource Segment}" GroupName="Scope"
                                     Content="Быстрая" Click="OnScope" />
                        <RadioButton x:Name="ScopeFull" Style="{StaticResource Segment}" GroupName="Scope"
                                     Content="Полная" Click="OnScope" />
                        <RadioButton x:Name="ScopeSpot" Style="{StaticResource Segment}" GroupName="Scope"
                                     Content="Точечная" Click="OnScope" />
                    </StackPanel>
                </Border>

                <Button x:Name="StopButton" Style="{StaticResource Ghost}" Content="Прервать"
                        Click="OnStop" Margin="0,0,8,4" IsEnabled="False" />
                <!--
                    Ширина постоянная: подпись меняется с глубиной («Проверить всё»,
                    «Проверить полностью», «Проверить «Discord»»), и кнопка по
                    подписи двигала весь ряд слева от себя (владелец 27.10:
                    «плашка сверху скачет»).
                -->
                <Button x:Name="RunButton" Style="{StaticResource Primary}" Content="Проверить всё"
                        Width="210" Click="OnRun" Margin="0,0,0,4" />
            </WrapPanel>
        </Grid>

        <!--
            Обстановка замера одной строкой. Без неё отчёт нечем толковать: при
            работающем обходе видно сеть уже вылеченной, а не такой, какая она есть.
            Подробно — в итоге, в панели справа.
        -->
        <Border Grid.Row="1" Margin="0,16,0,0" CornerRadius="10" Padding="14,8"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1.5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="SetupDot" Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center"
                         Fill="{DynamicResource Faint}" />
                <TextBlock x:Name="SetupLine" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="Status" Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Grid>
        </Border>

        <!-- Счёт по ступеням; плитка — отбор таблицы. -->
        <UniformGrid x:Name="Tiles" Grid.Row="2" Columns="4" Margin="-6,10,-6,0">
            <Button x:Name="TileAll" Style="{StaticResource CountTile}" Tag="" Click="OnTile" Margin="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource TileIcon}">
                        <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE8FD;" FontSize="18" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Всего" Style="{StaticResource Caption}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="CountAll" Style="{StaticResource TileNumber}" Text="0" />
                            <TextBlock Text=" имён" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="TileOpen" Style="{StaticResource CountTile}" Tag="Open" Click="OnTile" Margin="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource TileIcon}">
                        <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE73E;" FontSize="18" Foreground="{DynamicResource Accent}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Доступны" Style="{StaticResource Caption}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="CountOpen" Style="{StaticResource TileNumber}" Text="0" />
                            <TextBlock x:Name="ShareOpen" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="8,0,0,4" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="TileLimited" Style="{StaticResource CountTile}" Tag="Limited" Click="OnTile" Margin="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource TileIcon}">
                        <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE7BA;" FontSize="18" Foreground="{DynamicResource Warn}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="С ограничениями" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="CountLimited" Style="{StaticResource TileNumber}" Text="0" />
                            <TextBlock x:Name="ShareLimited" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="8,0,0,4" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Button>

            <Button x:Name="TileClosed" Style="{StaticResource CountTile}" Tag="Closed" Click="OnTile" Margin="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource TileIcon}">
                        <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE711;" FontSize="18" Foreground="{DynamicResource Danger}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Недоступны" Style="{StaticResource Caption}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="CountClosed" Style="{StaticResource TileNumber}" Text="0" />
                            <TextBlock x:Name="ShareClosed" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="8,0,0,4" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Button>
        </UniformGrid>

        <!--
            Поиск сужает таблицу по имени и сервису. Незнакомое имя по Enter
            проверяется отдельно и встаёт в таблицу первым — как своё имя
            в «Маршрутах»: искать и добавлять в одном поле.
        -->
        <TextBox x:Name="Search" Grid.Row="3" Margin="0,10,0,0" TextChanged="OnSearch" KeyDown="OnSearchKey"
                 gui:Hint.Text="Найти имя или сервис — или проверить своё (Enter)" />

        <Grid x:Name="Main" Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TableColumn" Width="*" />
                <ColumnDefinition x:Name="GapColumn" Width="16" />
                <ColumnDefinition x:Name="PanelColumn" Width="360" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TableRow" Height="*" />
                <RowDefinition x:Name="GapRow" Height="0" />
                <RowDefinition x:Name="PanelRow" Height="0" />
            </Grid.RowDefinitions>

            <!--
                Таблица виртуальная, как в «Наблюдении»: полная проверка — сотни
                имён. Прокрутка внутри шаблона списка, а не страницы: иначе
                VirtualizingStackPanel получает бесконечную высоту и строит всё.
            -->
            <gui:Card x:Name="TableCard" Style="{StaticResource Card}" Padding="0,8,0,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="16,4,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150" />
                            <ColumnDefinition Width="{DynamicResource StatusColumn}" />
                            <ColumnDefinition Width="{DynamicResource LatencyColumn}" />
                            <ColumnDefinition Width="{DynamicResource RouteColumn}" />
                            <ColumnDefinition Width="{DynamicResource NetColumn}" />
                            <ColumnDefinition Width="{DynamicResource WhyColumn}" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Сайт" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="1" Text="Статус" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="2" Text="Ответ" Style="{StaticResource Caption}"
                                   ToolTip="Сколько шло рукопожатие TLS" />
                        <TextBlock Grid.Column="3" Text="Маршрут" Style="{StaticResource Caption}"
                                   ToolTip="Каким путём шёл замер" />
                        <TextBlock Grid.Column="4" Text="Сеть" Style="{StaticResource Caption}"
                                   ToolTip="Чья сеть у адреса — по спискам адресов, без запросов на сторону" />
                        <TextBlock Grid.Column="5" Text="Почему" Style="{StaticResource Caption}" />
                    </Grid>

                    <ListBox x:Name="Rows" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource CheckItem}"
                             SelectionChanged="OnRowSelected"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True" Focusable="False">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="52">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="150" />
                                        <ColumnDefinition Width="{DynamicResource StatusColumn}" />
                                        <ColumnDefinition Width="{DynamicResource LatencyColumn}" />
                                        <ColumnDefinition Width="{DynamicResource RouteColumn}" />
                                        <ColumnDefinition Width="{DynamicResource NetColumn}" />
                                        <ColumnDefinition Width="{DynamicResource WhyColumn}" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SiteMark}"
                                                          Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Host}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="9" Height="9" Fill="{Binding StatusInk}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusWordInk}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding Latency}" Style="{StaticResource Mono}"
                                               Foreground="{Binding LatencyInk}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                ToolTip="{Binding RouteTip}" Background="Transparent">
                                        <TextBlock Text="{Binding RouteGlyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   Foreground="{Binding RouteInk}" Margin="0,1,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Route}" Foreground="{Binding RouteInk}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="4" Text="{Binding Network}" Foreground="{DynamicResource Muted}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Column="5" Text="{Binding Brief}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Verdict}" />

                                    <Button Grid.Column="6" Style="{StaticResource IconGhost}" Content="&#xE712;"
                                            FontSize="13" Padding="6,5" MinWidth="30" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Click="OnRowMenu" ToolTip="Что сделать с этим именем" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyHint" Grid.Row="1" Style="{StaticResource Caption}" Margin="16,12,16,0"
                               TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </Grid>
            </gui:Card>

            <!--
                Панель справа: выбранное имя целиком, а пока ничего не выбрано —
                итог прогона, почерки поломок и советы.
            -->
            <gui:Card x:Name="PanelCard" Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer x:Name="PanelScroll" VerticalScrollBarVisibility="Auto" Padding="18,16">
                    <Grid>
                        <StackPanel x:Name="SummaryPane">
                            <TextBlock Text="Итог" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock x:Name="SummaryHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />

                            <ItemsControl x:Name="Sections" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{Binding Color}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Body}" Style="{StaticResource Caption}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel x:Name="DetailPane" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SiteMark}"
                                                  Margin="0,0,12,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Host}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource IconGhost}" Content="&#xE711;" FontSize="11"
                                        Padding="7,6" MinWidth="30" VerticalAlignment="Center" Click="OnPanelClose"
                                        ToolTip="Закрыть — к итогу проверки" />
                            </Grid>

                            <Border Margin="0,14,0,0" CornerRadius="10" Padding="12,9" BorderThickness="1.5"
                                    Background="{Binding StatusTint}" BorderBrush="{Binding StatusInk}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="{Binding StatusInk}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" Foreground="{Binding StatusWordInk}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!--
                                Что выяснилось и что делать — на подложке (владелец 27.10:
                                «тексту можно сделать какую-то подложку»). Лечение — своей
                                строкой: в конце длинного абзаца с цитатой сайта его не видели.
                                Секция пресета ушла в «Подробности»: жёлтой строкой здесь
                                она читалась как беда, а это справка.
                            -->
                            <Border Margin="0,10,0,0" CornerRadius="10" Padding="14,12" Background="{DynamicResource Raised}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Explain}" TextWrapping="Wrap" LineHeight="20" />
                                    <Grid Margin="0,10,0,0" Visibility="{Binding RemedyShown}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Что делать:" FontWeight="SemiBold" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Remedy}" TextWrapping="Wrap" LineHeight="20" />
                                    </Grid>
                                    <TextBlock Text="{Binding Warning}" Visibility="{Binding WarningShown}"
                                               Foreground="{DynamicResource Warn}" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <!--
                                Две кнопки в одну строку, поровну. «Перепроверить», а не
                                «Проверить ещё раз»: с ним вторая кнопка не помещалась
                                и уходила на свою строку (владелец 27.10).
                            -->
                            <UniformGrid Columns="{Binding ActionColumns}" Margin="-4,8,-4,0">
                                <Button x:Name="FixButton" Style="{StaticResource Primary}" Content="Подобрать маршрут"
                                        Click="OnFix" Margin="4" Padding="10,9" Visibility="{Binding ActionShown}"
                                        ToolTip="Проверить имя всеми путями и записать первый открывший — как «Сайт не открывается?»" />
                                <Button x:Name="RecheckButton" Style="{StaticResource Ghost}" Click="OnRecheck" Margin="4" Padding="10,9"
                                        ToolTip="Проверить это имя ещё раз">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Margin="0,1,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Перепроверить" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>

                            <!-- Ход и итог подбора маршрута. -->
                            <StackPanel Visibility="{Binding FixShown}" Margin="0,8,0,0">
                                <ItemsControl ItemsSource="{Binding FixLines}" ItemTemplate="{StaticResource DotLine}" />
                                <TextBlock Text="{Binding FixSummary}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{Binding FixInk}" />
                                <Button Style="{StaticResource Ghost}" Content="Показать в «Маршрутах»" Click="OnReveal"
                                        HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding RevealShown}" />
                            </StackPanel>

                            <!-- Стадии — плитками по две: столбиком они занимали полпанели. -->
                            <TextBlock Text="Стадии" Style="{StaticResource PanelHead}" />
                            <ItemsControl ItemsSource="{Binding Stages}" Margin="-4,0,-4,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="4" CornerRadius="10" Padding="12,8" Background="{DynamicResource Raised}"
                                                ToolTip="{Binding Value}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding Ink}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Value}" Style="{StaticResource Caption}" Margin="16,3,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Подробности — таблицей: подпись слева, значение справа, строки через черту. -->
                            <TextBlock Text="Подробности" Style="{StaticResource PanelHead}" />
                            <Border CornerRadius="10" BorderBrush="{DynamicResource Border}" BorderThickness="1.5" Padding="12,2">
                                <ItemsControl x:Name="Details">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Line" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="88" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <!-- У первой строки черты сверху нет: её даёт рамка таблицы. -->
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                    <Setter TargetName="Line" Property="BorderThickness" Value="0" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!--
                                Тот же замер другим путём (владелец 27.10): через VPN —
                                служебным входом движка; «Десинк» и «Напрямую» — мимо
                                туннеля, через Wi-Fi, по настоящему адресу; «Напрямую» —
                                ещё и мимо winws2, с портов пробы.
                            -->
                            <TextBlock Text="Проверить другим путём" Style="{StaticResource PanelHead}" />
                            <UniformGrid Columns="3" Margin="-4,0,-4,0">
                                <Button x:Name="PathVpn" Style="{StaticResource Ghost}" Content="Через VPN" Tag="vpn"
                                        Click="OnPath" Margin="4" Padding="8,9" />
                                <Button x:Name="PathDesync" Style="{StaticResource Ghost}" Content="Десинк" Tag="desync"
                                        Click="OnPath" Margin="4" Padding="8,9" />
                                <Button x:Name="PathDirect" Style="{StaticResource Ghost}" Content="Напрямую" Tag="direct"
                                        Click="OnPath" Margin="4" Padding="8,9" />
                            </UniformGrid>
                            <ItemsControl ItemsSource="{Binding Paths}" ItemTemplate="{StaticResource DotLine}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </gui:Card>
        </Grid>
    </Grid>
</UserControl>
