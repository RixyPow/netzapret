<UserControl x:Class="NetZapret.Gui.Views.CheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Backdrop}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,28">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Проверка блокировок" Style="{StaticResource Title}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Text="Что закрыто в этой сети и чем это лечится." />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!--
                            Что проверять. Полная проверка берёт по имени
                            с каждой части всего справочника и идёт минуты;
                            точечная — один сервис, но вчетверо глубже.
                            Когда чинят Discord, ответ нужен про Discord,
                            а не про сорок имён, из которых он одно.
                        -->
                        <ComboBox x:Name="Scope" Width="186" Margin="0,0,8,0"
                                  SelectionChanged="OnScope" />

                        <Button x:Name="StopButton" Style="{StaticResource Ghost}"
                                Content="Прервать" Click="OnStop" Margin="0,0,8,0" IsEnabled="False" />
                        <Button x:Name="RunButton" Style="{StaticResource Primary}"
                                Content="Проверить" Click="OnRun" />
                    </StackPanel>
                </Grid>

                <!--
                    Обстановка замера. Без неё отчёт нечем толковать: при
                    работающем обходе видно сеть уже вылеченной, а не такой,
                    какая она есть.
                -->
                <Border x:Name="SetupCard" Style="{StaticResource Card}" Margin="0,20,0,0"
                        BorderBrush="{StaticResource Warn}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="SetupTitle" FontWeight="SemiBold" Foreground="{StaticResource Warn}" />
                        <TextBlock x:Name="SetupBody" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="4,18,0,0" TextWrapping="Wrap"
                           Text="Проверка идёт минуты: по каждому имени четыре пробы, и каждая ждёт ответа." />

                <!-- Шапка таблицы. Повторяет консольную, чтобы отчёты читались одинаково. -->
                <Grid x:Name="Header" Margin="18,18,18,6" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="196" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Имя" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="1" Text="TCP" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="2" Text="1.2" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="3" Text="1.3" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="4" Text="HTTP" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="5" Text="ДАННЫЕ" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="6" Text="вердикт" Style="{StaticResource Caption}" />
                </Grid>

                <ItemsControl x:Name="Rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,4" Padding="18,9">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="196" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Host}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <Border Background="{StaticResource Raised}" CornerRadius="4"
                                                    Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding MarkShown}">
                                                <TextBlock Text="{Binding Mark}" FontSize="10"
                                                           Foreground="{StaticResource Muted}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding Tcp}" Style="{StaticResource Mono}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Tls12}" Style="{StaticResource Mono}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Tls13}" Style="{StaticResource Mono}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Http}" Style="{StaticResource Mono}" />
                                        <TextBlock Grid.Column="5" Text="{Binding Data}" Style="{StaticResource Mono}" />
                                        <TextBlock Grid.Column="6" Text="{Binding Verdict}"
                                                   Foreground="{Binding Color}" TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <TextBlock Text="{Binding Why}" Style="{StaticResource Caption}"
                                               Margin="0,6,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding WhyShown}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Итог по видам и советы. Появляются, когда есть что сказать. -->
                <ItemsControl x:Name="Sections" Margin="0,18,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10"
                                    BorderBrush="{Binding Color}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               Foreground="{Binding Color}" />
                                    <TextBlock Text="{Binding Body}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
