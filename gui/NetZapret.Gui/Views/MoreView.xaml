<UserControl x:Class="NetZapret.Gui.Views.MoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Backdrop}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,28">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="470" MaxWidth="1240" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="Ещё" Style="{StaticResource Title}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Обновление, антивирус, выключатели и папки программы. Режим и автозапуск переехали на «Главную», подписки — в «VPN»." />

                <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="4,16,0,0" TextWrapping="Wrap" />

                <TextBlock Text="Обновление" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Установлено" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="VersionValue" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock x:Name="UpdateValue" Style="{StaticResource Caption}"
                                           Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="UpdateButton" Style="{StaticResource Ghost}"
                                    Content="Проверить" Click="OnCheckUpdate" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="Только проверка. Установка — отдельное действие: подменять работающий обход молча нельзя, а обновление трогает движки, которые в этот момент несут весь трафик машины." />
                    </StackPanel>
                </Border>

                <TextBlock Text="Антивирус" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Папка программы в исключениях Defender" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="DefenderValue" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="DefenderButton" Style="{StaticResource Ghost}"
                                    Content="Добавить" Click="OnExclude" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="Исключается одна папка, а не отключается защита. Defender опознаёт в winws2.exe библиотеку WinDivert и удаляет файл — наблюдалось вживую. Снимать защиту со всей системы ради этого не нужно и нельзя: программа, глушащая антивирус, сама выглядит как вредонос." />
                    </StackPanel>
                </Border>

                <TextBlock Text="Прочее" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <ItemsControl x:Name="Flags">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Choice}" Tag="{Binding Key}" Click="OnFlag">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}"
                                                   Margin="0,5,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding State}" Style="{StaticResource Mono}"
                                               Foreground="{Binding Color}" VerticalAlignment="Center"
                                               MinWidth="72" TextAlignment="Right" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Обслуживание" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <Button Style="{StaticResource Choice}" Tag="settings" Click="OnMaintenance">
                    <StackPanel>
                        <TextBlock Text="Сбросить настройки" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Режим, пресет, сервер, DNS и выключатели — к заводским. Подписки остаются: их выдаёт поставщик, и потерять их значит остаться без VPN до тех пор, пока не найдётся письмо." />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Choice}" Tag="routes" Click="OnMaintenance">
                    <StackPanel>
                        <TextBlock Text="Забыть свои маршруты" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Убирает config\rules.user.yaml целиком: снова начинают действовать правила из поставки. Пины в hosts при этом остаются — они живут отдельно." />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Choice}" Tag="runtime" Click="OnMaintenance">
                    <StackPanel>
                        <TextBlock Text="Очистить рабочие файлы" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Журналы, собранные конфиги и кэш значков. Всё это собирается заново; конфиг туннеля соберётся при следующем запуске движков." />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Choice}" Tag="network" Click="OnMaintenance">
                    <StackPanel>
                        <TextBlock Text="Сбросить сетевой стек Windows" FontWeight="SemiBold"
                                   Foreground="{StaticResource Danger}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Крайняя мера: winsock и IP-стек к умолчанию. Понадобится перезагрузка, а до неё сеть останется в переходном состоянии — то есть хуже исходного. Помогает, когда после жёсткой остановки TUN остался в маршрутах." />
                    </StackPanel>
                </Button>

                <TextBlock Text="Папки" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <WrapPanel>
                            <Button Style="{StaticResource Ghost}" Content="Программа" Tag="."
                                    Click="OnOpen" Margin="0,0,8,8" />
                            <Button Style="{StaticResource Ghost}" Content="Настройки" Tag="config"
                                    Click="OnOpen" Margin="0,0,8,8" />
                            <Button Style="{StaticResource Ghost}" Content="Отчёты" Tag="reports"
                                    Click="OnOpen" Margin="0,0,8,8" />
                            <Button Style="{StaticResource Ghost}" Content="Журналы" Tag="runtime"
                                    Click="OnOpen" Margin="0,0,8,8" />
                            <Button Style="{StaticResource Ghost}" Content="Пресеты" Tag="presets"
                                    Click="OnOpen" Margin="0,0,8,8" />
                        </WrapPanel>

                        <TextBlock x:Name="RootValue" Style="{StaticResource Mono}"
                                   Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
