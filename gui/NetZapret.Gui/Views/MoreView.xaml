<UserControl x:Class="NetZapret.Gui.Views.MoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Chrome}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,28">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="470" MaxWidth="1240" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="Ещё" Style="{StaticResource Title}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Оформление, антивирус, выключатели и папки программы. Обновление — на «Главной». Режим и автозапуск переехали на «Главную», подписки — в «VPN»." />

                <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="4,16,0,0" TextWrapping="Wrap" />

                <TextBlock Text="Оформление" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <!--
                    Выбор темы плитками, как в Telegram (владелец, 23.09).
                    Плитка нарисована цветами самой темы; тема, не прошедшая
                    проверку контраста, видна приглушённой, а причина — в
                    подсказке и под плитками.
                -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Тема" FontWeight="SemiBold" />
                                <TextBlock x:Name="ThemeHint" Style="{StaticResource Caption}"
                                           Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Column="1" Style="{StaticResource Ghost}" VerticalAlignment="Top"
                                    Content="Папка тем" Click="OnThemesFolder" />
                        </Grid>

                        <ItemsControl x:Name="ThemeList" Margin="0,16,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Id}" Click="OnTheme" Margin="0,0,14,6" Cursor="Hand"
                                            ToolTip="{Binding Tip}" Opacity="{Binding Fade}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Button.Template>

                                        <StackPanel Width="112">
                                            <Border Height="84" CornerRadius="12" BorderThickness="2"
                                                    Background="{Binding Backdrop}" BorderBrush="{Binding Edge}">
                                                <Grid>
                                                    <Rectangle RadiusX="10" RadiusY="10" Fill="{Binding Image}" />
                                                    <Rectangle RadiusX="10" RadiusY="10" Fill="{Binding Backdrop}"
                                                               Opacity="{Binding Dim}" />

                                                    <Border Background="{Binding Surface}" CornerRadius="5"
                                                            Width="52" Height="14" Margin="10,10,0,0"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                    <Border Background="{Binding Fill}" CornerRadius="5"
                                                            Width="44" Height="14" Margin="0,30,10,0"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top" />

                                                    <Grid Width="18" Height="18" Margin="0,0,0,9"
                                                          HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                        <Ellipse Stroke="{Binding Ring}" StrokeThickness="1.5" />
                                                        <Ellipse Width="10" Height="10" Fill="{Binding Dot}"
                                                                 Visibility="{Binding DotShown}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="{Binding Name}" Foreground="{Binding NameColor}"
                                                       HorizontalAlignment="Center" Margin="0,7,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--
                            Настройки оформления (владелец, 23.09: «добавь
                            настройки оформления, по типу размытие вкл/выкл»).
                            Хранятся у человека, а не в теме; видны, когда
                            у выбранной темы есть картинка фона.
                        -->
                        <StackPanel x:Name="LookPanel" Margin="0,8,0,0">
                            <Button Style="{StaticResource Choice}" Tag="background" Click="OnLook" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Картинка фона" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Text="Выключенная — остаются цвета темы, фон сплошной." />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="BackgroundSwitch" Style="{StaticResource Switch}"
                                                  IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource Choice}" Tag="blur" Click="OnLook" Margin="0,0,0,7"
                                    x:Name="BlurRow">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Размытие под карточками и меню" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Text="Матовое стекло: под карточками фон размыт, между ними — чёткий. Плотность стекла подбирается так, чтобы текст на нём читался." />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="BlurSwitch" Style="{StaticResource Switch}"
                                                  IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <Border x:Name="DimRow" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1.5" CornerRadius="14" Padding="16,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Затемнение фона" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Text="Только темнее задуманного: затемнение и есть то, чем тема читается." />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="DimChoice" Width="190" VerticalAlignment="Center"
                                              SelectionChanged="OnDim">
                                        <ComboBoxItem Content="как задумал автор" />
                                        <ComboBoxItem Content="темнее" />
                                        <ComboBoxItem Content="намного темнее" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="LookNone" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="У этой темы нет картинки фона — размытию и затемнению нечего делать." />
                    </StackPanel>
                </Border>

                <!--
                    Шрифт и размер (владелец, 24.09). Общие для всех тем:
                    хранятся в настройках человека и перекрывают шрифты темы.
                    Шрифт данных — адреса и задержки — не меняется: цифры
                    в таблицах держатся столбиком только моноширинным.
                -->
                <TextBlock Text="Шрифт и размер" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Шрифт интерфейса" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="UiFontChoice" Width="260" SelectionChanged="OnFontChoice">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Шрифт заголовков" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="DisplayFontChoice" Width="260" SelectionChanged="OnFontChoice">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Размер" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Text="Всё окно целиком, как масштаб в Telegram: текст и карточки растут вместе, и ничего не вылезает за края." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="ScaleChoice" Width="260" VerticalAlignment="Center"
                                      SelectionChanged="OnFontChoice" />
                        </Grid>

                        <!-- Образец: видно сразу, без поиска по разделам. -->
                        <Border Background="{DynamicResource Raised}" CornerRadius="10" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="Маршруты" Style="{StaticResource Title}" />
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="Discord идёт через десинк, Instagram — через VPN." />
                                <TextBlock Style="{StaticResource Mono}" Margin="0,6,0,0"
                                           Text="104.18.32.47   42 мс   TLS 1.3" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="Первый запуск" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Мастер первого запуска" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap"
                                       Text="Подписка, пробный запуск и проверка сети — три шага, которые показываются один раз при первом открытии. Ничего из настроенного он не сбрасывает." />
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource Ghost}"
                                Content="Повторить" Click="OnRestartOnboarding" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock Text="Антивирус" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Папка программы в исключениях Defender" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="DefenderValue" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="DefenderButton" Style="{StaticResource Ghost}"
                                    Content="Добавить" Click="OnExclude" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="Исключается одна папка, а не отключается защита. Defender опознаёт в winws2.exe библиотеку WinDivert и удаляет файл — наблюдалось вживую. Снимать защиту со всей системы ради этого не нужно и нельзя: программа, глушащая антивирус, сама выглядит как вредонос." />
                    </StackPanel>
                </Border>

                <TextBlock Text="Прочее" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <ItemsControl x:Name="Flags">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Choice}" Tag="{Binding Key}" Click="OnFlag">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}"
                                                   Margin="0,5,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!--
                                        Тумблер — решение владельца 21.09,
                                        тем же движением, что в настройках
                                        туннеля. Слово рядом оставлено:
                                        положение кружка и оттенок теряются
                                        при беглом взгляде и исчезают вовсе
                                        у тех, кто плохо различает цвета.

                                        Сам тумблер не нажимается: нажимается
                                        вся строка, и он лишь показывает.
                                        Два обработчика на одно действие
                                        разошлись бы при первой же правке,
                                        а попасть в строку легче, чем
                                        в сорок точек тумблера.
                                    -->
                                    <TextBlock Grid.Column="1" Text="{Binding State}"
                                               Style="{StaticResource Caption}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />

                                    <ToggleButton Grid.Column="2" Style="{StaticResource Switch}"
                                                  IsChecked="{Binding On, Mode=OneWay}"
                                                  IsHitTestVisible="False" Focusable="False"
                                                  VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Папки" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <WrapPanel>
                            <Button Style="{StaticResource Ghost}" Content="Программа" Tag="."
                                    Click="OnOpen" Margin="0,0,8,8" />
                            <Button Style="{StaticResource Ghost}" Content="Настройки" Tag="config"
                                    Click="OnOpen" Margin="0,0,8,8" />
                            <Button Style="{StaticResource Ghost}" Content="Отчёты" Tag="reports"
                                    Click="OnOpen" Margin="0,0,8,8" />
                            <Button Style="{StaticResource Ghost}" Content="Журналы" Tag="runtime"
                                    Click="OnOpen" Margin="0,0,8,8" />
                            <Button Style="{StaticResource Ghost}" Content="Пресеты" Tag="presets"
                                    Click="OnOpen" Margin="0,0,8,8" />
                        </WrapPanel>

                        <TextBlock x:Name="RootValue" Style="{StaticResource Mono}"
                                   Foreground="{DynamicResource Muted}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--
                    Просьба из обсуждения #2. Список компонентов приходит
                    из About в библиотеке, а не пишется здесь: его сверяет
                    с THIRD-PARTY.md тест, и окно не должно знать больше.
                -->
                <TextBlock Text="О программе" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="AuthorValue" Style="{StaticResource Caption}" TextWrapping="Wrap" />

                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="RepositoryLink" Style="{StaticResource Ghost}" Content="Репозиторий"
                                    Click="OnLink" Margin="0,0,8,8" />
                            <Button x:Name="IssuesLink" Style="{StaticResource Ghost}" Content="Сообщить о проблеме"
                                    Click="OnLink" Margin="0,0,8,8" />
                            <Button x:Name="DiscussionsLink" Style="{StaticResource Ghost}" Content="Обсуждения"
                                    Click="OnLink" Margin="0,0,8,8" />
                            <Button x:Name="TelegramLink" Style="{StaticResource Ghost}" Content="Телеграм-канал"
                                    Click="OnLink" Margin="0,0,8,8" />
                            <Button x:Name="SupportLink" Style="{StaticResource Ghost}" Content="Поддержать"
                                    Click="OnLink" Margin="0,0,8,8" />
                        </WrapPanel>

                        <Border Height="1" Background="{DynamicResource Border}" Margin="0,8,0,14" />

                        <TextBlock Text="В составе" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,4" TextWrapping="Wrap"
                                   Text="Чужие движки едут в архиве как есть и запускаются отдельными процессами. Условия каждого — в docs/THIRD-PARTY.md в репозитории." />

                        <ItemsControl x:Name="Components">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap">
                                                <Run Text="{Binding Role, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding License, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <Button Grid.Column="1" Style="{StaticResource Ghost}" Content="Исходники"
                                                Tag="{Binding Source}" Click="OnLink" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!--
                    Обслуживание идёт последним намеренно: это разовые действия,
                    и три из четырёх необратимы. Соседство с переключателями,
                    которые нажимают мимоходом, им противопоказано.
                -->
                <TextBlock Text="Обслуживание" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Сбросить настройки до заводских" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap"
                                           Text="Режим, пресет, выбранный сервер, свои маршруты и рабочие файлы. Ссылка подписки остаётся: её выдаёт поставщик, и восстановить её программа не может." />
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="ResetSettingsButton" Style="{StaticResource Destructive}"
                                    Content="Сбросить" Click="OnResetSettings" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Border}" Margin="0,16,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Забыть маршруты" FontWeight="SemiBold" />
                                <TextBlock x:Name="RoutesValue" Style="{StaticResource Caption}" Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="ForgetRoutesButton" Style="{StaticResource Destructive}"
                                    Content="Забыть" Click="OnForgetRoutes" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Border}" Margin="0,16,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Очистить рабочие файлы" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap"
                                           Text="Журналы и конфиги от прошлых запусков из runtime. В собранных конфигах лежат пароли серверов открытым текстом — держать прошлогодние незачем. Действующий конфиг остаётся." />
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="CleanButton" Style="{StaticResource Ghost}"
                                    Content="Очистить" Click="OnClean" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Border}" Margin="0,16,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Сбросить сетевой стек Windows" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap"
                                           Text="winsock и TCP/IP. Лечение для сети, оставшейся в странном состоянии после опытов с адаптерами и DNS. Потребуется перезагрузка компьютера: без неё сеть остаётся в переходном состоянии, то есть хуже исходного." />
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="ResetNetworkButton" Style="{StaticResource Destructive}"
                                    Content="Сбросить" Click="OnResetNetwork" VerticalAlignment="Center" />
                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
