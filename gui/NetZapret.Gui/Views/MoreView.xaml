<UserControl x:Class="NetZapret.Gui.Views.MoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="clr-namespace:NetZapret.Gui"
             xmlns:views="clr-namespace:NetZapret.Gui.Views"
             Background="{DynamicResource Chrome}">

    <ScrollViewer Style="{StaticResource PageScroll}" Padding="32,28,32,28">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="470" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="Ещё" Style="{StaticResource Title}" />

                <!-- Строка ответа на действие; пустая не занимает места. -->
                <TextBlock x:Name="Status" Margin="4,16,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!--
                    Первым в разделе (владелец 26.09: «подними разбор неисправностей
                    выше») и отдельно от «Обслуживания»: там необратимое. Отчёт
                    для разбора отсюда переехал в «Диагностику» (владелец 03.10).
                -->
                <TextBlock Text="Разбор неисправностей" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <!--
                    «Сайт не открывается» — в «Ещё», пока в тестовом режиме
                    (владелец 29.09: «спрячем в ещё, пока она в тестовом режиме»).
                    С 27.10 — автоподбор: по симптому проверки блокировок пробует
                    напрямую, десинк (рецепты — пробным winws2 рядом с работающим)
                    и VPN и записывает первый сработавший. Решение целиком в
                    SiteFixer и RoutePlan.
                -->
                <gui:Card Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Сайт не открывается?" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="· проверка, тестовый режим" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                            <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                            Content="Проверит сайт, по тому, что закрыто, подберёт путь — напрямую, десинк с рецептом или VPN — и запишет первый сработавший. Идёт до минуты; движки должны быть запущены.&#x0a;&#x0a;«Напрямую» действует сразу, рецепт и VPN — после перезапуска движков." />
                        </StackPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" x:Name="FixSite" Margin="0,0,8,0" KeyDown="OnFixKey"
                                     gui:Hint.Text="https://aternos.org/go/ или просто aternos.org" />

                            <Button Grid.Column="1" x:Name="FixButton" Style="{StaticResource Ghost}"
                                    Content="Починить" Click="OnFix" MinWidth="110" />
                        </Grid>

                        <views:FixProgress x:Name="Fix" Margin="0,12,0,0" Action="OnFixReveal" />
                    </StackPanel>
                </gui:Card>

                <TextBlock Text="Первый запуск" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <gui:Card Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Мастер первого запуска" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="Знакомство, тема, режим работы и подписка на VPN. Ничего из настроенного не сбрасывает." />
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource Ghost}"
                                Content="Повторить" Click="OnRestartOnboarding" VerticalAlignment="Center" />
                    </Grid>
                </gui:Card>

                <TextBlock Text="Антивирус" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <gui:Card Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Папка программы в исключениях Defender" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Исключается одна папка, защита не выключается. Без исключения Defender может удалить winws2.exe: в нём библиотека WinDivert." />
                                </StackPanel>
                                <TextBlock x:Name="DefenderValue" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="DefenderButton" Style="{StaticResource Ghost}"
                                    Content="Добавить" Click="OnExclude" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </gui:Card>


                <TextBlock Text="Папки" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <gui:Card Style="{StaticResource Card}">
                    <StackPanel>
                        <WrapPanel>
                            <Button Style="{StaticResource Ghost}" Content="Программа" Tag="."
                                    Click="OnOpen" Margin="0,0,8,8" />
                            <Button Style="{StaticResource Ghost}" Content="Настройки" Tag="config"
                                    Click="OnOpen" Margin="0,0,8,8" />
                            <Button Style="{StaticResource Ghost}" Content="Отчёты" Tag="reports"
                                    Click="OnOpen" Margin="0,0,8,8" />
                            <Button Style="{StaticResource Ghost}" Content="Журналы" Tag="runtime"
                                    Click="OnOpen" Margin="0,0,8,8" />
                            <Button Style="{StaticResource Ghost}" Content="Пресеты" Tag="presets"
                                    Click="OnOpen" Margin="0,0,8,8" />
                        </WrapPanel>

                        <TextBlock x:Name="RootValue" Style="{StaticResource Mono}"
                                   Foreground="{DynamicResource Muted}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </gui:Card>

                <!--
                    Просьба из обсуждения #2. Список компонентов приходит
                    из About в библиотеке, а не пишется здесь: его сверяет
                    с THIRD-PARTY.md тест, и окно не должно знать больше.
                -->
                <TextBlock Text="О программе" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <gui:Card Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="AuthorValue" Style="{StaticResource Caption}" TextWrapping="Wrap" />

                        <!--
                            Скачивания с GitHub — единственное число о людях,
                            которое программа показывает. Своего счётчика нет
                            намеренно: запрос на свой сервер метил бы компьютер
                            для провайдера (DownloadStats).
                        -->
                        <TextBlock x:Name="DownloadsValue" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Margin="0,6,0,0" Visibility="Collapsed" />

                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="RepositoryLink" Style="{StaticResource Ghost}" Click="OnLink" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource LineShape}" Data="{StaticResource GitHubMark}" />
                                    <TextBlock Text="Репозиторий" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="IssuesLink" Style="{StaticResource Ghost}" Content="Сообщить о проблеме"
                                    Click="OnLink" Margin="0,0,8,8" />
                            <Button x:Name="DiscussionsLink" Style="{StaticResource Ghost}" Content="Обсуждения"
                                    Click="OnLink" Margin="0,0,8,8" />
                            <Button x:Name="TelegramLink" Style="{StaticResource Ghost}" Click="OnLink" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource LineShape}" Data="{StaticResource TelegramPlane}" />
                                    <TextBlock Text="Телеграм-канал" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SloykaLink" Style="{StaticResource Ghost}" Click="OnLink" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource LineShape}" Data="{StaticResource TelegramPlane}" />
                                    <TextBlock Text="Канал Слойки" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SupportLink" Style="{StaticResource Ghost}" Content="Поддержать"
                                    Click="OnLink" Margin="0,0,8,8" />
                        </WrapPanel>

                        <Border Height="1" Background="{DynamicResource Border}" Margin="0,8,0,14" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="В составе" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                            Content="Чужие движки едут как есть и работают отдельными процессами. Условия каждого — в docs/THIRD-PARTY.md в репозитории." />
                        </StackPanel>

                        <ItemsControl x:Name="Components">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap">
                                                <Run Text="{Binding Role, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding License, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!--
                                                Сайт — у кого он отдельно от исходников.
                                                Заведён ради Zapret GUI: владелец 30.09
                                                просил ссылку на автора, а его дом —
                                                wiki.zapret.moe, не только репозиторий.
                                            -->
                                            <Button Content="Сайт" Tag="{Binding Site}" Click="OnLink" Margin="0,0,8,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Site}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Style="{StaticResource Ghost}" Content="Исходники"
                                                    Tag="{Binding Source}" Click="OnLink" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </gui:Card>

                <!--
                    Обслуживание идёт последним намеренно: это разовые действия,
                    и три из четырёх необратимы. Соседство с переключателями,
                    которые нажимают мимоходом, им противопоказано.
                -->
                <TextBlock Text="Обслуживание" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <gui:Card Style="{StaticResource Card}">
                    <StackPanel>

                        <!--
                            «Искать обновления при запуске» — здесь (владелец, 05.10).
                            Утром того же дня переехала тумблером в заголовок карточки
                            «Обновление» на «Главной» и там выглядела странно: тумблер
                            теснил кнопку «Проверить».
                        -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Искать обновления при запуске" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Только искать: ставит обновление кнопка в карточке «Обновление» на «Главной»." />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Column="1" x:Name="UpdatesWord" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />

                            <ToggleButton Grid.Column="2" x:Name="UpdatesSwitch" Style="{StaticResource Switch}"
                                          Click="OnUpdatesSwitch" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Border}" Margin="0,16,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Сбросить настройки до заводских" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Режим, пресет, выбранный сервер, свои маршруты и рабочие файлы. Ссылка подписки остаётся. Прежние настройки лягут рядом с расширением .bak." />
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="ResetSettingsButton" Style="{StaticResource Destructive}"
                                    Content="Сбросить" Click="OnResetSettings" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Border}" Margin="0,16,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Забыть маршруты" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Снимает выборы «напрямую», «десинк» и «через VPN», сделанные руками: решать станут общие правила. Прежний файл ляжет рядом с расширением .bak." />
                                </StackPanel>
                                <TextBlock x:Name="RoutesValue" Style="{StaticResource Caption}" Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="ForgetRoutesButton" Style="{StaticResource Destructive}"
                                    Content="Забыть" Click="OnForgetRoutes" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Border}" Margin="0,16,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Очистить рабочие файлы" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Журналы и конфиги прошлых запусков из runtime: в конфигах пароли серверов открытым текстом. Действующий конфиг остаётся." />
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="CleanButton" Style="{StaticResource Ghost}"
                                    Content="Очистить" Click="OnClean" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Border}" Margin="0,16,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Сбросить сетевой стек Windows" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="winsock и TCP/IP — для сети, оставшейся в странном состоянии после опытов с адаптерами и DNS. Потребуется перезагрузка: без неё сеть хуже исходной." />
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="ResetNetworkButton" Style="{StaticResource Destructive}"
                                    Content="Сбросить" Click="OnResetNetwork" VerticalAlignment="Center" />
                        </Grid>

                    </StackPanel>
                </gui:Card>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
