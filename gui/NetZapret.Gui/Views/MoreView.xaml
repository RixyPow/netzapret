<UserControl x:Class="NetZapret.Gui.Views.MoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Backdrop}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,28">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="470" MaxWidth="1240" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="Ещё" Style="{StaticResource Title}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Обновление, антивирус, выключатели и папки программы. Режим и автозапуск переехали на «Главную», подписки — в «VPN»." />

                <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="4,16,0,0" TextWrapping="Wrap" />

                <TextBlock Text="Оформление" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Тема" FontWeight="SemiBold" />
                            <TextBlock x:Name="ThemeHint" Style="{StaticResource Caption}"
                                       Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="DarkButton" Style="{StaticResource Ghost}"
                                    Content="тёмная" MinWidth="92" Margin="0,0,8,0"
                                    Tag="dark" Click="OnTheme" />

                            <Button x:Name="LightButton" Style="{StaticResource Ghost}"
                                    Content="светлая" MinWidth="92"
                                    Tag="light" Click="OnTheme" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Обновление" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Установлено" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="VersionValue" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock x:Name="UpdateValue" Style="{StaticResource Caption}"
                                           Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="UpdateButton" Style="{StaticResource Ghost}"
                                        Content="Проверить" Click="OnCheckUpdate" Margin="0,0,8,0" />

                                <!--
                                    Появляется только когда есть что ставить:
                                    кнопка установки при последней версии
                                    предлагала бы действие без смысла.
                                -->
                                <Button x:Name="InstallButton" Style="{StaticResource Primary}"
                                        Content="Обновить" Click="OnInstallUpdate"
                                        Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="Обновление останавливает движки: с 0.5.0 супервизор — это та же программа, и заменить её файл, пока он запущен, Windows не даёт. Соединения на это время оборвутся. Настройки, свои маршруты и подставленные адреса переживают обновление." />
                    </StackPanel>
                </Border>

                <TextBlock Text="Антивирус" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Папка программы в исключениях Defender" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="DefenderValue" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="DefenderButton" Style="{StaticResource Ghost}"
                                    Content="Добавить" Click="OnExclude" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="Исключается одна папка, а не отключается защита. Defender опознаёт в winws2.exe библиотеку WinDivert и удаляет файл — наблюдалось вживую. Снимать защиту со всей системы ради этого не нужно и нельзя: программа, глушащая антивирус, сама выглядит как вредонос." />
                    </StackPanel>
                </Border>

                <TextBlock Text="Прочее" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <ItemsControl x:Name="Flags">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Choice}" Tag="{Binding Key}" Click="OnFlag">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}"
                                                   Margin="0,5,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding State}" Style="{StaticResource Mono}"
                                               Foreground="{Binding Color}" VerticalAlignment="Center"
                                               MinWidth="72" TextAlignment="Right" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Папки" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <WrapPanel>
                            <Button Style="{StaticResource Ghost}" Content="Программа" Tag="."
                                    Click="OnOpen" Margin="0,0,8,8" />
                            <Button Style="{StaticResource Ghost}" Content="Настройки" Tag="config"
                                    Click="OnOpen" Margin="0,0,8,8" />
                            <Button Style="{StaticResource Ghost}" Content="Отчёты" Tag="reports"
                                    Click="OnOpen" Margin="0,0,8,8" />
                            <Button Style="{StaticResource Ghost}" Content="Журналы" Tag="runtime"
                                    Click="OnOpen" Margin="0,0,8,8" />
                            <Button Style="{StaticResource Ghost}" Content="Пресеты" Tag="presets"
                                    Click="OnOpen" Margin="0,0,8,8" />
                        </WrapPanel>

                        <TextBlock x:Name="RootValue" Style="{StaticResource Mono}"
                                   Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--
                    Обслуживание идёт последним намеренно: это разовые действия,
                    и три из четырёх необратимы. Соседство с переключателями,
                    которые нажимают мимоходом, им противопоказано.
                -->
                <TextBlock Text="Обслуживание" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Сбросить настройки до заводских" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap"
                                           Text="Режим, пресет, выбранный сервер, свои маршруты и рабочие файлы. Ссылка подписки остаётся: её выдаёт поставщик, и восстановить её программа не может." />
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="ResetSettingsButton" Style="{StaticResource Destructive}"
                                    Content="Сбросить" Click="OnResetSettings" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource Border}" Margin="0,16,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Забыть маршруты" FontWeight="SemiBold" />
                                <TextBlock x:Name="RoutesValue" Style="{StaticResource Caption}" Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="ForgetRoutesButton" Style="{StaticResource Destructive}"
                                    Content="Забыть" Click="OnForgetRoutes" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource Border}" Margin="0,16,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Очистить рабочие файлы" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap"
                                           Text="Журналы и конфиги от прошлых запусков из runtime. В собранных конфигах лежат пароли серверов открытым текстом — держать прошлогодние незачем. Действующий конфиг остаётся." />
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="CleanButton" Style="{StaticResource Ghost}"
                                    Content="Очистить" Click="OnClean" VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource Border}" Margin="0,16,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Сбросить сетевой стек Windows" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap"
                                           Text="winsock и TCP/IP. Лечение для сети, оставшейся в странном состоянии после опытов с адаптерами и DNS. Потребуется перезагрузка компьютера: без неё сеть остаётся в переходном состоянии, то есть хуже исходного." />
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="ResetNetworkButton" Style="{StaticResource Destructive}"
                                    Content="Сбросить" Click="OnResetNetwork" VerticalAlignment="Center" />
                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
