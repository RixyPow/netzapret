<Window x:Class="NetZapret.Gui.Views.ProgramPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="clr-namespace:NetZapret.Gui"
        Title="Выберите программу" Width="680" Height="640" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Backdrop}">

    <!--
        Выбор программы из запущенных — как «Из списка процессов» в Happ
        (владелец, 01.10, снимки). Поиск по имени и по пути, значок и путь
        у каждой строки: имена повторяются (у Claude их по одному на версию),
        и различить их можно только по пути.
    -->
    <Grid LayoutTransform="{DynamicResource UiScaleTransform}" Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Выберите программу" Style="{StaticResource Title}" FontSize="20" />

        <TextBox Grid.Row="1" x:Name="Search" Margin="0,16,0,0" TextChanged="OnSearch"
                 gui:Hint.Text="Поиск по имени или пути…" />

        <TextBlock Grid.Row="2" x:Name="Status" Style="{StaticResource Caption}" Margin="4,8,0,8"
                   TextWrapping="Wrap" Text="Ищу запущенные программы…" />

        <ScrollViewer Grid.Row="3" Style="{StaticResource PageScroll}" CanContentScroll="True">
            <ItemsControl x:Name="List" VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.ScrollUnit="Pixel">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Choice}" Margin="0,0,0,6" Click="OnPick"
                                ToolTip="{Binding Path}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Raised}" CornerRadius="6"
                                            Visibility="{Binding LetterShown}">
                                        <TextBlock Text="{Binding Letter}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Muted}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <Image Source="{Binding Icon}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding IconShown}" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Margin="0,0,16,0"
                       Text="Правило — по имени файла: после обновления программы оно не теряется." />

            <Button Grid.Column="1" Style="{StaticResource Ghost}" Content="Отмена" IsCancel="True"
                    Click="OnCancel" />
        </Grid>
    </Grid>
</Window>
