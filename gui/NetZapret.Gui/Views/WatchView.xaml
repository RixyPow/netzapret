<UserControl x:Class="NetZapret.Gui.Views.WatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Chrome}">

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Кнопки — строкой под пояснением, а не справа от заголовка: со
            списком программ они заняли ~800 точек, и на окне владельца
            (10.10, масштаб 125 %) заголовок обрезался до «Наблюден»,
            а пояснение встало столбиком в два слова шириной.
        -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Наблюдение" Style="{StaticResource Title}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Соединения по мере их появления и правило, которое к каждому применилось бы. Ничего не перенаправляет и ни на что не влияет — только смотрит." />

            <!-- «Начать» первым: строка теперь слева, и главное действие — в начале. -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="PowerButton" Style="{StaticResource Primary}"
                        Content="Начать" Click="OnPower" MinWidth="110" Margin="0,0,8,0" />
                <Button x:Name="ProcessButton" Style="{StaticResource Ghost}" MinWidth="180"
                        Content="Все программы" Click="OnProcessMenu" Margin="0,0,8,0"
                        ToolTip="Показывать соединения одной программы" />
                <Button x:Name="FilterButton" Style="{StaticResource Ghost}"
                        Content="Только туннель и десинк" Click="OnFilter" Margin="0,0,8,0" />
                <Button x:Name="ClearButton" Style="{StaticResource Ghost}"
                        Content="Очистить" Click="OnClear" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="Status" Style="{StaticResource Caption}"
                   Margin="4,18,0,0" TextWrapping="Wrap" />

        <!--
            Заголовок таблицы отдельной строкой, а не первым элементом списка:
            список переписывается целиком при каждом обновлении, и заголовок
            уезжал бы вместе с ним.
        -->
        <Grid Grid.Row="2" Margin="16,16,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="ВРЕМЯ" Style="{StaticResource Caption}" />
            <TextBlock Grid.Column="1" Text="КУДА" Style="{StaticResource Caption}" />
            <TextBlock Grid.Column="2" Text="ПРОЦЕСС" Style="{StaticResource Caption}" />
            <TextBlock Grid.Column="3" Text="НАЗНАЧЕНИЕ" Style="{StaticResource Caption}" />
            <TextBlock Grid.Column="4" Text="ПРАВИЛО" Style="{StaticResource Caption}" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,10">
                <ItemsControl x:Name="Rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Time}" Style="{StaticResource Mono}"
                                           Foreground="{DynamicResource Muted}" />

                                <TextBlock Grid.Column="1" Text="{Binding Mode}" Style="{StaticResource Mono}"
                                           Foreground="{Binding Colour}" />

                                <TextBlock Grid.Column="2" Text="{Binding Process}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                                           Cursor="Hand" ToolTip="Только эта программа"
                                           MouseLeftButtonUp="OnProcessClick" />

                                <TextBlock Grid.Column="3" Text="{Binding Endpoint}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                                <TextBlock Grid.Column="4" Text="{Binding Rule}" Style="{StaticResource Caption}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
