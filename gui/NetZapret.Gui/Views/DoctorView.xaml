<UserControl x:Class="NetZapret.Gui.Views.DoctorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Backdrop}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,28">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="470" MaxWidth="1240" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Диагностика" Style="{StaticResource Title}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Всё, от чего зависит работа: права, движки, правила, конфиг, резолвер, супервизор." />
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="RunButton" Style="{StaticResource Primary}"
                            Content="Проверить" Click="OnRun" VerticalAlignment="Center" />
                </Grid>

                <!--
                    «Куда пойдёт имя» рядом с диагностикой, а не в маршрутах.
                    Вопрос задают, когда сервис уходит не туда, — то есть
                    в ту же минуту, когда открывают этот раздел.
                -->
                <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                    <StackPanel>
                        <TextBlock Text="Куда пойдёт соединение" FontWeight="SemiBold" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,0,8,0">
                                <TextBox x:Name="Host" KeyDown="OnHostKey" TextChanged="OnAskChanged" />

                                <TextBlock x:Name="HostHint" IsHitTestVisible="False"
                                           Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="13,0,0,0"
                                           Text="Например, web.whatsapp.com" />
                            </Grid>

                            <Button Grid.Column="1" Style="{StaticResource Ghost}"
                                    Content="Спросить" Click="OnAsk" />
                        </Grid>

                        <!--
                            Процесс, адрес и порт. Правило бывает привязано
                            не к имени: у Discord голос уходит по адресам,
                            имени в этих пакетах нет вовсе, и одним доменом
                            такой случай не проверить. Пустое поле означает
                            «не задано», а не «пусто» — ровно как у консоли.
                        -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,0,8,0">
                                <TextBox x:Name="Exe" KeyDown="OnHostKey" TextChanged="OnAskChanged" />
                                <TextBlock x:Name="ExeHint" IsHitTestVisible="False"
                                           Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="13,0,0,0"
                                           Text="Программа, discord.exe" />
                            </Grid>

                            <Grid Grid.Column="1" Margin="0,0,8,0">
                                <TextBox x:Name="Address" KeyDown="OnHostKey" TextChanged="OnAskChanged" />
                                <TextBlock x:Name="AddressHint" IsHitTestVisible="False"
                                           Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="13,0,0,0"
                                           Text="Адрес, 1.2.3.4" />
                            </Grid>

                            <Grid Grid.Column="2">
                                <TextBox x:Name="Port" KeyDown="OnHostKey" TextChanged="OnAskChanged" />
                                <TextBlock x:Name="PortHint" IsHitTestVisible="False"
                                           Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="13,0,0,0"
                                           Text="443" />
                            </Grid>
                        </Grid>

                        <Border x:Name="AnswerCard" Background="{DynamicResource Raised}" CornerRadius="8"
                                Padding="14,12" Margin="0,12,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="AnswerMode" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="AnswerWhy" Style="{StaticResource Caption}"
                                           Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="Отвечает тот же движок правил, что решает судьбу настоящих соединений, — не поиск по строкам. Поэтому ответ верен и там, где правила перекрывают друг друга, то есть ровно там, где вопрос и возникает." />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="4,18,0,0" TextWrapping="Wrap"
                           Text="Проверка читает файлы и спрашивает резолвер: несколько секунд." />

                <ItemsControl x:Name="Sections" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"
                                           Margin="4,0,0,8" />

                                <ItemsControl ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,5" Padding="14,11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!--
                                                        Сдвиг вниз обязателен:
                                                        выравнивание по верху
                                                        ставит точку вровень
                                                        с верхом строки, а не
                                                        с её серединой, и она
                                                        висит над текстом.
                                                        По центру нельзя —
                                                        у переносимого текста
                                                        точка уехала бы
                                                        в середину абзаца.
                                                    -->
                                                    <Ellipse Grid.Column="0" Width="8" Height="8"
                                                             Margin="2,6,14,0" VerticalAlignment="Top"
                                                             Fill="{Binding Color}" />

                                                    <TextBlock Grid.Column="1" Text="{Binding Text}"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
