<Window x:Class="NetZapret.Gui.Views.SubscriptionAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="clr-namespace:NetZapret.Gui"
        Title="Добавить подписку" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Backdrop}"
        ResizeMode="NoResize">

    <!--
        Отдельным окном, а не карточкой на вкладке (владелец, 01.10: «сделаем
        добавление подписки отдельным окном, где всё красиво скомпонуем, как
        в Happ»). Сверху — откуда взять, ниже — что это и как назвать, внизу —
        добавить. Ссылка и ключи — паролем: они равносильны паролю.
    -->
    <StackPanel LayoutTransform="{DynamicResource UiScaleTransform}" Margin="28,24,28,24">
        <TextBlock Text="Добавить подписку" Style="{StaticResource Title}" FontSize="20" />

        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource Ghost}" Click="OnFromClipboard"
                    ToolTip="Ключи, ссылка подписки или картинка с QR-кодом — например, снимок Win+Shift+S.">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE77F;" FontSize="15"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Из буфера" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Style="{StaticResource Ghost}" Click="OnFromFile"
                    ToolTip="Файл .conf WireGuard или AmneziaWG либо картинка с QR-кодом.">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8E5;" FontSize="15"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Из файла" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Ссылка, ключи, картинка с QR-кодом или файл .conf — поля ниже заполнятся сами." />

        <TextBlock Text="Тип" FontWeight="SemiBold" Margin="0,18,0,6" />
        <ComboBox x:Name="KindBox" SelectedIndex="0" SelectionChanged="OnKind">
            <ComboBoxItem Content="Подписка — ссылка от продавца" />
            <ComboBoxItem Content="Ключи — vless://, trojan://, wireguard:// и другие" />
        </ComboBox>

        <StackPanel x:Name="SubscriptionFields">
            <TextBlock Text="Имя подписки" FontWeight="SemiBold" Margin="0,16,0,6" />
            <TextBox x:Name="NameBox" gui:Hint.Text="Пусто — назовём сами" />

            <TextBlock Text="Ссылка подписки" FontWeight="SemiBold" Margin="0,16,0,6" />
            <PasswordBox x:Name="UrlBox" gui:Hint.Text="https://… либо happ://, clash://, sn://" />
        </StackPanel>

        <StackPanel x:Name="KeyFields" Visibility="Collapsed">
            <TextBlock Text="Ключи" FontWeight="SemiBold" Margin="0,16,0,6" />
            <PasswordBox x:Name="KeysBox" gui:Hint.Text="Один ключ или несколько подряд" />

            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Лягут в папку «Отдельные ключи»; имя каждому — из самого ключа." />
        </StackPanel>

        <Border Style="{StaticResource SettingsGroup}" Margin="0,18,0,0">
            <Grid Margin="16,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Сразу в работу" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Серверы сразу пойдут в общий автоподбор. Выключите — добавится на паузе, включите потом на вкладке." />
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="InPoolWord" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="0,0,10,0" Text="вкл." />

                <ToggleButton Grid.Column="2" x:Name="InPool" Style="{StaticResource Switch}" IsChecked="True"
                              Click="OnInPool" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,0" TextWrapping="Wrap"
                   Text="Ссылка и ключи равносильны паролю: после добавления они не показываются — ни здесь, ни на вкладке." />

        <TextBlock x:Name="Found" Style="{StaticResource Caption}" Margin="0,10,0,0"
                   TextWrapping="Wrap" Foreground="{DynamicResource Accent}" Visibility="Collapsed" />

        <TextBlock x:Name="Problem" Style="{StaticResource Caption}" Margin="0,10,0,0"
                   TextWrapping="Wrap" Foreground="{DynamicResource Danger}" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Style="{StaticResource Ghost}" Content="Отмена" IsCancel="True"
                    Margin="0,0,8,0" Click="OnCancel" />
            <Button Style="{StaticResource Primary}" Content="Добавить" IsDefault="True"
                    Click="OnAdd" />
        </StackPanel>
    </StackPanel>
</Window>
