<Window x:Class="NetZapret.Gui.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NetZapret.Gui.Views"
        Title="Журнал NetZapret"
        Width="1100" Height="740" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Backdrop}">
    <!--
        Владелец 07.10: «давай журнал сделаем отдельным окном и засунем
        в диагностику и чтоб он открывался по кнопке, а то боковую панель
        стоит разгрузить из-за появления новой вкладки». Внутри — тот же
        раздел журнала, что стоял в меню: его выключатель, выбор движка
        и «Только ошибки» не менялись. Отдельным окном его можно держать
        рядом с разделом, где что-то не работает.
    -->
    <Grid LayoutTransform="{DynamicResource UiScaleTransform}">
        <views:LogView x:Name="Log" />
    </Grid>
</Window>
