<UserControl x:Class="NetZapret.Gui.Views.TgProxyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Chrome}">

    <!--
        Владелец 07.10: «давай создадим отдельную вкладку tg proxy». Прокси —
        tg-ws-proxy-rs третьим движком (TgWsProxy, TgWsProxyService): Telegram
        Desktop без VPN, через WebSocket и домены за Cloudflare.
    -->
    <ScrollViewer Style="{StaticResource PageScroll}" Padding="32,28,32,28">
        <!--
            На всю ширину, как «Диагностика»: прежде MaxWidth 980, и на широком
            окне справа оставалась пустая треть (снимок владельца 07.10).
        -->
        <StackPanel>

            <TextBlock Text="TG Proxy" Style="{StaticResource Title}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Прокси для Telegram Desktop на этом компьютере: Telegram работает без VPN — его трафик идёт через WebSocket к Telegram и через домены за Cloudflare, в том же шифровании." />

            <!-- Выключатель и состояние. -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource IconTile}" Margin="0,0,14,0" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE724;" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Прокси Telegram" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                            <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                            Content="Поднимается вместе с движками и слушает только этот компьютер — 127.0.0.1. Секрет постоянный: Telegram подключается один раз. Если выключите прокси здесь, выключите его и в Telegram («Тип подключения» → «Без прокси»), иначе Telegram не подключится." />
                        </StackPanel>

                        <TextBlock x:Name="StateText" Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" x:Name="StateWord" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />

                    <ToggleButton Grid.Column="3" x:Name="Enabled" Style="{StaticResource Switch}"
                                  Click="OnEnabled" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Подключение Telegram. -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Подключить Telegram Desktop" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap"
                               Text="Кнопка откроет ссылку прокси в Telegram — он спросит, подключиться ли. Не открылось — скопируйте ссылку, отправьте её себе в «Избранное» и нажмите там." />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="ConnectButton" Style="{StaticResource Primary}" Click="OnConnect" Padding="18,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="13" Text="&#xE724;" Margin="0,0,8,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Подключить Telegram" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="CopyButton" Style="{StaticResource Ghost}" Content="Скопировать ссылку"
                                Click="OnCopy" Margin="8,0,0,0" Padding="14,8" />
                    </StackPanel>

                    <Border Style="{StaticResource RowLine}" Margin="0,16,0,12" />

                    <TextBlock Text="Вручную: Настройки → Продвинутые → Тип подключения → Прокси → MTProto"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Сервер" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="127.0.0.1" Style="{StaticResource Mono}" />

                        <TextBlock Grid.Row="1" Text="Порт" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PortText" Style="{StaticResource Mono}" />

                        <TextBlock Grid.Row="2" Text="Секрет" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SecretText" Style="{StaticResource Mono}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Когда он нужен. -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Когда он нужен" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap"
                               Text="В режиме «Десинк» и вообще без VPN: адреса Telegram закрыты, а через прокси он работает целиком, с фото и видео. В «Гибриде» и «Туннеле» Telegram и так идёт через VPN — прокси там не обязателен, но и не мешает." />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Только Telegram Desktop на этом компьютере — телефон через него не подключить. Прокси: tg-ws-proxy-rs (valnesfjord) — порт программы tg-ws-proxy (Flowseal), обе под MIT. Журнал — runtime\tg-ws-proxy.log." />
                </StackPanel>
            </Border>

            <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="4,14,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
