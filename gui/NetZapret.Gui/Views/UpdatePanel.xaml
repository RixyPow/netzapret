<UserControl x:Class="NetZapret.Gui.Views.UpdatePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Обновление — на «Главной» (владелец, 23.09). Прежде жило в «Ещё»,
        а карточка «Вышла новая версия» на «Главной» уводила туда ради
        одной кнопки. Установка по-прежнему одна — эта.

        Карточкой рядом с автозапуском, по макету 30.09. Пояснение о том,
        что обновление останавливает движки, — в подсказке у заголовка:
        оно нужно в момент решения, а не при каждом взгляде на окно.
    -->
    <Border Style="{StaticResource Card}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource IconTile}" Margin="0,0,14,0">
                <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE895;" />
            </Border>

            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Обновление" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                    Content="Обновление останавливает движки: с 0.5.0 супервизор — это та же программа, и заменить её файл, пока он запущен, Windows не даёт. Соединения на это время оборвутся. Настройки, свои маршруты и подставленные адреса переживают обновление." />
                    <!--
                        «Искать обновления при запуске» — переехало из «Ещё → Прочее»
                        (владелец, 05.10). В строке заголовка, как тумблер «Автозапуска»
                        рядом: строка ниже и так говорит, ищется ли при запуске,
                        а лишняя строка не дала бы «Главной» влезть без прокрутки.
                    -->
                    <ToggleButton x:Name="CheckOnStart" Style="{StaticResource Switch}" Margin="10,0,0,0"
                                  VerticalAlignment="Center" Click="OnCheckOnStart"
                                  ToolTip="Искать обновления при запуске программы. Только искать: установка — отдельной кнопкой и с отдельным согласием." />
                </StackPanel>

                <TextBlock x:Name="VersionValue" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                <TextBlock x:Name="UpdateValue" Style="{StaticResource Caption}"
                           Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!--
                Кнопки столбцом: карточка в полстраницы, и две кнопки в строку
                сжимали текст слева до слова на строку.
            -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <Button x:Name="UpdateButton" Style="{StaticResource Ghost}"
                        Content="Проверить" Click="OnCheckUpdate" />

                <!--
                    Появляется только когда есть что ставить:
                    кнопка установки при последней версии
                    предлагала бы действие без смысла.
                -->
                <Button x:Name="InstallButton" Style="{StaticResource Primary}"
                        Content="Обновить" Click="OnInstallUpdate" Margin="0,8,0,0"
                        Padding="18,9" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
