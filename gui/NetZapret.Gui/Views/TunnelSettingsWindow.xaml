<Window x:Class="NetZapret.Gui.Views.TunnelSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки туннеля"
        Width="620" SizeToContent="Height" MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Backdrop}"
        ResizeMode="NoResize">

    <!--
        Отдельным окном — решение владельца 21.09. Вкладка «VPN» разрослась:
        шесть карточек настроек оттесняли за нижний край список подписок,
        ради которого на неё и заходят. Разделено по тому, как часто
        открывают: на вкладке подписки, серверы и замеры, здесь — то,
        что задают однажды.

        Список в духе Happ: одна карточка на группу, строки с волосяными
        разделителями, справа состояние, пояснения под значком «i».
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,20,22,22">
        <StackPanel>
            <TextBlock Text="Настройки туннеля" Style="{StaticResource Title}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Всё здесь применяется при следующем запуске движков. Подписки и серверы остались на вкладке «VPN»." />

            <TextBlock Text="КУДА ИДЁТ ТРАФИК" Style="{StaticResource GroupHead}" Margin="4,22,0,7" />

            <Border Style="{StaticResource SettingsGroup}">
                <StackPanel>
                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Режим" VerticalAlignment="Center" />

                            <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                            Content="«Выборочно» — в туннель уходит только то, для чего он нужен; остальное идёт напрямую, и российские сервисы работают.&#x0a;&#x0a;«Только десинк» — туннель не поднимается вовсе, работает один winws2. Пригодится, когда подписка кончилась или серверы легли, а десинка на всё хватает: держать TUN ради ничего значит путать поиск неисправностей.&#x0a;&#x0a;«Всё через VPN» — в туннель уходит всё, кроме явных исключений на прямой проход. Их приходится держать: банки и госуслуги через зарубежный адрес отказывают.&#x0a;&#x0a;«Без исключений» — буквально всё, включая российские сервисы. Они при этом сломаются, и это осознанный выбор: режим для проверки, когда надо убедиться, что дело не в правилах." />
                        </StackPanel>

                        <ComboBox Grid.Column="1" x:Name="Mode" Width="188"
                                  VerticalAlignment="Center" SelectionChanged="OnMode">
                            <ComboBoxItem Content="выборочно" />
                            <ComboBoxItem Content="только десинк" />
                            <ComboBoxItem Content="всё через VPN" />
                            <ComboBoxItem Content="без исключений" />
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource RowLine}" />

                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Автоподбор только по зарубежным" VerticalAlignment="Center" />

                            <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                            Content="Подбор идёт по задержке и потому всегда сползает на ближайший сервер — свой же. Через него не работает ровно то, ради чего туннель обычно и нужен: адрес остаётся отечественным, и отказ приходит тот же, что и без туннеля." />
                        </StackPanel>

                        <TextBlock Grid.Column="1" x:Name="ForeignWord" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                        <ToggleButton Grid.Column="2" x:Name="Foreign" Style="{StaticResource Switch}"
                                      Click="OnForeign" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="КОГДА ТУННЕЛЬ НЕ РАБОТАЕТ" Style="{StaticResource GroupHead}" Margin="4,20,0,7" />

            <Border Style="{StaticResource SettingsGroup}">
                <StackPanel>
                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Обход туннеля" VerticalAlignment="Center" />

                                <ContentControl x:Name="BypassInfo" Style="{StaticResource Info}"
                                                Margin="2,0,0,0" />
                            </StackPanel>

                            <!--
                                Единственное пояснение, оставленное в строке,
                                и намеренно. Обход уводит трафик открыто,
                                и узнать об этом наведением мыши — не то же,
                                что прочитать, не ища.
                            -->
                            <TextBlock x:Name="BypassLine" Style="{StaticResource Caption}"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" x:Name="BypassWord" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                        <ToggleButton Grid.Column="2" x:Name="Bypass" Style="{StaticResource Switch}"
                                      Click="OnBypass" VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource RowLine}" />

                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Запасной выход WARP" VerticalAlignment="Center" />

                            <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                            Content="Бесплатный выход Cloudflare. Подмешивается к серверам действующей подписки, а не заменяет их: пока те живы, автоподбор берёт их — они быстрее; когда лягут, останется WARP.&#x0a;&#x0a;Учётную запись движок заводит себе сам: ни почты, ни оплаты, ни ключей.&#x0a;&#x0a;Выпускает трафик в ближайшей стране, и на российском подключении это Москва. От блокировок оператора спасает, от отказов по стране — нет." />
                        </StackPanel>

                        <TextBlock Grid.Column="1" x:Name="WarpWord" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                        <ToggleButton Grid.Column="2" x:Name="Warp" Style="{StaticResource Switch}"
                                      Click="OnWarp" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="4,16,0,0"
                       TextWrapping="Wrap" />

            <Button Style="{StaticResource Ghost}" Content="Закрыть" Click="OnClose"
                    HorizontalAlignment="Right" Margin="0,18,0,0" MinWidth="110" />
        </StackPanel>
    </ScrollViewer>
</Window>
