<Window x:Class="NetZapret.Gui.Views.TunnelSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="clr-namespace:NetZapret.Gui"
        Title="Настройки туннеля"
        Width="620" SizeToContent="Height" MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Backdrop}"
        ResizeMode="NoResize">

    <!--
        Отдельным окном — решение владельца 21.09. Вкладка «VPN» разрослась:
        шесть карточек настроек оттесняли за нижний край список подписок,
        ради которого на неё и заходят. Разделено по тому, как часто
        открывают: на вкладке подписки, серверы и замеры, здесь — то,
        что задают однажды.

        Список в духе Happ: одна карточка на группу, строки с волосяными
        разделителями, справа состояние, пояснения под значком «i».
    -->
    <!--
        «Закрыть» и строка состояния — под прокруткой, а не в ней. 01.10,
        со строкой «Прятать VPN» и сообщением после щелчка, окно упёрлось
        в MaxHeight при масштабе интерфейса владельца: появилась полоса,
        ширина карточек ушла на неё, а «Закрыть» обрезался краем окна.
        Полоса — поверх отступа (PageScroll), как на страницах: ширина
        не прыгает, когда она появляется.
    -->
    <Grid LayoutTransform="{DynamicResource UiScaleTransform}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" Style="{StaticResource PageScroll}" Padding="22,20,22,0">
        <StackPanel>
            <TextBlock Text="Настройки туннеля" Style="{StaticResource Title}" />

            <TextBlock Text="КУДА ИДЁТ ТРАФИК" Style="{StaticResource GroupHead}" Margin="4,22,0,7" />

            <gui:Card Style="{StaticResource SettingsGroup}">
                <StackPanel>
<!--
                        Два выключателя вместо списка режимов. Задумка
                        владельца 21.09: пять режимов пришли по одному,
                        каждый под свой случай, и объяснить разницу между
                        «всё через VPN» и «без исключений» удавалось только
                        примером. Выключатели отвечают на вопрос, который
                        человек и задаёт: что у меня сейчас работает.
                    -->
                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Игнорировать исключения" VerticalAlignment="Center" TextWrapping="Wrap" />

                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="Всё идёт через туннель: и «напрямую», и «десинк», и «через VPN». Снаружи остаётся только домашняя сеть — роутер, принтер, сетевой диск.&#x0a;&#x0a;Российские сервисы увидят зарубежный адрес: банки и госуслуги потребуют подтверждений, часть откажет. Десинк при этом не поднимается." />
                            </StackPanel>

                            <TextBlock x:Name="RussianLine" Style="{StaticResource Caption}"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" x:Name="RussianWord" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                        <ToggleButton Grid.Column="2" x:Name="Russian" Style="{StaticResource Switch}"
                                      Click="OnRussian" VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource RowLine}" />

                    <!--
                        Владелец 01.10 после разбора Zapret KVN. Напрямую,
                        а не блокировкой, как у KVN, — почему, см. VpnHiding.
                    -->
                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Прятать VPN от российских приложений" VerticalAlignment="Center"
                                           TextWrapping="Wrap" />

                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="Приложения Яндекса, VK, MAX и 2ГИС узнают свой адрес у ifconfig.me, api.ipify.org, проверок Яндекса и своих счётчиков. Эти двенадцать имён идут напрямую, и приложения видят домашний адрес, а не зарубежный.&#x0a;&#x0a;Поэтому и ifconfig.me покажет домашний адрес, хотя туннель работает. Не действует при «Игнорировать исключения»." />
                            </StackPanel>

                            <TextBlock x:Name="HideVpnLine" Style="{StaticResource Caption}"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" x:Name="HideVpnWord" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                        <ToggleButton Grid.Column="2" x:Name="HideVpn" Style="{StaticResource Switch}"
                                      Click="OnHideVpn" VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource RowLine}" />

                    <!--
                        Пулы серверов — отдельной настройкой (владелец 21.10:
                        «сделай поле пулов серверов отдельной настройкой
                        вкладки впн, под названием включить Selective Routing»).
                        Название — его, дословно.
                    -->
                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Включить Selective Routing" VerticalAlignment="Center" TextWrapping="Wrap" />

                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="Пулы — папки серверов из любых подписок: каждый маршрут «через VPN» идёт через свой пул (госуслуги — через «Россию», загрузки — через «Скоростной»). Пулы заводятся на вкладке VPN, пул маршрута выбирается в его пути в «Маршрутах».&#x0a;&#x0a;Выключено — маршруты «через VPN» идут через любые серверы, заведённые пулы сохраняются. При WARP пулы не действуют." />
                            </StackPanel>

                            <TextBlock x:Name="SelectiveLine" Style="{StaticResource Caption}"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" x:Name="SelectiveWord" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                        <ToggleButton Grid.Column="2" x:Name="Selective" Style="{StaticResource Switch}"
                                      Click="OnSelective" VerticalAlignment="Center" />
                    </Grid>

                </StackPanel>
            </gui:Card>

            <!--
                Что показывать на вкладке VPN (владелец 06.11): WARP и локальный
                прокси нужны не всем. Сами выключатели пути — в карточках
                на вкладке, здесь только показ; спрятанное выключается.
            -->
            <TextBlock Text="НА ВКЛАДКЕ VPN" Style="{StaticResource GroupHead}" Margin="4,20,0,7" />

            <gui:Card Style="{StaticResource SettingsGroup}">
                <StackPanel>
                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource IconTile}" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Image Source="{StaticResource CloudflareLogo}" Width="28"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Cloudflare WARP" VerticalAlignment="Center" />
                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="Бесплатный выход через сеть Cloudflare вместо подписок. Включено — карточка WARP на вкладке VPN, там он и включается. Спрятанная карточка выключает WARP." />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Column="2" x:Name="WarpCardWord" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                        <ToggleButton Grid.Column="3" x:Name="WarpCardSwitch" Style="{StaticResource Switch}"
                                      Click="OnWarpCard" VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource RowLine}" />

                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource IconTile}" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE71B;" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Локальный прокси" VerticalAlignment="Center" TextWrapping="Wrap" />

                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="SOCKS5 и HTTP на одном порту, только для этого компьютера (127.0.0.1). Системный прокси Windows не меняется: прокси работает в программах, где он прописан, — браузере, Telegram, лаунчере.&#x0a;&#x0a;Всё, что пришло в прокси, идёт через VPN мимо правил «Маршрутов»; домашняя сеть открывается как есть. Включённый здесь — карточка на вкладке VPN: там прокси включается и там его адрес." />
                            </StackPanel>
                            <TextBlock x:Name="LocalProxyLine" Style="{StaticResource Caption}"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" x:Name="LocalProxyWord" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                        <ToggleButton Grid.Column="3" x:Name="LocalProxySwitch" Style="{StaticResource Switch}"
                                      Click="OnLocalProxyCard" VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource RowLine}" />

                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Порт локального прокси" VerticalAlignment="Center" />
                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="Применяется при следующем запуске движков." />
                            </StackPanel>
                        </StackPanel>

                        <TextBox Grid.Column="1" x:Name="LocalProxyPortBox" Width="80" VerticalAlignment="Center"
                                 gui:Hint.Text="порт" KeyDown="OnLocalProxyPortKey" />
                        <Button Grid.Column="2" Style="{StaticResource Ghost}" Content="Сохранить"
                                Click="OnLocalProxyPort" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Пул — только при Selective Routing: без него пулов нет. -->
                    <StackPanel x:Name="LocalProxyPoolRow">
                        <Border Style="{StaticResource RowLine}" />

                        <Grid Margin="16,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Пул локального прокси" VerticalAlignment="Center" />

                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Через какие серверы идёт прокси. «Пул по умолчанию» — те же серверы, что выбраны на вкладке.&#x0a;&#x0a;Молчит весь пул — прокси не соединит: в пул по умолчанию и мимо туннеля он не уходит. Применяется при следующем запуске движков." />
                                </StackPanel>

                            </StackPanel>

                            <ComboBox Grid.Column="1" x:Name="LocalProxyPool" Width="200" SelectionChanged="OnLocalProxyPool" />
                        </Grid>
                    </StackPanel>

                    <Border Style="{StaticResource RowLine}" />

                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="VPN только через прокси" VerticalAlignment="Center" TextWrapping="Wrap" />

                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="В «Гибриде» через VPN идут только программы, где прописан локальный прокси; маршруты «через VPN» идут напрямую, мимо десинка, остальное — десинку. На DNS Windows движок отвечает, как и прежде.&#x0a;&#x0a;Действует, когда прокси включён на вкладке VPN; в «Туннеле» и при «Игнорировать исключения» — нет. Применяется при следующем запуске движков." />
                            </StackPanel>

                            <TextBlock x:Name="HybridProxyOnlyLine" Style="{StaticResource Caption}"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" x:Name="HybridProxyOnlyWord" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                        <ToggleButton Grid.Column="2" x:Name="HybridProxyOnlySwitch" Style="{StaticResource Switch}"
                                      Click="OnHybridProxyOnly" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </gui:Card>

            <TextBlock Text="КОГДА ТУННЕЛЬ НЕ РАБОТАЕТ" Style="{StaticResource GroupHead}" Margin="4,20,0,7" />

            <gui:Card Style="{StaticResource SettingsGroup}">
                <StackPanel>
                    <!--
                        Первой: замена сервера срабатывает раньше обхода
                        (две проверки сервера против трёх проверок трафика)
                        и оставляет трафик в туннеле. Владелец 30.09: «сделай
                        это как настройку в настройках VPN».
                    -->
                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Замена выбранному серверу" VerticalAlignment="Center" />

                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="Выбранный руками сервер не ответил дважды подряд — трафик временно идёт через первый ответивший сервер автоподбора, возможно, в другой стране. Выбранный возвращается, когда ответит дважды подряд.&#x0a;&#x0a;Как быстро — решает «Проверять подключённый сервер»: при проверке каждые 30 с — до 40 секунд. При автоподборе замена ищется всегда." />
                            </StackPanel>

                            <TextBlock x:Name="ReplaceLine" Style="{StaticResource Caption}"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" x:Name="ReplaceWord" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                        <ToggleButton Grid.Column="2" x:Name="Replace" Style="{StaticResource Switch}"
                                      Click="OnReplace" VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource RowLine}" />

                    <!-- Пулы серверов (владелец 19.10, идеи №6): молчащий пул — уводить или ждать. -->
                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Молчащий пул — в пул по умолчанию" VerticalAlignment="Center" />

                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="Ни один сервер пула не ответил — его маршруты уходят на любые серверы и возвращаются, как только пул ответит.&#x0a;&#x0a;Выключено — маршруты пула не открываются, пока он молчит: так стоит, когда пул заведён ради страны и другой выход хуже, чем никакого." />
                            </StackPanel>

                            <TextBlock x:Name="DeadPoolLine" Style="{StaticResource Caption}"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" x:Name="DeadPoolWord" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                        <ToggleButton Grid.Column="2" x:Name="DeadPool" Style="{StaticResource Switch}"
                                      Click="OnDeadPool" VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource RowLine}" />

                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Обход туннеля" VerticalAlignment="Center" />

                                <ContentControl x:Name="BypassInfo" Style="{StaticResource Info}"
                                                Margin="2,0,0,0" />
                            </StackPanel>

                            <!--
                                Единственное пояснение, оставленное в строке,
                                и намеренно. Обход уводит трафик открыто,
                                и узнать об этом наведением мыши — не то же,
                                что прочитать, не ища.
                            -->
                            <TextBlock x:Name="BypassLine" Style="{StaticResource Caption}"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" x:Name="BypassWord" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                        <ToggleButton Grid.Column="2" x:Name="Bypass" Style="{StaticResource Switch}"
                                      Click="OnBypass" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </gui:Card>

            <!--
                Проверка серверов — как часто и как напористо. Владелец 28.09:
                «пусть каждый сам настраивает» — и «засунь это в настройки,
                зачем это прям на странице». Продавцы разные: Trust держит все
                страны на одном входе и закрывает его от частых проверок.
                Значение строки — в Tag: секунды, минуты или штуки.
            -->
            <!--
                Владелец 07.10: «я бы сделал её выключателем в «Настройках
                туннеля», выключенным по умолчанию» — «делай». Не выключатель,
                а выбор из трёх: у движка два способа резать приветствие,
                и дешёвый стоит пробовать первым (TlsFragment).
            -->
            <TextBlock Text="СОЕДИНЕНИЕ С СЕРВЕРОМ" Style="{StaticResource GroupHead}" Margin="4,20,0,7" />

            <gui:Card Style="{StaticResource SettingsGroup}">
                <StackPanel>
                <Grid Margin="16,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Фрагментация рукопожатия" VerticalAlignment="Center" />

                            <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                            Content="Режет приветствие TLS к VPN-серверу, чтобы оператор не узнал сервер по имени в нём. Включайте, когда серверы перестали подключаться, а подписка и ключи те же: на работающих она только замедляет подключение.&#x0a;&#x0a;«Записями TLS» — дешевле, пробовать первым; «пакетами TCP» — сильнее, но каждое соединение медленнее. Действует на VLESS, VMess, Trojan и AnyTLS с TLS, с REALITY не проверялась. Применяется при следующем запуске движков." />
                        </StackPanel>

                    </StackPanel>

                    <ComboBox Grid.Column="1" x:Name="FragmentChoice" Width="180" SelectionChanged="OnFragment">
                        <ComboBoxItem Content="выключена" Tag="Off" />
                        <ComboBoxItem Content="записями TLS" Tag="Records" />
                        <ComboBoxItem Content="пакетами TCP" Tag="Packets" />
                    </ComboBox>
                </Grid>

                <Border Style="{StaticResource RowLine}" />

                <!--
                    Память подставных адресов (20.10). Имена «через VPN» получают
                    от движка подставные адреса 198.18.x с TTL 600 с, а при
                    перезапуске движок раздаёт их заново: github.com был
                    198.18.0.7, стал 198.18.0.5, на старый — отказ. Кэш Windows
                    надзор сбрасывает, а у браузера кэш свой. Выключатель —
                    по слову владельца: «потом сравним работу».
                -->
                <Grid Margin="16,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Помнить подставные адреса" VerticalAlignment="Center" />

                            <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                            Content="Именам «через VPN» движок отдаёт подставные адреса из 198.18.x. Без памяти после перезапуска движков они раздаются заново, а браузер ещё с минуту ходит по старым — часть сайтов через VPN не открывается.&#x0a;&#x0a;Таблица хранится в runtime\engine-cache.db. Выключите, если после перезапуска сайты через VPN стали работать хуже. Применяется при следующем запуске движков." />
                        </StackPanel>

                    </StackPanel>

                    <TextBlock Grid.Column="1" x:Name="FakeIpMemoryWord" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />

                    <ToggleButton Grid.Column="2" x:Name="FakeIpMemory" Style="{StaticResource Switch}"
                                  Click="OnFakeIpMemory" VerticalAlignment="Center" />
                </Grid>
                </StackPanel>
            </gui:Card>

            <TextBlock Text="ПРОВЕРКА СЕРВЕРОВ" Style="{StaticResource GroupHead}" Margin="4,20,0,7" />

            <gui:Card Style="{StaticResource SettingsGroup}">
                <StackPanel>
                    <!--
                        Переехало из «Ещё → Прочее» (владелец, 05.10): проверка
                        прохода — про то, жив ли туннель, ей место здесь.
                    -->
                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Проверять проход трафика" VerticalAlignment="Center" />

                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="Не только открытость порта, но и то, что через туннель что-то проходит. Без неё молчащий сервер выглядит живым: «Главная» пишет «Работает», а обход при мёртвом туннеле не включается." />
                            </StackPanel>

                        </StackPanel>

                        <TextBlock Grid.Column="1" x:Name="VerifyWord" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                        <ToggleButton Grid.Column="2" x:Name="Verify" Style="{StaticResource Switch}"
                                      Click="OnVerify" VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource RowLine}" />

                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Проверять подключённый сервер" VerticalAlignment="Center" />

                            <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                            Content="Одно соединение через сервер, через который идёт трафик. Не ответил дважды подряд — серверы автоподбора проверяются строго по одному, начиная с быстрейших по прошлым замерам, и ставится первый ответивший." />
                        </StackPanel>

                        <ComboBox Grid.Column="1" x:Name="ExitCheckChoice" Width="180" SelectionChanged="OnCheckSetting">
                            <ComboBoxItem Content="не проверять" Tag="0" />
                            <ComboBoxItem Content="каждые 15 с" Tag="15" />
                            <ComboBoxItem Content="каждые 30 с" Tag="30" />
                            <ComboBoxItem Content="каждую минуту" Tag="60" />
                            <ComboBoxItem Content="каждые 2 минуты" Tag="120" />
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource RowLine}" />

                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Общий замер всех серверов" VerticalAlignment="Center" />

                            <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                            Content="Движок перемеряет всех участников автоподбора разом, чтобы знать, кто быстрее. Чем реже — тем меньше нагрузки на продавцов, но тем дольше автоподбор не заметит, что появился сервер быстрее." />
                        </StackPanel>

                        <ComboBox Grid.Column="1" x:Name="FullCheckChoice" Width="180" SelectionChanged="OnCheckSetting">
                            <ComboBoxItem Content="каждую минуту" Tag="1" />
                            <ComboBoxItem Content="каждые 5 минут" Tag="5" />
                            <ComboBoxItem Content="каждые 15 минут" Tag="15" />
                            <ComboBoxItem Content="каждые 30 минут" Tag="30" />
                            <ComboBoxItem Content="раз в час" Tag="60" />
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource RowLine}" />

                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Серверов с одного входа" VerticalAlignment="Center" />

                            <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                            Content="У части продавцов много стран сидят на одном адресе — у Trust все. Автоподбор берёт с такого входа только быстрейших, чтобы не бить по нему пачкой проверок. Остальные страны по-прежнему выбираются руками в списке." />
                        </StackPanel>

                        <ComboBox Grid.Column="1" x:Name="PerEntryChoice" Width="180" SelectionChanged="OnCheckSetting">
                            <ComboBoxItem Content="один" Tag="1" />
                            <ComboBoxItem Content="два" Tag="2" />
                            <ComboBoxItem Content="три" Tag="3" />
                            <ComboBoxItem Content="все" Tag="0" />
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource RowLine}" />

                    <!--
                        Настройки пинга — по образцу Happ (владелец 07.10, «делай»):
                        адрес проверки, один на всех — автоподбор движка, сторож,
                        «Замерить все» и пробник (Ping). «Лучший из двух» был здесь
                        и убран в тот же день — почему, в Ping.
                    -->
                    <StackPanel Margin="16,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Адрес проверки" VerticalAlignment="Center" />

                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="Куда идёт запрос через сервер при каждом замере. Нужен адрес, быстро отдающий пустой ответ: меряется сервер, а не сайт. Свой — если Cloudflare и Google через ваши серверы не отвечают.&#x0a;&#x0a;Автоподбор и сторож возьмут его при следующем запуске движков, «Замерить все» — сразу." />
                            </StackPanel>

                            <ComboBox Grid.Column="1" x:Name="PingChoice" Width="180" SelectionChanged="OnPingChoice">
                                <ComboBoxItem Content="Cloudflare" Tag="cloudflare" />
                                <ComboBoxItem Content="Google" Tag="google" />
                                <ComboBoxItem Content="свой адрес" Tag="own" />
                            </ComboBox>
                        </Grid>

                        <Grid x:Name="PingOwnRow" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="PingOwn" gui:Hint.Text="http://адрес/generate_204" KeyDown="OnPingOwnKey" />
                            <Button Grid.Column="1" Style="{StaticResource Ghost}" Content="Сохранить"
                                    Click="OnPingOwn" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <Border Style="{StaticResource RowLine}" />

                    <!--
                        Владелец 07.10: «какой потолок проверки неработающего сервера?
                        давай в настройки добавим возможность выбирать» (PingTimeoutSeconds).
                    -->
                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Ждать ответа сервера" VerticalAlignment="Center" />

                            <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                            Content="Не ответил за это время — «не отвечает». Касается «Замерить все», теста пинга и замера при запуске: меньше — быстрее, но далёкий медленный сервер может попасть в неработающие.&#x0a;&#x0a;Сторожа подключённого сервера не касается: он ждёт 3 с." />
                        </StackPanel>

                        <ComboBox Grid.Column="1" x:Name="PingTimeoutChoice" Width="180" SelectionChanged="OnCheckSetting">
                            <ComboBoxItem Content="2 с" Tag="2" />
                            <ComboBoxItem Content="3 с" Tag="3" />
                            <ComboBoxItem Content="5 с" Tag="5" />
                            <ComboBoxItem Content="10 с" Tag="10" />
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource RowLine}" />

                    <!--
                        Владелец 07.10: «добавь возможность включить это в настройках
                        впн» — «Замерить все» само при запуске (MeasureOnStart,
                        StartupSweep). Выключено по умолчанию.
                    -->
                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Замерять все серверы при запуске" VerticalAlignment="Center" />

                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="То же, что «Замерить все» на вкладке VPN, но само — через минуту после запуска программы, когда движки поднялись. Подписки, выключенные из работы, — только кнопкой. Результат — в списке серверов и в журнале." />
                            </StackPanel>

                        </StackPanel>

                        <TextBlock Grid.Column="1" x:Name="MeasureOnStartWord" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                        <ToggleButton Grid.Column="2" x:Name="MeasureOnStart" Style="{StaticResource Switch}"
                                      Click="OnMeasureOnStart" VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource RowLine}" />

                    <!--
                        PR №27 (SuzuyaJ74, 15.10): живых серверов не нашлось — перечитать
                        подписку (NoLiveSubscriptionRefresh). Выключено по умолчанию.
                    -->
                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Перечитывать подписку, когда живых серверов нет" VerticalAlignment="Center" />

                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="Проверка выхода не нашла ни одного живого сервера — подписка перечитывается: поставщик мог сменить адреса или ключи. Не чаще раза в 30 минут. Сменился список — программа предложит перезапустить движки." />
                            </StackPanel>

                        </StackPanel>

                        <TextBlock Grid.Column="1" x:Name="RefreshNoLiveWord" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                        <ToggleButton Grid.Column="2" x:Name="RefreshNoLive" Style="{StaticResource Switch}"
                                      Click="OnRefreshNoLive" VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource RowLine}" />

                    <!--
                        Владелец 07.10: «добавь возможность очистить память работы
                        серверов (то что показывает через раз и т.д.), а так же
                        настраиваемое автоочищение … с умолчанием раз в неделю»
                        (ServerMemory, ServerMemoryClock).
                    -->
                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Память замеров" VerticalAlignment="Center" />

                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="Задержки серверов и исходы последних десяти проверок: по ним сервер становится «нестабильным» (жёлтым) и встаёт в автоподборе после стабильных, а не ответивший трижды подряд — «мёртвым» и уходит из него.&#x0a;&#x0a;«Очистить» стирает всё разом: задержки появятся со следующим замером, в автоподбор серверы вернутся при следующем запуске движков." />
                            </StackPanel>

                            <TextBlock x:Name="MemoryLine" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource Ghost}" Content="Очистить"
                                Click="OnClearMemory" VerticalAlignment="Center" MinWidth="110" />
                    </Grid>

                    <Border Style="{StaticResource RowLine}" />

                    <Grid Margin="16,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Забывать проверки старше" VerticalAlignment="Center" />

                            <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                            Content="Проверки старше срока забываются по одной, свежие остаются: давние промахи перестают держать сервер «нестабильным» или «мёртвым». Срок проверяется при запуске программы и раз в час." />
                        </StackPanel>

                        <ComboBox Grid.Column="1" x:Name="MemoryChoice" Width="180" SelectionChanged="OnCheckSetting">
                            <ComboBoxItem Content="суток" Tag="1" />
                            <ComboBoxItem Content="недели" Tag="7" />
                            <ComboBoxItem Content="месяца" Tag="30" />
                            <ComboBoxItem Content="не забывать" Tag="0" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </gui:Card>

        </StackPanel>
    </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="22,12,22,20">
            <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="4,0,0,0"
                       TextWrapping="Wrap" />

            <Button Style="{StaticResource Ghost}" Content="Закрыть" Click="OnClose"
                    HorizontalAlignment="Right" Margin="0,12,0,0" MinWidth="110" />
        </StackPanel>
    </Grid>
</Window>
