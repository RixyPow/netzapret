<Window x:Class="NetZapret.Gui.Views.ListNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="clr-namespace:NetZapret.Gui"
        Title="Своего списка нет" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Backdrop}"
        ResizeMode="NoResize">

    <!--
        Файл своего домена заводится только по просьбе (владелец, 26.09):
        одно имя в двух файлах — два правила, спорящих о нём. Поэтому окно
        спрашивает, даёт выбрать название и называет списки, с которыми
        домен уже будет спорить.
    -->
    <StackPanel LayoutTransform="{DynamicResource UiScaleTransform}" Margin="28,24,28,24">
        <TextBlock x:Name="Head" Style="{StaticResource Title}" FontSize="20" TextWrapping="Wrap" />

        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Можно завести файл: в него ляжет этот домен, и к нему можно дописать другие имена того же сайта. Маршрут, режим и рецепт останутся теми же." />

        <TextBlock Text="Название списка" FontWeight="SemiBold" Margin="0,18,0,6" />

        <TextBox x:Name="NameBox" KeyDown="OnKey" gui:Hint.Text="например, мой-сайт" />

        <TextBlock x:Name="Problem" Style="{StaticResource Caption}" Margin="0,8,0,0"
                   TextWrapping="Wrap" Foreground="{DynamicResource Danger}" Visibility="Collapsed" />

        <Border x:Name="ClashCard" Style="{StaticResource Card}" Margin="0,16,0,0"
                BorderBrush="{DynamicResource Warn}" Visibility="Collapsed">
            <TextBlock x:Name="ClashText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Style="{StaticResource Ghost}" Content="Отмена" IsCancel="True"
                    Margin="0,0,8,0" Click="OnCancel" />
            <Button Style="{StaticResource Primary}" Content="Создать" IsDefault="True"
                    Click="OnCreate" />
        </StackPanel>
    </StackPanel>
</Window>
