<UserControl x:Class="NetZapret.Gui.Views.VpnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="clr-namespace:NetZapret.Gui"
             xmlns:views="clr-namespace:NetZapret.Gui.Views"
             Background="{DynamicResource Chrome}"
             Focusable="True" FocusVisualStyle="{x:Null}"
             PreviewKeyDown="OnPreviewKeyDown">

    <!--
        Вся вкладка — один список, который рисует только видимые строки
        (владелец 12.10: подписка на 403 сервера вешала вкладку). Верх
        вкладки и подпись внизу — первым и последним его элементом
        (VpnView.PageItems), папки и серверы — плоско между ними, каждый
        своим шаблоном. Прежде страница была прокруткой со вложенными
        списками, и все карточки рисовались разом.
    -->
    <Grid>
        <ItemsControl x:Name="Page" Focusable="False"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer Style="{StaticResource PageScroll}" Padding="32,28,32,28"
                                  CanContentScroll="True" Focusable="False">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.Resources>
                <!-- Папка подписки. Свёрнутая, но со всеми цифрами в заголовке. -->
                <DataTemplate DataType="{x:Type views:SubRow}">
                    <Button Style="{StaticResource Choice}" BorderBrush="{Binding Edge}"
                            Margin="0,10,0,6" Opacity="{Binding Fade}" Click="OnFolder">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0" Style="{StaticResource Chevron}"
                                  Margin="5,0,6,0">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="{Binding ChevronAngle}" />
                                </Path.RenderTransform>
                            </Path>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <!--
                                    Сетка, а не стопка: в горизонтальной стопке
                                    ширина считается бесконечной, и обрезание
                                    длинного имени не срабатывает.
                                -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               FontWeight="SemiBold" FontSize="15"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                    <Border Grid.Column="1" CornerRadius="8" Padding="9,1" Margin="10,0,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                                            Visibility="{Binding ActiveShown}">
                                        <TextBlock Text="В работе" FontSize="12" Foreground="{DynamicResource Accent}" />
                                    </Border>
                                </Grid>

                                <!--
                                    Расход полоской, как в Happ (владелец 19.10): израсходовано
                                    из лимита, срок, «!» при слишком быстром темпе. Без лимита
                                    полоска пустая и пишет «/ ∞».
                                -->
                                <Grid Margin="0,7,0,0" Visibility="{Binding UsageShown}" ToolTip="{Binding UsageTip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Height="20">
                                        <Border CornerRadius="10" BorderThickness="1.5"
                                                BorderBrush="{DynamicResource Border}" Background="{DynamicResource Surface}" />

                                        <Grid Margin="1.5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding UsedStar}" />
                                                <ColumnDefinition Width="{Binding LeftStar}" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="9" Background="{Binding UsageFill}" Opacity="0.45" />
                                        </Grid>

                                        <TextBlock Text="{Binding UsageLabel}" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Grid.Column="1" Text="{Binding UsageExpires}" FontSize="12"
                                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" />

                                    <TextBlock Grid.Column="2" Text="&#xE7BA;" FontFamily="{DynamicResource IconFont}" FontSize="15"
                                               Foreground="{DynamicResource Warn}" VerticalAlignment="Center" Margin="10,0,0,0"
                                               Visibility="{Binding PaceShown}" />
                                </Grid>

                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                           Margin="0,5,0,0" TextWrapping="Wrap" />

                                <!-- Срок кончается — заметно, а не тем же серым (15.10, как в Happ). -->
                                <TextBlock Text="{Binding Warning}" Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource Warn}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding WarningShown}" />

                                <!-- Объявление поставщика из заголовка announce: его слова, не наши. -->
                                <TextBlock Text="{Binding Announce}" Margin="0,5,0,0" TextWrapping="Wrap"
                                           FontSize="13" Foreground="{DynamicResource Text}"
                                           Visibility="{Binding AnnounceShown}"
                                           ToolTip="Объявление поставщика подписки" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!--
                                    Выключатель «в работе» вместо «сделать действующей»
                                    (0.9.0, пул): подписок в работе может быть сколько
                                    угодно, их серверы идут в один автоподбор.
                                -->
                                <ToggleButton Style="{StaticResource Switch}" Margin="0,0,14,0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding Active, Mode=OneWay}"
                                              ToolTip="В работе: серверы этой подписки идут в пул движка"
                                              Tag="{Binding Name}" Click="OnActivate" />

                                <!--
                                    Значками, как в Happ (владелец, 28.09): обновить,
                                    тест пинга и меню со всем остальным. Подписи —
                                    во всплывающих подсказках.
                                -->
                                <!--
                                    Поддержка и страница подписки — если поставщик
                                    их назвал (support-url, profile-web-page-url).
                                -->
                                <Button Style="{StaticResource IconGhost}" Content="&#xE8F2;"
                                        Margin="0,0,6,0" ToolTip="{Binding SupportTip}"
                                        Visibility="{Binding SupportShown}"
                                        Tag="{Binding Name}" Click="OnSupport" />

                                <Button Style="{StaticResource IconGhost}" Content="&#xE8A7;"
                                        Margin="0,0,6,0" ToolTip="Страница подписки у поставщика: продлить, сменить тариф"
                                        Visibility="{Binding WebPageShown}"
                                        Tag="{Binding Name}" Click="OnWebPage" />

                                <Button Style="{StaticResource IconGhost}" Content="&#xE72C;"
                                        Margin="0,0,6,0" ToolTip="Обновить: перечитать подписку"
                                        Tag="{Binding Name}" Click="OnRefreshOne" />

                                <Button Style="{StaticResource IconGhost}" Content="&#xEC4A;"
                                        Margin="0,0,6,0" ToolTip="{Binding CheckLabel}"
                                        IsEnabled="{Binding CanCheck}"
                                        Tag="{Binding Name}" Click="OnCheckOne" />
                            </StackPanel>

                            <Button Grid.Column="3" Style="{StaticResource IconGhost}" Content="&#xE712;" VerticalAlignment="Center"
                                    ToolTip="Ещё: закрепить, скопировать ссылку, изменить, удалить"
                                    Tag="{Binding Name}" Click="OnMore" />
                        </Grid>
                    </Button>
                </DataTemplate>

                <!--
                    Папка пула (идеи №6): имя, сколько серверов, кто закреплён,
                    сколько маршрутов ведёт сюда. Сервер кладут сюда, бросив
                    его строку на папку.
                -->
                <DataTemplate DataType="{x:Type views:PoolRow}">
                    <Button Style="{StaticResource Choice}" BorderBrush="{Binding Edge}"
                            Margin="0,10,0,6" Opacity="{Binding Fade}" Click="OnPoolFolder"
                            AllowDrop="True" DragEnter="OnPoolDragOver" DragOver="OnPoolDragOver"
                            DragLeave="OnPoolDragLeave" Drop="OnPoolDrop">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0" Style="{StaticResource Chevron}" Margin="5,0,6,0">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="{Binding ChevronAngle}" />
                                </Path.RenderTransform>
                            </Path>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                    <Border Grid.Column="1" CornerRadius="8" Padding="9,1" Margin="10,0,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            BorderBrush="{DynamicResource Border}" BorderThickness="1.5">
                                        <TextBlock Text="{Binding Count}" FontSize="12" Foreground="{DynamicResource Muted}" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                           Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <!--
                                Автоподбор тумблером (владелец 20.10: «сделай автовыбор
                                тумблером для каждого пула»), как «в работе» у подписки.
                            -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="автоподбор" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <ToggleButton Style="{StaticResource Switch}" Margin="0,0,14,0" VerticalAlignment="Center"
                                              IsChecked="{Binding Auto, Mode=OneWay}" IsEnabled="{Binding CanSwitch}"
                                              ToolTip="Автоподбор внутри пула: берёт быстрейший живой сервер. Выключите — пул держится одного сервера: выбранного прежде или быстрейшего сейчас"
                                              ToolTipService.ShowOnDisabled="True"
                                              Click="OnPoolAuto" />
                                <Button Style="{StaticResource IconGhost}" Content="&#xE712;" VerticalAlignment="Center"
                                        ToolTip="Ещё: переименовать, удалить"
                                        Click="OnPoolMore" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </DataTemplate>

                <!--
                    Сервер (макет владельца 12.10): флаг, имя, «Сейчас» у выхода
                    движка, задержка крупно, полоски надёжности, плашка протокола
                    из самого сервера, адрес колонкой, «Выбрать» и «⋮». На узком
                    окне плашки и адреса нет — подпись уходит под имя.
                -->
                <DataTemplate DataType="{x:Type views:ServerRow}">
                    <gui:Card Style="{StaticResource Card}" Margin="20,0,0,6" Padding="14,9"
                            BorderBrush="{Binding Edge}" Opacity="{Binding Fade}"
                            PreviewMouseLeftButtonDown="OnServerPress" MouseMove="OnServerDrag">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Column="0" Width="9" Height="9" Margin="2,0,14,0"
                                     VerticalAlignment="Center" Fill="{Binding Color}" />

                            <!--
                                Флаг картинкой, а если такой нет — буквы кода.
                                Windows флаги стран не рисует вовсе: в Segoe UI
                                Emoji их нет, и пара региональных букв выходит
                                как «de», влипшее в название.
                            -->
                            <Grid Grid.Column="1" Width="38" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Border CornerRadius="4" ClipToBounds="True"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1.5"
                                        Visibility="{Binding FlagShown}">
                                    <Image Source="{Binding Flag}" Width="36" Height="25"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>

                                <Border Background="{DynamicResource Raised}"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1.5"
                                        CornerRadius="5" Padding="5,3" HorizontalAlignment="Center"
                                        Visibility="{Binding CountryShown}">
                                    <TextBlock Text="{Binding Country}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted}" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Через этот сервер трафик идёт прямо сейчас — по движку, не по настройке. -->
                                        <Border CornerRadius="8" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource AccentFill}" BorderThickness="1.5"
                                                Visibility="{Binding NowShown}"
                                                ToolTip="Через этот сервер трафик идёт сейчас">
                                            <TextBlock Text="Сейчас" FontSize="12" Foreground="{DynamicResource Text}" />
                                        </Border>

                                        <Border CornerRadius="8" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource Border}" BorderThickness="1.5"
                                                Visibility="{Binding ExcludedShown}"
                                                ToolTip="Автоподбор его не берёт; выбрать руками можно. Вернуть — в «⋯»">
                                            <TextBlock Text="вне подбора" FontSize="12" Foreground="{DynamicResource Muted}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding NarrowShown, RelativeSource={RelativeSource AncestorType=views:VpnView}}" />
                            </StackPanel>

                            <TextBlock Grid.Column="3" Text="{Binding Latency}" Width="104"
                                       FontSize="15" FontWeight="SemiBold" TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="0,0,16,0"
                                       Foreground="{Binding Color}" ToolTip="{Binding Latency}" />

                            <!--
                                Полоски — надёжность (доля ответов из последних
                                проверок), а не задержка: задержка уже цифрой рядом.
                            -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                        Width="74" Margin="0,0,14,0" Background="Transparent"
                                        ToolTip="{Binding ReliabilityTip}">
                                <Rectangle Width="5" Height="7" RadiusX="1.5" RadiusY="1.5" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="{Binding Bar1}" />
                                <Rectangle Width="5" Height="10" RadiusX="1.5" RadiusY="1.5" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="{Binding Bar2}" />
                                <Rectangle Width="5" Height="13" RadiusX="1.5" RadiusY="1.5" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="{Binding Bar3}" />
                                <Rectangle Width="5" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="0,0,3,0" VerticalAlignment="Bottom" Fill="{Binding Bar4}" />
                                <Rectangle Width="5" Height="19" RadiusX="1.5" RadiusY="1.5" Margin="0,0,7,0" VerticalAlignment="Bottom" Fill="{Binding Bar5}" />
                                <TextBlock Text="{Binding Reliability}" FontSize="11" VerticalAlignment="Bottom"
                                           Foreground="{DynamicResource Muted}" />
                            </StackPanel>

                            <!-- Протокол — из самого сервера: защита и транспорт. -->
                            <Grid Grid.Column="5" Width="132" Margin="0,0,14,0"
                                  Visibility="{Binding WideShown, RelativeSource={RelativeSource AncestorType=views:VpnView}}">
                                <Border CornerRadius="13" Padding="11,4" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1.5"
                                        Background="{DynamicResource Raised}" Visibility="{Binding ChipShown}">
                                    <TextBlock Text="{Binding Chip}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="6" Width="200" Margin="0,0,14,0" VerticalAlignment="Center"
                                        Visibility="{Binding WideShown, RelativeSource={RelativeSource AncestorType=views:VpnView}}">
                                <TextBlock Text="{Binding Address}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Sub}" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Grid Grid.Column="7" Width="108" Margin="0,0,8,0">
                                <Button Style="{StaticResource Primary}" Content="Выбран" Padding="14,7"
                                        IsHitTestVisible="False" Focusable="False"
                                        Visibility="{Binding ChosenShown}" />
                                <Button Style="{StaticResource Ghost}" Content="Выбрать" Padding="14,7"
                                        Visibility="{Binding ChooseShown}"
                                        Tag="{Binding Tag}" Click="OnChoose" />
                            </Grid>

                            <!--
                                Действия со строкой — кнопкой, а не правым щелчком,
                                о котором никто не знал (владелец 12.10).
                            -->
                            <Button Grid.Column="8" Style="{StaticResource IconGhost}" Content="&#xE712;"
                                    ToolTip="Ещё: автоподбор, замер, адрес" VerticalAlignment="Center"
                                    Tag="{Binding Tag}" Click="OnServerMenu" />
                        </Grid>
                    </gui:Card>
                </DataTemplate>
            </ItemsControl.Resources>
        </ItemsControl>

        <!--
            Верх вкладки и подпись внизу размечены здесь, а показываются
            первым и последним элементом списка выше — VpnView их туда
            переносит. Здесь же они только затем, чтобы им достались имена.
        -->
        <Grid x:Name="Holder" Visibility="Collapsed">
            <StackPanel x:Name="TopBlock">


                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="VPN" Style="{StaticResource Title}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Text="Подписки, их серверы и то, через что идёт трафик." />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RefreshButton" Style="{StaticResource Ghost}"
                                Content="Обновить" Click="OnRefresh" Margin="0,0,8,0" />
                        <!--
                            Настройки — отдельным окном. То, что задают
                            однажды, не должно занимать полосу над списком,
                            который смотрят каждый раз.
                        -->
                        <Button x:Name="SettingsButton" Style="{StaticResource Ghost}"
                                Content="Настройки" Click="OnSettings" Margin="0,0,8,0"
                                ToolTip="Режим, автоподбор по зарубежным, обход туннеля при мёртвых выходах, проверка серверов." />

                        <Button x:Name="MeasureButton" Style="{StaticResource Primary}"
                                Content="Замерить все" Click="OnMeasure" />
                    </StackPanel>
                </Grid>

                <!--
                    Первый ряд — по макету владельца 01.10: слева выход, через
                    который идёт трафик, с главными цифрами, справа — недавние
                    серверы. Прежде выход был одной строкой подписи, а цифры
                    приходилось собирать по списку.
                -->
                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="360" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="290" />
                    </Grid.ColumnDefinitions>

                    <gui:Card Grid.Column="0" Style="{StaticResource Card}" Padding="22,20">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" x:Name="CurrentFlag" Width="76" Height="54" CornerRadius="10"
                                        Margin="0,0,20,0" VerticalAlignment="Center"
                                        Background="{DynamicResource Raised}">
                                    <Grid>
                                        <TextBlock x:Name="CurrentCountry" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" FontSize="17" Foreground="{DynamicResource Muted}" />
                                        <!-- У WARP флага нет — облачко (владелец, 01.10). -->
                                        <TextBlock x:Name="CurrentCloud" Style="{StaticResource TileGlyph}" Text="&#xE753;"
                                                   FontSize="28" Foreground="#F38020" Visibility="Collapsed" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="CurrentCaption" Style="{StaticResource Caption}" />

                                    <!-- Сетка, а не стопка: в стопке обрезание длинного имени не срабатывает. -->
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" x:Name="CurrentName" FontSize="22" FontWeight="SemiBold"
                                                   MaxWidth="440" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                        <Border Grid.Column="1" x:Name="CurrentSourcePill" CornerRadius="7" Padding="8,2"
                                                Margin="12,0,0,0" BorderThickness="1.5" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource Accent}" Visibility="Collapsed">
                                            <TextBlock x:Name="CurrentSource" FontSize="12" Foreground="{DynamicResource Accent}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <Ellipse x:Name="CurrentDot" Width="8" Height="8" VerticalAlignment="Center" />
                                        <TextBlock x:Name="CurrentState" Margin="7,0,0,0" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" FontSize="13" />
                                    </StackPanel>

                                    <TextBlock x:Name="CurrentDetail" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,16,0,14" />

                            <!-- Цифры выхода: задержка, протокол, реализация, откуда он. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE916;" Margin="0,0,10,0" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="Задержка" />
                                        <TextBlock x:Name="StatLatency" Style="{StaticResource Mono}" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Accent}" Text="—" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE71B;" Margin="0,0,10,0" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="Протокол" />
                                        <TextBlock x:Name="StatProtocol" Margin="0,3,0,0" Text="—"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE943;" Margin="0,0,10,0" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="Реализация" />
                                        <TextBlock x:Name="StatKind" Margin="0,3,0,0" Text="—" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE8B7;" Margin="0,0,10,0" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="Источник" />
                                        <TextBlock x:Name="StatSource" Margin="0,3,0,0" Text="—"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </gui:Card>

                    <!--
                        Недавние серверы — через которые шёл трафик, свежие первыми
                        (ExitHistory: пишется, когда программа спрашивает движок о выходе).
                    -->
                    <gui:Card Grid.Column="2" Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Недавние серверы" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="Выходы, через которые недавно шёл трафик, — свежие первыми. Замечаются, пока программа открыта: смену при закрытом окне журнал увидит, когда окно спросит движок снова.&#x0a;&#x0a;Задержка и цвет — по последнему замеру сервера." />
                            </StackPanel>

                            <ItemsControl x:Name="RecentList" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Border CornerRadius="3" ClipToBounds="True" Visibility="{Binding FlagShown}"
                                                        BorderBrush="{DynamicResource Border}" BorderThickness="1.5">
                                                    <Image Source="{Binding Flag}" Width="24" Height="16" Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                                <TextBlock Text="{Binding Mark}" FontFamily="{Binding MarkFont}" FontSize="{Binding MarkSize}"
                                                           FontWeight="SemiBold" Foreground="{Binding MarkBrush}" Width="24"
                                                           TextAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding MarkShown}" />
                                            </Grid>

                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" FontWeight="{Binding Weight}" />

                                            <TextBlock Grid.Column="2" Text="{Binding Latency}" Style="{StaticResource Mono}"
                                                       Margin="8,0,10,0" VerticalAlignment="Center" />

                                            <Ellipse Grid.Column="3" Width="7" Height="7" Fill="{Binding Color}"
                                                     VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="RecentEmpty" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Margin="0,10,0,0" Visibility="Collapsed"
                                       Text="Пока пусто: журнал заполняется, пока движки работают и окно открыто." />
                        </StackPanel>
                    </gui:Card>
                </Grid>

                <!--
                    Быстрая смена сервера (макет владельца 01.10) — заменила карточку
                    «Автоподбор»: автоподбор теперь первая плитка ленты, а его
                    пояснение — строкой под заголовком. Выбрать плитку — то же,
                    что «выбрать» у сервера в списке.
                -->
                <gui:Card x:Name="QuickCard" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Быстрая смена сервера" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="«Авто» — автоподбор: движок сам опрашивает серверы и берёт быстрейший из живых. Мёртвый выход не выбирается.&#x0a;&#x0a;Плитка сервера закрепляет его — автоподбор выключится. Закреплённый держится, даже если перестанет отвечать, — пока в «Настройках» не включена «Замена выбранному серверу».&#x0a;&#x0a;Здесь серверы подписок в работе, быстрые первыми. Все — в списке подписок ниже." />
                                </StackPanel>
                                <TextBlock x:Name="PickLine" Style="{StaticResource Caption}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="ShowAllButton" Style="{StaticResource Ghost}"
                                    Content="Показать все" Click="OnShowAll" VerticalAlignment="Top" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource IconGhost}" Content="&#xE76B;"
                                    VerticalAlignment="Center" ToolTip="Назад" Click="OnQuickLeft" />

                            <ScrollViewer Grid.Column="1" x:Name="QuickScroll" Margin="8,0"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="OnQuickWheel">
                                <ItemsControl x:Name="QuickServers">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Choice}" Width="116" Margin="0,0,8,0" Padding="8,12"
                                                    BorderBrush="{Binding Edge}" Background="{Binding Fill}"
                                                    ToolTip="{Binding Tip}" Tag="{Binding Tag}" Click="OnQuick">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Grid Height="22" HorizontalAlignment="Center">
                                                        <Border CornerRadius="3" ClipToBounds="True" Visibility="{Binding FlagShown}"
                                                                BorderBrush="{DynamicResource Border}" BorderThickness="1.5">
                                                            <Image Source="{Binding Flag}" Width="32" Height="22" Stretch="UniformToFill"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Mark}" FontFamily="{Binding MarkFont}" FontSize="16"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource Muted}"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                   Visibility="{Binding MarkShown}" />
                                                    </Grid>

                                                    <TextBlock Text="{Binding Title}" Margin="0,8,0,0" FontWeight="SemiBold"
                                                               TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Latency}" Style="{StaticResource Mono}" Margin="0,3,0,0"
                                                               TextAlignment="Center" Foreground="{Binding Color}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Button Grid.Column="2" Style="{StaticResource IconGhost}" Content="&#xE76C;"
                                    VerticalAlignment="Center" ToolTip="Дальше" Click="OnQuickRight" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Border}" Margin="0,14,0,12" />

                        <!--
                            Отбор для автоподбора — здесь, а не в окне настроек
                            (владелец, 01.10): он про те же серверы, что в ленте.
                        -->
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,32,4">
                                <ToggleButton x:Name="ForeignSwitch" Style="{StaticResource Switch}"
                                              VerticalAlignment="Center" Click="OnForeign" />
                                <TextBlock Text="Только зарубежные" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="Автоподбор не берёт отечественные выходы. Подбор идёт по задержке и потому сползает на ближайший сервер — свой же, а через него не работает ровно то, ради чего туннель обычно и нужен: адрес остаётся отечественным, и отказ по стране приходит тот же, что без туннеля.&#x0a;&#x0a;Выбрать отечественный плиткой или в списке это не мешает. Применяется при следующем запуске движков." />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ToggleButton x:Name="StableSwitch" Style="{StaticResource Switch}"
                                              VerticalAlignment="Center" Click="OnStable" />
                                <TextBlock Text="Сначала стабильные" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="Нестабильные — серверы, что работают через раз: из последних пяти и больше замеров удачных меньше четырёх из пяти. Они жёлтые в списке.&#x0a;&#x0a;Включено — в автоподборе, в ленте и при сортировке по задержке они идут после стабильных: автоподбор возьмёт нестабильный, только если не ответил ни один стабильный. Выключено — только по задержке, как все.&#x0a;&#x0a;Выбрать нестабильный руками можно всегда. Автоподбор меняется при следующем запуске движков." />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </gui:Card>

                <!--
                    WARP — выбор пути, а не запасной (владелец, 01.10: «разводка
                    впн и варп… лучше сделать взаимоисключающими»). Включён — туннель
                    идёт только через WARP, подписки на паузе; выключен — только
                    подписки. Выключатель вернулся сюда из окна настроек.
                -->
                <gui:Card x:Name="WarpCard" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource IconTile}" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE753;" Foreground="#F38020" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Cloudflare WARP" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="Бесплатный выход Cloudflare: без счёта, без срока, без почты и ключей — учётную запись движок заводит себе сам.&#x0a;&#x0a;Это выбор пути: включённый WARP ставит подписки на паузу, и весь туннель идёт через него. Выключили — туннель вернётся к подпискам и к выбранному там серверу. Применяется при следующем запуске движков.&#x0a;&#x0a;Выпускает трафик в ближайшем городе Cloudflare, из России — в Москве. От блокировок оператора спасает, от отказов по стране — нет: адрес остаётся отечественным.&#x0a;&#x0a;Идёт по MASQUE поверх HTTP/2 на 443 порту. После запуска ему нужно около полуминуты, прежде чем пойдёт трафик." />
                            </StackPanel>
                            <TextBlock x:Name="WarpLine" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!--
                                Замер пинга — значком, как у подписок (владелец, 01.10).
                                Меряет движок, а он знает WARP, только когда тот в конфиге.
                            -->
                            <Button x:Name="WarpCheckButton" Style="{StaticResource IconGhost}" Content="&#xEC4A;"
                                    Margin="0,0,14,0" Click="OnCheckWarp" ToolTipService.ShowOnDisabled="True" />

                            <Ellipse x:Name="WarpDot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="WarpWord" Style="{StaticResource Caption}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <ToggleButton x:Name="WarpSwitch" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnWarp" />
                        </StackPanel>
                    </Grid>
                </gui:Card>

                <!--
                    Kill switch (владелец 27.10: «давай сделаем килсвитч как
                    настройку на вкладке впн»; жёсткий, только в «Туннеле»).
                    Фильтры ставит надзор — KillSwitch, SupervisorHost.EngageKillSwitch.
                -->
                <gui:Card x:Name="KillSwitchCard" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource IconTile}" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE72E;" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Kill switch" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="Не пускает трафик мимо VPN. Пока движки работают, Windows выпускает в сеть только то, что идёт через туннель, — и когда серверы не отвечают, и пока движок туннеля падает или перезапускается. Сети в это время нет совсем: так трафик не уйдёт с вашего настоящего адреса.&#x0a;&#x0a;Действует только в режиме «Туннель»: в «Гибриде» десинк и «напрямую» идут мимо туннеля по замыслу. Локальная сеть (роутер, принтер) и сам NetZapret работают и при нём.&#x0a;&#x0a;Снимается, когда вы останавливаете движки или закрываете программу, — в системе ничего не остаётся. «Обход туннеля» при нём не срабатывает. Применяется при следующем запуске движков." />
                            </StackPanel>
                            <TextBlock x:Name="KillSwitchLine" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <ToggleButton Grid.Column="2" x:Name="KillSwitchToggle" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="OnKillSwitch" />
                    </Grid>
                </gui:Card>

            </StackPanel>

            <!--
                Пулы серверов (владелец 19.10, идеи №6): папки серверов через
                все подписки, в которые ведут маршруты «через VPN». Сервер
                кладут в пул перетаскиванием на папку или из «⋯» строки.
                Стоят над подписками: их мало, а подписки раскрываются
                на сотни строк.
            -->
            <StackPanel x:Name="PoolsBlock">
                <Grid Margin="4,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Пулы серверов" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />

                    <Button Grid.Column="2" Style="{StaticResource Ghost}" Content="Новый пул" Click="OnNewPool" />
                </Grid>

                <TextBlock x:Name="PoolsLine" Style="{StaticResource Caption}" Margin="4,8,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel x:Name="SubsBlock">
                <!-- Подписки: заголовок со сводкой, добавление — по кнопке (макет 01.10). -->
                <Grid x:Name="SubsHeader" Margin="4,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Подписки" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />

                    <Border Grid.Column="1" CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Border}" BorderThickness="1.5">
                        <TextBlock x:Name="SubsSummary" FontSize="12" Foreground="{DynamicResource Muted}" Text="…" />
                    </Border>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button x:Name="SortButton" Style="{StaticResource Ghost}" gui:ButtonGlyph.Menu="True"
                                Content="По порядку подписки" Click="OnSort" Margin="0,0,8,0" />
                        <Button x:Name="AddToggle" Style="{StaticResource Ghost}"
                                Content="Добавить подписку" Click="OnAddToggle" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="PausedLine" Style="{StaticResource Caption}" Margin="4,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Warn}" Visibility="Collapsed"
                           Text="На паузе: туннель идёт через WARP. Выключите WARP выше — и он вернётся к подпискам." />

                <!--
                    Новая подписка — отдельным окном (SubscriptionAddWindow,
                    владелец 01.10: «как в Happ»). До того здесь стояла
                    карточка с одним полем на всё.
                -->

                <TextBlock x:Name="Status" Margin="4,10,0,0" TextWrapping="Wrap" Text="Читаю подписки…">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!--
                    Полоса замера. Замер идёт десятками секунд и до неё
                    выглядел зависанием: строки оживали по одной, а понять,
                    идёт ли ещё что-то, было не по чему.
                -->
                <ProgressBar x:Name="Progress" Height="6" Margin="4,10,0,0"
                             Visibility="Collapsed" Minimum="0"
                             Background="{DynamicResource Border}"
                             Foreground="{DynamicResource Accent}"
                             BorderThickness="0" />
            </StackPanel>

            <TextBlock x:Name="Footer" Style="{StaticResource Caption}" Margin="4,10,0,0" TextWrapping="Wrap"
                           Text="Движок берёт серверы всех подписок «в работе» и отдельных ключей, а автоподбор — быстрейший из живых. Замер поднимает движок с локальным входом и ходит через каждый сервер по очереди — TUN не трогается, работающий обход не прерывается." />
        </Grid>
    </Grid>
</UserControl>
