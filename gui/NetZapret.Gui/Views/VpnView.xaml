<UserControl x:Class="NetZapret.Gui.Views.VpnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="clr-namespace:NetZapret.Gui"
             Background="{DynamicResource Chrome}">

    <ScrollViewer Style="{StaticResource PageScroll}" Padding="32,28,32,28">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="470" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="VPN" Style="{StaticResource Title}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Text="Подписки, их серверы и то, через что идёт трафик." />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SortButton" Style="{StaticResource Ghost}"
                                Content="По задержке" Click="OnSort" Margin="0,0,8,0" />
                        <Button x:Name="RefreshButton" Style="{StaticResource Ghost}"
                                Content="Обновить" Click="OnRefresh" Margin="0,0,8,0" />
                        <!--
                            Настройки — отдельным окном. То, что задают
                            однажды, не должно занимать полосу над списком,
                            который смотрят каждый раз.
                        -->
                        <Button x:Name="SettingsButton" Style="{StaticResource Ghost}"
                                Content="Настройки" Click="OnSettings" Margin="0,0,8,0"
                                ToolTip="Режим, автоподбор по зарубежным, обход туннеля при мёртвых выходах и WARP." />

                        <Button x:Name="MeasureButton" Style="{StaticResource Primary}"
                                Content="Замерить все" Click="OnMeasure" />
                    </StackPanel>
                </Grid>

                <!--
                    Текущий сервер — первым на вкладке (владелец, 28.09: «сделай
                    красивый прямоугольник с выбранным сервером»). Прежде выход
                    был хвостом строки автоподбора, мелким шрифтом, и его искали.
                    Заполняется в ShowCurrent: живой выход — у движка, раз
                    в 15 секунд; подписка, протокол и задержка — из пула и замеров.
                -->
                <Border Style="{StaticResource Card}" Margin="0,22,0,0" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" x:Name="CurrentFlag" Width="56" Height="42" CornerRadius="8"
                                Margin="0,0,18,0" VerticalAlignment="Center"
                                Background="{DynamicResource Raised}">
                            <TextBlock x:Name="CurrentCountry" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Muted}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="CurrentCaption" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="CurrentName" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="CurrentDetail" Style="{StaticResource Caption}" Margin="0,5,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Column="2" x:Name="CurrentPill" CornerRadius="11" Padding="11,5"
                                BorderThickness="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="CurrentDot" Width="8" Height="8" Margin="0,0,7,0"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="CurrentState" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <!--
                    Автоподбор (владелец, 25.09: «переименовать в автоподбор,
                    сделать подсказку и вместо кнопки вернуть тумблер»). Выше
                    стояла карточка «VPN включён / Выключить VPN» — она убрана:
                    туннель включается выключателем на «Главной», и два места
                    для одного выключателя только путали.

                    Тумблер показывает, включён ли автоподбор. Нажатие строки
                    включает его — снимает закреплённый сервер. Выключить
                    тумблером нельзя: надо знать, какой сервер закрепить, —
                    это делает «выбрать» у сервера в списке, и строка так
                    и говорит.
                -->
                <Button Style="{StaticResource Choice}" Margin="0,10,0,0" Click="OnAuto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Автоподбор" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                Content="Движок сам опрашивает серверы и берёт быстрейший из живых. Мёртвый выход не выбирается — этим автоподбор и отличается от «первого по списку».&#x0a;&#x0a;Чтобы закрепить определённый сервер, нажмите «выбрать» у него в списке ниже — автоподбор выключится. Закреплённый сервер держится, даже если перестанет отвечать.&#x0a;&#x0a;Брать только зарубежные выходы и обходить туннель при мёртвых — в «Настройках» наверху." />
                            </StackPanel>
                            <TextBlock x:Name="PickLine" Style="{StaticResource Caption}"
                                       Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <ToggleButton Grid.Column="1" x:Name="AutoSwitch" Style="{StaticResource Switch}"
                                      IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" />
                    </Grid>
                </Button>


                <!--
                    Новая подписка. Поле скрытое: по ссылке выдаются серверы
                    и ключи, и увидеть её здесь не сможет ни тот, кто заглянет
                    через плечо, ни снимок экрана.
                -->
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Добавить подписку или ключи" FontWeight="SemiBold" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" x:Name="NewName" Margin="0,0,8,0"
                                     gui:Hint.Text="Имя для себя" />
                            <PasswordBox Grid.Column="1" x:Name="NewUrl" Margin="0,0,8,0"
                                         gui:Hint.Text="Ссылка подписки или ключи vless://, hysteria2://, trojan://…" />

                            <Button Grid.Column="2" Style="{StaticResource Primary}"
                                    Content="Добавить" Click="OnAdd" />
                        </Grid>

                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Слева имя для себя, справа ссылка подписки — или ключи, один или пачкой: они лягут в папку «Отдельные ключи». Ссылка и ключи обратно не показываются." />
                    </StackPanel>
                </Border>

                <!--
                    Обход туннеля, режим и автоподбор по зарубежным уехали
                    в окно настроек — решение владельца 21.09. Задают их
                    однажды, а места они занимали столько, что оттесняли
                    за нижний край список подписок, ради которого на вкладку
                    и заходят.
                -->

                <!--
                    WARP. Выключатель, а не подписка: его выходы подмешиваются
                    к серверам действующей подписки. Отдельной строкой в списке
                    он занимал её место — выбор его выхода делал действующим
                    его и отключал рабочий VPN целиком.
                -->
                <Border x:Name="WarpCard" Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Бесплатный WARP от Cloudflare"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />

                                    <ContentControl Style="{StaticResource Info}" Margin="4,0,0,0"
                                                    Content="Подмешивается к серверам действующей подписки, а не заменяет их: пока те живы, автоподбор берёт их — они быстрее, — а когда лягут, останется WARP. Без счёта и без срока.&#x0a;&#x0a;Выпускает трафик в ближайшей стране, и на российском подключении это Москва. От блокировок оператора спасает, от отказов по стране — нет: адрес остаётся отечественным.&#x0a;&#x0a;Идёт по MASQUE — поверх HTTP/2 на 443 порту, оператору неотличим от обычного веба. Движок регистрируется для него сам, и направить этот запрос нечем: WARP поднимется там, где открыт api.cloudflareclient.com. Отдельно не замеряется." />
                                </StackPanel>

                                <TextBlock x:Name="WarpLine" Style="{StaticResource Caption}"
                                           Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <!--
                                Выключатель WARP уехал в настройки, а замер
                                и «попробовать» остались: они про выходы,
                                то есть про то же, ради чего на вкладку
                                и заходят.
                            -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="WarpTryButton" Style="{StaticResource Ghost}"
                                        Content="попробовать сейчас" Padding="12,6" Margin="0,0,8,0"
                                        Visibility="Collapsed" Click="OnTryWarp" />

                                <Button x:Name="WarpCheckButton" Style="{StaticResource Ghost}"
                                        Content="проверить" Padding="12,6"
                                        Visibility="Collapsed" Click="OnCheckWarp" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl x:Name="WarpExits" Margin="0,12,0,0" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0" Width="8" Height="8" Margin="2,0,12,0"
                                                 VerticalAlignment="Center" Fill="{Binding Color}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Latency}" Style="{StaticResource Mono}"
                                                   VerticalAlignment="Center" Margin="12,0,14,0"
                                                   TextAlignment="Right" MinWidth="100"
                                                   Foreground="{Binding Color}" />

                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <Button Style="{StaticResource Ghost}"
                                                    Content="{Binding ChooseLabel}" Padding="14,7"
                                                    IsEnabled="{Binding CanChoose}"
                                                    Tag="{Binding Tag}" Click="OnChoose" />

                                            <!-- Только у отдельных ключей: ключ убирается по одному. -->
                                            <Button Style="{StaticResource IconGhost}" Content="&#xE74D;"
                                                    Margin="6,0,0,0" ToolTip="Убрать этот ключ"
                                                    Visibility="{Binding RemoveShown}"
                                                    Tag="{Binding Tag}" Click="OnRemoveKey" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--
                            Три абзаца отсюда ушли под значок «i» у заголовка
                            карточки — владелец 21.09: «убери это огромное
                            некрасивое описание». Он прав: про устройство
                            выходов читают однажды, а место они занимали
                            каждый раз.
                        -->
                    </StackPanel>
                </Border>

                <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="4,18,0,0"
                           TextWrapping="Wrap" Text="Читаю подписки…" />

                <!--
                    Полоса замера. Замер идёт десятками секунд и до неё
                    выглядел зависанием: строки оживали по одной, а понять,
                    идёт ли ещё что-то, было не по чему.
                -->
                <ProgressBar x:Name="Progress" Height="6" Margin="4,10,0,0"
                             Visibility="Collapsed" Minimum="0"
                             Background="{DynamicResource Border}"
                             Foreground="{DynamicResource Accent}"
                             BorderThickness="0" />

                <ItemsControl x:Name="Subscriptions" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">

                                <!-- Папка подписки. Свёрнутая, но со всеми цифрами в заголовке. -->
                                <Button Style="{StaticResource Choice}" BorderBrush="{Binding Edge}"
                                        Margin="0" Click="OnFolder">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Path Grid.Column="0" Style="{StaticResource Chevron}"
                                              Margin="5,0,6,0">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="{Binding ChevronAngle}" />
                                            </Path.RenderTransform>
                                        </Path>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <!--
                                                Сетка, а не стопка: в горизонтальной
                                                стопке ширина считается бесконечной,
                                                и обрезание длинного имени
                                                не срабатывает — оно лезет
                                                на соседнюю подпись.
                                            -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           FontWeight="SemiBold" FontSize="14"
                                                           TextTrimming="CharacterEllipsis" />

                                                <TextBlock Grid.Column="1" Text="в работе" Style="{StaticResource Mono}"
                                                           Foreground="{DynamicResource Accent}"
                                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding ActiveShown}" />
                                            </Grid>

                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                       Margin="0,5,0,0" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <!--
                                                Выключатель «в работе» вместо «сделать действующей»
                                                (0.9.0, пул): подписок в работе может быть сколько
                                                угодно, их серверы идут в один автоподбор.
                                            -->
                                            <ToggleButton Style="{StaticResource Switch}" Margin="0,0,14,0"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding Active, Mode=OneWay}"
                                                          ToolTip="В работе: серверы этой подписки идут в пул движка"
                                                          Tag="{Binding Name}" Click="OnActivate" />

                                            <!--
                                                Значками, как в Happ (владелец, 28.09): обновить,
                                                тест пинга и меню со всем остальным. Подписи —
                                                во всплывающих подсказках.
                                            -->
                                            <Button Style="{StaticResource IconGhost}" Content="&#xE72C;"
                                                    Margin="0,0,6,0" ToolTip="Обновить: перечитать подписку"
                                                    Tag="{Binding Name}" Click="OnRefreshOne" />

                                            <Button Style="{StaticResource IconGhost}" Content="&#xEC4A;"
                                                    Margin="0,0,6,0" ToolTip="{Binding CheckLabel}"
                                                    IsEnabled="{Binding CanCheck}"
                                                    Tag="{Binding Name}" Click="OnCheckOne" />
                                        </StackPanel>

                                        <Button Grid.Column="3" Style="{StaticResource IconGhost}" Content="&#xE712;"
                                                ToolTip="Ещё: закрепить, скопировать ссылку, изменить, удалить"
                                                Tag="{Binding Name}" Click="OnMore" />
                                    </Grid>
                                </Button>

                                <ItemsControl ItemsSource="{Binding Servers}"
                                              Visibility="{Binding ServersShown}"
                                              Margin="20,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="14,11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Ellipse Grid.Column="0" Width="8" Height="8" Margin="2,0,12,0"
                                                             VerticalAlignment="Center" Fill="{Binding Color}" />

                                                    <!--
                                                        Флаг картинкой, а если такой нет — буквы кода.
                                                        Windows флаги стран не рисует вовсе: в Segoe UI
                                                        Emoji их нет, и пара региональных букв выходит
                                                        как «de», влипшее в название.
                                                    -->
                                                    <Grid Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <Border CornerRadius="3" ClipToBounds="True"
                                                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                                Visibility="{Binding FlagShown}">
                                                            <Image Source="{Binding Flag}" Width="26" Height="18"
                                                                   Stretch="UniformToFill"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Border>

                                                        <Border Background="{DynamicResource Raised}"
                                                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                                CornerRadius="5" Padding="7,3"
                                                                Visibility="{Binding CountryShown}">
                                                            <TextBlock Text="{Binding Country}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Muted}" />
                                                        </Border>
                                                    </Grid>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="3" Text="{Binding Latency}" Style="{StaticResource Mono}"
                                                               VerticalAlignment="Center" Margin="12,0,14,0"
                                                               TextAlignment="Right" MinWidth="86"
                                                               Foreground="{Binding Color}" />

                                                    <Button Grid.Column="4" Style="{StaticResource Ghost}"
                                                            Content="{Binding ChooseLabel}" Padding="14,7"
                                                            IsEnabled="{Binding CanChoose}"
                                                            Tag="{Binding Tag}" Click="OnChoose" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource Caption}" Margin="4,10,0,0" TextWrapping="Wrap"
                           Text="Движок берёт серверы всех подписок «в работе» и отдельных ключей, а автоподбор — быстрейший из живых. Замер поднимает движок с локальным входом и ходит через каждый сервер по очереди — TUN не трогается, работающий обход не прерывается." />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
