<UserControl x:Class="NetZapret.Gui.Views.VpnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Backdrop}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,28">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="980" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="VPN" Style="{StaticResource Title}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Text="Подписки, их серверы и то, через что идёт трафик." />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SortButton" Style="{StaticResource Ghost}"
                                Content="По задержке" Click="OnSort" Margin="0,0,8,0" />
                        <Button x:Name="RefreshButton" Style="{StaticResource Ghost}"
                                Content="Обновить" Click="OnRefresh" Margin="0,0,8,0" />
                        <Button x:Name="MeasureButton" Style="{StaticResource Primary}"
                                Content="Замерить все" Click="OnMeasure" />
                    </StackPanel>
                </Grid>

                <!--
                    Выключатель туннеля. За ним стоит режим работы: «выключить»
                    означает «только десинк», потому что отдельного признака
                    «VPN включён» в настройках нет и заводить второй источник
                    правды ради кнопки нельзя.
                -->
                <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="Dot" Grid.Column="0" Width="12" Height="12"
                                 VerticalAlignment="Center" Margin="2,0,16,0"
                                 Fill="{StaticResource Faint}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="PowerLine" FontSize="16" FontWeight="SemiBold" Text="—" />
                            <TextBlock x:Name="PowerHint" Style="{StaticResource Caption}"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="2" x:Name="PowerButton" Style="{StaticResource Ghost}"
                                Click="OnPower" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!--
                    Новая подписка. Поле скрытое: по ссылке выдаются серверы
                    и ключи, и увидеть её здесь не сможет ни тот, кто заглянет
                    через плечо, ни снимок экрана.
                -->
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Добавить подписку" FontWeight="SemiBold" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" x:Name="NewName" Margin="0,0,8,0" />
                            <PasswordBox Grid.Column="1" x:Name="NewUrl" Margin="0,0,8,0" />

                            <Button Grid.Column="2" Style="{StaticResource Primary}"
                                    Content="Добавить" Click="OnAdd" />
                        </Grid>

                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Слева имя для себя, справа ссылка. Ссылка обратно не показывается — только заменяется или убирается вместе с подпиской." />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="4,18,0,0"
                           TextWrapping="Wrap" Text="Читаю подписки…" />

                <ItemsControl x:Name="Subscriptions" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">

                                <!-- Папка подписки. Свёрнутая, но со всеми цифрами в заголовке. -->
                                <Button Style="{StaticResource Choice}" BorderBrush="{Binding Edge}"
                                        Margin="0" Click="OnFolder">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Chevron}"
                                                   Foreground="{StaticResource Muted}" FontSize="10"
                                                   Width="16" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                           TextTrimming="CharacterEllipsis" />

                                                <TextBlock Text="действует" Style="{StaticResource Mono}"
                                                           Foreground="{StaticResource Accent}"
                                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding ActiveShown}" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                       Margin="0,5,0,0" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Button Grid.Column="2" Style="{StaticResource Ghost}"
                                                Content="сделать действующей" Padding="12,6" Margin="0,0,8,0"
                                                Visibility="{Binding ActivateShown}"
                                                Tag="{Binding Name}" Click="OnActivate" />

                                        <Button Grid.Column="3" Style="{StaticResource Ghost}"
                                                Content="убрать" Padding="12,6"
                                                Tag="{Binding Name}" Click="OnRemove" />
                                    </Grid>
                                </Button>

                                <ItemsControl ItemsSource="{Binding Servers}"
                                              Visibility="{Binding ServersShown}"
                                              Margin="20,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="14,11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Ellipse Grid.Column="0" Width="8" Height="8" Margin="2,0,12,0"
                                                             VerticalAlignment="Center" Fill="{Binding Color}" />

                                                    <!--
                                                        Флаг картинкой, а если такой нет — буквы кода.
                                                        Windows флаги стран не рисует вовсе: в Segoe UI
                                                        Emoji их нет, и пара региональных букв выходит
                                                        как «de», влипшее в название.
                                                    -->
                                                    <Grid Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <Border CornerRadius="3" ClipToBounds="True"
                                                                BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                                Visibility="{Binding FlagShown}">
                                                            <Image Source="{Binding Flag}" Width="26" Height="18"
                                                                   Stretch="UniformToFill"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Border>

                                                        <Border Background="{StaticResource Raised}"
                                                                BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                                CornerRadius="5" Padding="7,3"
                                                                Visibility="{Binding CountryShown}">
                                                            <TextBlock Text="{Binding Country}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Muted}" />
                                                        </Border>
                                                    </Grid>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="3" Text="{Binding Latency}" Style="{StaticResource Mono}"
                                                               VerticalAlignment="Center" Margin="12,0,14,0"
                                                               TextAlignment="Right" MinWidth="86"
                                                               Foreground="{Binding Color}" />

                                                    <Button Grid.Column="4" Style="{StaticResource Ghost}"
                                                            Content="{Binding ChooseLabel}" Padding="14,7"
                                                            IsEnabled="{Binding CanChoose}"
                                                            Tag="{Binding Tag}" Click="OnChoose" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource Caption}" Margin="4,10,0,0" TextWrapping="Wrap"
                           Text="Сервер берётся из действующей подписки: конфиг движка собирается по одной ссылке, и выбор выхода из соседней делает действующей её. Замер поднимает движок с локальным входом и ходит через каждый сервер по очереди — TUN не трогается, работающий обход не прерывается." />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
