<Window x:Class="NetZapret.Gui.Views.RoutesSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="clr-namespace:NetZapret.Gui"
        Title="Настройки маршрутов"
        Width="620" SizeToContent="Height" MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Backdrop}"
        ResizeMode="NoResize">
    <!--
        По образцу «Настроек туннеля» (владелец, 05.10: «создай на вкладке
        маршруты настройки по аналогии с вкладкой VPN»). Сюда переехали два
        выключателя Discord из «Ещё → Прочее»: оба про его маршруты, и ищут
        их, разбираясь с голосом на этой вкладке.
    -->
    <Grid LayoutTransform="{DynamicResource UiScaleTransform}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Style="{StaticResource PageScroll}" Padding="22,20,22,0">
            <StackPanel>
                <TextBlock Text="Настройки маршрутов" Style="{StaticResource Title}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Маршруты сервисов и свои сайты — на вкладке «Маршруты». Здесь — то, что задают однажды." />

                <TextBlock Text="DISCORD" Style="{StaticResource GroupHead}" Margin="4,22,0,7" />

                <gui:Card Style="{StaticResource SettingsGroup}">
                    <StackPanel>
                        <Grid Margin="16,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Предлагать перезапуск Discord" VerticalAlignment="Center" />

                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Discord запоминает голосовые серверы на сеанс и до перезапуска ходит по-старому. После смены его маршрута программа предложит перезапустить его. Сама не перезапускает никогда: посреди звонка это хуже задержки." />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="После смены маршрута Discord — предложение перезапустить его." />
                            </StackPanel>

                            <TextBlock Grid.Column="1" x:Name="RestartWord" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />

                            <ToggleButton Grid.Column="2" x:Name="Restart" Style="{StaticResource Switch}"
                                          Click="OnRestart" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource RowLine}" />

                        <Grid Margin="16,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Дописывать адреса голоса Discord" VerticalAlignment="Center" />

                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Звук Discord идёт на голые адреса, и в туннель попадает только адресом из списка части «Звук голоса (адреса)». Пока эта часть стоит «через VPN», новые адреса его серверов берутся из журнала Discord и дописываются в список сетью /20. Заработают после перезапуска движков. Что дописалось бы, показывает nz voice." />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Новые адреса голоса — из журнала Discord в список, пока голос «через VPN»." />
                            </StackPanel>

                            <TextBlock Grid.Column="1" x:Name="LearnWord" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />

                            <ToggleButton Grid.Column="2" x:Name="Learn" Style="{StaticResource Switch}"
                                          Click="OnLearn" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </gui:Card>

                <TextBlock Text="ROBLOX" Style="{StaticResource GroupHead}" Margin="4,22,0,7" />

                <gui:Card Style="{StaticResource SettingsGroup}">
                    <StackPanel>
                        <!-- Владелец 21.10: «по аналогии с дискордом … автопополнение адресов серверов роблокс». -->
                        <Grid Margin="16,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Дописывать адреса серверов Roblox" VerticalAlignment="Center" />

                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Матч Roblox идёт на голый адрес сервера и в туннель попадает только адресом из списка части «Игровые серверы (адреса)». Там сети самой Roblox, а часть плейсов стоит на Amazon — мимо туннеля их выкидывает с ошибкой 277 или 279. Пока часть стоит «через VPN», адреса серверов берутся из журнала Roblox и дописываются в список сетью /20. Заработают после перезапуска движков." />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Новые адреса игровых серверов — из журнала Roblox в список, пока его серверы «через VPN»." />
                            </StackPanel>

                            <TextBlock Grid.Column="1" x:Name="LearnRobloxWord" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />

                            <ToggleButton Grid.Column="2" x:Name="LearnRoblox" Style="{StaticResource Switch}"
                                          Click="OnLearnRoblox" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </gui:Card>

                <TextBlock Text="ARC RAIDERS" Style="{StaticResource GroupHead}" Margin="4,22,0,7" />

                <gui:Card Style="{StaticResource SettingsGroup}">
                    <StackPanel>
                        <!-- Владелец 21.10, после обсуждения №32: папка ARC Raiders с маршрутами. -->
                        <Grid Margin="16,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Дописывать адреса серверов ARC Raiders" VerticalAlignment="Center" />

                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Матч ARC Raiders идёт на голые адреса серверов в Google Cloud и в туннель попадает только адресом из списка части «Игровые серверы (адреса)». Заранее эти адреса не знает никто, поэтому список пополняется сам: пока часть стоит «через VPN» и игра запущена, «Наблюдение» видит её соединения и дописывает адреса без имени сетью /24. Заработают после перезапуска движков — первый матч ещё пойдёт напрямую." />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Адреса серверов — из соединений игры в список, пока её серверы «через VPN»." />
                            </StackPanel>

                            <TextBlock Grid.Column="1" x:Name="LearnArcWord" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />

                            <ToggleButton Grid.Column="2" x:Name="LearnArc" Style="{StaticResource Switch}"
                                          Click="OnLearnArc" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </gui:Card>

                <!--
                    Владелец 06.10: «создадим раздел в настройках маршрутов с этими
                    решениями» — раздел «Напрямую» каталога hosts Zapret GUI.
                    Адрес прописывается как есть, десинк остаётся (PinSolutions).
                -->
                <TextBlock Text="ПИНЫ НАПРЯМУЮ" Style="{StaticResource GroupHead}" Margin="4,22,0,7" />

                <TextBlock Style="{StaticResource Caption}" Margin="4,0,0,9" TextWrapping="Wrap"
                           Text="Имя прибивается в hosts к адресу самого сервиса, а десинк продолжает работать: провайдер режет его имя и там. Из каталога Zapret GUI, раздел «Напрямую»." />

                <gui:Card Style="{StaticResource SettingsGroup}">
                    <ItemsControl x:Name="Solutions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{StaticResource RowLine}" Visibility="{Binding LineShown}" />

                                    <Grid Margin="16,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                                    Opacity="{Binding Fade}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />

                                                <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                                Content="{Binding Info}" />
                                            </StackPanel>

                                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Text="{Binding Caption}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding Word}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                                        <ToggleButton Grid.Column="2" Style="{StaticResource Switch}"
                                                      IsChecked="{Binding On, Mode=OneWay}"
                                                      IsEnabled="{Binding Available}"
                                                      Tag="{Binding Id}"
                                                      Click="OnSolution" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </gui:Card>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="22,12,22,20">
            <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="4,0,0,0"
                       TextWrapping="Wrap" />

            <Button Style="{StaticResource Ghost}" Content="Закрыть" Click="OnClose"
                    HorizontalAlignment="Right" Margin="0,12,0,0" MinWidth="110" />
        </StackPanel>
    </Grid>
</Window>
