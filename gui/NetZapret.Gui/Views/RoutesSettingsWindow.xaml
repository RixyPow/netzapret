<Window x:Class="NetZapret.Gui.Views.RoutesSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки маршрутов"
        Width="620" SizeToContent="Height" MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Backdrop}"
        ResizeMode="NoResize">
    <!--
        По образцу «Настроек туннеля» (владелец, 05.10: «создай на вкладке
        маршруты настройки по аналогии с вкладкой VPN»). Сюда переехали два
        выключателя Discord из «Ещё → Прочее»: оба про его маршруты, и ищут
        их, разбираясь с голосом на этой вкладке.
    -->
    <Grid LayoutTransform="{DynamicResource UiScaleTransform}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Style="{StaticResource PageScroll}" Padding="22,20,22,0">
            <StackPanel>
                <TextBlock Text="Настройки маршрутов" Style="{StaticResource Title}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Маршруты сервисов и свои сайты — на вкладке «Маршруты». Здесь — то, что задают однажды." />

                <TextBlock Text="DISCORD" Style="{StaticResource GroupHead}" Margin="4,22,0,7" />

                <Border Style="{StaticResource SettingsGroup}">
                    <StackPanel>
                        <Grid Margin="16,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Предлагать перезапуск Discord" VerticalAlignment="Center" />

                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Discord запоминает голосовые серверы на сеанс и до перезапуска ходит по-старому. После смены его маршрута программа предложит перезапустить его. Сама не перезапускает никогда: посреди звонка это хуже задержки." />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="После смены маршрута Discord — предложение перезапустить его." />
                            </StackPanel>

                            <TextBlock Grid.Column="1" x:Name="RestartWord" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />

                            <ToggleButton Grid.Column="2" x:Name="Restart" Style="{StaticResource Switch}"
                                          Click="OnRestart" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource RowLine}" />

                        <Grid Margin="16,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Дописывать адреса голоса Discord" VerticalAlignment="Center" />

                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Звук Discord идёт на голые адреса, и в туннель попадает только адресом из списка части «Звук голоса (адреса)». Пока эта часть стоит «через VPN», новые адреса его серверов берутся из журнала Discord и дописываются в список сетью /20. Заработают после перезапуска движков. Что дописалось бы, показывает nz voice." />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Новые адреса голоса — из журнала Discord в список, пока голос «через VPN»." />
                            </StackPanel>

                            <TextBlock Grid.Column="1" x:Name="LearnWord" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />

                            <ToggleButton Grid.Column="2" x:Name="Learn" Style="{StaticResource Switch}"
                                          Click="OnLearn" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="22,12,22,20">
            <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="4,0,0,0"
                       TextWrapping="Wrap" />

            <Button Style="{StaticResource Ghost}" Content="Закрыть" Click="OnClose"
                    HorizontalAlignment="Right" Margin="0,12,0,0" MinWidth="110" />
        </StackPanel>
    </Grid>
</Window>
