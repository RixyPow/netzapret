<Window x:Class="NetZapret.Gui.Views.FakePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="clr-namespace:NetZapret.Gui"
        Title="Подделка секции" Width="620" Height="640" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Backdrop}">

    <!--
        Выбор подделки у секции пресета — своим окном (владелец 03.11, снимок
        «Подделок секций»: выпадающий список рисовался поверх карточки, и на
        прозрачном фоне темы названия сливались со строками под ним). Окно на
        непрозрачной подложке, с поиском: образцов под секцию бывает три десятка.
    -->
    <Grid LayoutTransform="{DynamicResource UiScaleTransform}" Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource Title}" FontSize="20" TextWrapping="Wrap"><Run x:Name="Head" /><InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource Info}" Margin="4,0,0,0" Content="Файл пресета не меняется. Выбор действует со следующего запуска движков." /></InlineUIContainer></TextBlock>
            <TextBlock x:Name="Step" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <TextBox Grid.Row="1" x:Name="Search" Margin="0,16,0,0" TextChanged="OnSearch"
                 gui:Hint.Text="Поиск по имени…" />

        <TextBlock Grid.Row="2" x:Name="Status" Style="{StaticResource Caption}" Margin="4,8,0,8"
                   TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="3" Style="{StaticResource PageScroll}">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Choice}" Margin="0,0,0,6" Click="OnPick">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding Mark}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                                           Margin="12,0,4,0" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Style="{StaticResource Ghost}" Content="Отмена" IsCancel="True"
                    Click="OnCancel" />
        </Grid>
    </Grid>
</Window>
