<UserControl x:Class="NetZapret.Gui.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Backdrop}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,28">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="980" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <Grid>
                    <StackPanel>
                        <TextBlock Text="Серверы" Style="{StaticResource Title}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="Что отдаёт подписка и через что идёт трафик." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="RefreshButton" Style="{StaticResource Ghost}"
                                Content="Обновить" Click="OnRefresh" Margin="0,0,8,0" />
                        <Button x:Name="MeasureButton" Style="{StaticResource Primary}"
                                Content="Замерить все" Click="OnMeasure" />
                    </StackPanel>
                </Grid>

                <!--
                    Квота и срок. Кончится — встанет всё разом, и выглядеть это
                    будет как блокировка всего сразу, а не как исчерпанная
                    подписка. Поэтому цифры на виду, а не в подменю.
                -->
                <Border x:Name="QuotaCard" Style="{StaticResource Card}" Margin="0,22,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Caption}" Text="Осталось" />
                            <TextBlock x:Name="QuotaValue" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" Text="—" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Caption}" Text="Срок" />
                            <TextBlock x:Name="ExpiryValue" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" Text="—" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Caption}" Text="Серверов" />
                            <TextBlock x:Name="CountValue" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" Text="—" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="4,18,0,0"
                           TextWrapping="Wrap" Text="Читаю подписку…" />

                <ItemsControl x:Name="Servers" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,13">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="8" Height="8" Margin="2,0,14,0"
                                             VerticalAlignment="Center" Fill="{Binding Color}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Tag}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding Latency}" Style="{StaticResource Mono}"
                                               VerticalAlignment="Center" Margin="0,0,16,0"
                                               Foreground="{Binding Color}" />

                                    <Button Grid.Column="3" Style="{StaticResource Ghost}"
                                            Content="{Binding ChooseLabel}" Padding="14,7"
                                            IsEnabled="{Binding CanChoose}"
                                            Tag="{Binding Tag}" Click="OnChoose" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="Note" Style="{StaticResource Caption}" Margin="4,10,0,0" TextWrapping="Wrap"
                           Text="Замер поднимает движок с локальным входом и ходит через каждый сервер по очереди — TUN не трогается, работающий обход не прерывается." />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
