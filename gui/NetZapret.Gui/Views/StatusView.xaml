<UserControl x:Class="NetZapret.Gui.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Backdrop}">

    <!--
        Колонка слева, шириной до 980. Раньше стоял HorizontalAlignment="Left"
        на самой стопке — и карточки сжимались по содержимому вместо заявленной
        ширины, оставляя справа пустоту в половину окна. Ограничение ширины
        колонки в сетке даёт и то и другое: карточки тянутся, а строка текста
        не разъезжается на всю ширину монитора, где её неудобно читать.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,28">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="980" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">

            <TextBlock Text="Главная" Style="{StaticResource Title}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                       Text="Что настроено, что из этого работает прямо сейчас и две главные ручки." />

            <!--
                Карточка состояния. Крупная точка и одна строка словами:
                первое, зачем окно открывают, — понять, идёт ли обход.
            -->
            <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="Dot" Grid.Column="0" Width="12" Height="12"
                             VerticalAlignment="Center" Margin="2,0,16,0"
                             Fill="{StaticResource Faint}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StateLine" FontSize="16" FontWeight="SemiBold" Text="Проверяю…" />
                        <TextBlock x:Name="StateHint" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" Text="" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StartButton" Style="{StaticResource Primary}"
                                Content="Запустить" Click="OnStart" Visibility="Collapsed" />
                        <Button x:Name="StopButton" Style="{StaticResource Destructive}"
                                Content="Остановить" Click="OnStop" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Настройка. Только показ: правка — в своих разделах. -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Caption}" Text="Пресет" Margin="0,0,0,10" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PresetValue" Margin="0,0,0,10" Text="—" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Caption}" Text="Сервер" Margin="0,0,0,10" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ServerValue" Margin="0,0,0,10" Text="—" TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Caption}" Text="DNS" Margin="0,0,0,10" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DnsValue" Margin="0,0,0,10" Text="—" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Caption}" Text="Подписки" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SubscriptionValue" Text="—" />
                </Grid>
            </Border>

            <!--
                Движки по одному. Супервизор держит их отдельно, и «работает»
                у каждого своё: sing-box может подняться, а winws2 упасть, —
                одна общая лампочка это скрыла бы.
            -->
            <TextBlock Text="Движки" Style="{StaticResource Caption}" Margin="4,22,0,8" />
            <ItemsControl x:Name="Engines">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0" Width="8" Height="8" Margin="2,0,14,0"
                                         VerticalAlignment="Center" Fill="{Binding Color}" />

                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Предупреждения: защитник в стеке, стёртый hosts. Пусто — не показываем. -->
            <ItemsControl x:Name="Warnings" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8"
                                BorderBrush="{StaticResource Warn}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Warn}" />
                                <TextBlock Text="{Binding Body}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="Problem" Style="{StaticResource Caption}" Foreground="{StaticResource Danger}"
                       Margin="4,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

            <!--
                Режим — самая крупная ручка во всей программе: он задаёт
                рамку, внутри которой вообще имеют смысл маршруты. Место ему
                рядом с кнопкой запуска, а не в разделе «Ещё», куда он попал
                по недосмотру.
            -->
            <TextBlock Text="Режим работы" FontWeight="SemiBold" FontSize="15" Margin="4,26,0,10" />

            <ItemsControl x:Name="Modes">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Choice}" BorderBrush="{Binding Edge}"
                                Tag="{Binding Key}" Click="OnMode">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}"
                                               Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="сейчас" Style="{StaticResource Mono}"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                           Visibility="{Binding MarkShown}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Автозапуск" FontWeight="SemiBold" FontSize="15" Margin="4,22,0,10" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Задача планировщика" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="AutostartValue" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1" x:Name="AutostartButton" Style="{StaticResource Ghost}"
                                Click="OnAutostart" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="Планировщик, а не служба: правами администратора задача наделяется сразу, запрос UAC при входе не появляется. Запускается тот же netzapret.exe и с теми же ключами, что и кнопка «Запустить» выше, — иначе автозапуск поднимал бы не то, что вы проверили руками." />
                </StackPanel>
            </Border>

        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
