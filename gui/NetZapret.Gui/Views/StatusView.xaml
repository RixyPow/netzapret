<UserControl x:Class="NetZapret.Gui.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Backdrop}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,28">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="Состояние" Style="{StaticResource Title}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                       Text="Что настроено и что из этого работает прямо сейчас." />

            <!--
                Карточка состояния. Крупная точка и одна строка словами:
                первое, зачем окно открывают, — понять, идёт ли обход.
            -->
            <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="Dot" Grid.Column="0" Width="12" Height="12"
                             VerticalAlignment="Center" Margin="2,0,16,0"
                             Fill="{StaticResource Faint}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StateLine" FontSize="16" FontWeight="SemiBold" Text="Проверяю…" />
                        <TextBlock x:Name="StateHint" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" Text="" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StartButton" Style="{StaticResource Primary}"
                                Content="Запустить" Click="OnStart" Visibility="Collapsed" />
                        <Button x:Name="StopButton" Style="{StaticResource Destructive}"
                                Content="Остановить" Click="OnStop" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Настройка. Только показ: правка — в своих разделах. -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Caption}" Text="Режим" Margin="0,0,0,10" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ModeValue" Margin="0,0,0,10" Text="—" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Caption}" Text="Пресет" Margin="0,0,0,10" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PresetValue" Margin="0,0,0,10" Text="—" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Caption}" Text="Сервер" Margin="0,0,0,10" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ServerValue" Margin="0,0,0,10" Text="—" TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Caption}" Text="DNS" Margin="0,0,0,10" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DnsValue" Margin="0,0,0,10" Text="—" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Caption}" Text="Подписка" />
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SubscriptionValue" Text="—" />
                </Grid>
            </Border>

            <!--
                Движки по одному. Супервизор держит их отдельно, и «работает»
                у каждого своё: sing-box может подняться, а winws2 упасть, —
                одна общая лампочка это скрыла бы.
            -->
            <TextBlock Text="Движки" Style="{StaticResource Caption}" Margin="4,22,0,8" />
            <ItemsControl x:Name="Engines">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0" Width="8" Height="8" Margin="2,0,14,0"
                                         VerticalAlignment="Center" Fill="{Binding Color}" />

                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Предупреждения: защитник в стеке, стёртый hosts. Пусто — не показываем. -->
            <ItemsControl x:Name="Warnings" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8"
                                BorderBrush="{StaticResource Warn}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Warn}" />
                                <TextBlock Text="{Binding Body}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="Problem" Style="{StaticResource Caption}" Foreground="{StaticResource Danger}"
                       Margin="4,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
