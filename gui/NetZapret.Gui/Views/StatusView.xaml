<UserControl x:Class="NetZapret.Gui.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NetZapret.Gui.Views"
             xmlns:local="clr-namespace:NetZapret.Gui"
             Background="{DynamicResource Backdrop}">

    <UserControl.Resources>
        <!--
            Сегмент режима в карточке «Режим»: выбранный обведён цветом темы
            и чуть подсвечен подложкой. Выбор — обводкой (см. Choice в Controls.xaml).
        -->
        <Style x:Key="ModeSegment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <!--
                        Рамка 2 и у выбранного, и у прочих (владелец 19.10: «ширину
                        границ чуть больше, где-то выглядит рвано»): при 125 %
                        Windows рамка 1,5 — это 1,875 пикселя, и скругление выходило
                        ступенчатым. Выбранный отличается цветом, а не толщиной —
                        толщина сдвигала бы подпись на полточки. Галочки в углу нет:
                        была с утра 19.10, владельцу не понравилась.
                    -->
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shape" Background="Transparent"
                                BorderBrush="{DynamicResource Border}" BorderThickness="2"
                                CornerRadius="11" Padding="12,9">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Raised}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Raised}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Плитка быстрого действия — карточкой, а не кнопкой: та же подложка
            со стеклом, рамка и скругление, что у Card (владелец 19.10: «нижние
            кнопки другого цвета, чем другие плитки»). У Ghost подложка Raised,
            и содержимое по середине — значки четырёх плиток стояли бы вразнобой.
        -->
        <Style x:Key="QuickAction" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardEdge}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <local:Card x:Name="Shape" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2"
                                CornerRadius="14" Padding="{TemplateBinding Padding}"
                                local:Glass.IsOn="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </local:Card>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Muted}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Surface}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Половинки одной плашки «Остановить ▾» (владелец 19.10: «склей две
            кнопки»). Подложка у плашки, у половинок — только подсветка при
            наведении и нажатии, со своим скруглением с внешней стороны:
            Border детей не обрезает, и квадратная подсветка вылезла бы за угол.
        -->
        <Style x:Key="SplitPart" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <ControlTemplate x:Key="SplitShape" TargetType="Button">
            <Border x:Name="Shape" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding Tag}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Shape" Property="Background" Value="#22FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Shape" Property="Background" Value="#22000000" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!--
            Скругление подсветки — внутренний край плашки: её 10 минус рамка 1,5.
            С 05.11 до правки стояло 12 от прежней плашки в 50 точек без рамки,
            и подсветка при наведении выходила круглее самой кнопки.
        -->
        <Style x:Key="SplitLeft" TargetType="Button" BasedOn="{StaticResource SplitPart}">
            <Setter Property="Tag">
                <Setter.Value>
                    <CornerRadius>8.5,0,0,8.5</CornerRadius>
                </Setter.Value>
            </Setter>
            <Setter Property="Template" Value="{StaticResource SplitShape}" />
        </Style>

        <Style x:Key="SplitRight" TargetType="Button" BasedOn="{StaticResource SplitPart}">
            <Setter Property="Tag">
                <Setter.Value>
                    <CornerRadius>0,8.5,8.5,0</CornerRadius>
                </Setter.Value>
            </Setter>
            <Setter Property="Template" Value="{StaticResource SplitShape}" />
        </Style>

        <!--
            Карточки рядов «Главной» — с полями 13 по вертикали, а не 16, как
            у Card. Владелец 20.10, снимок не развёрнутого окна (1067×712):
            «Главную опять надо мотать». С Manrope строки выше, чем у прежнего
            шрифта, и страница выросла на 22 точки — 666 при видимых 652.
            Таких карточек четыре, в два ряда: пресет и параметры, автозапуск
            и обновление (у него те же поля — в UpdatePanel.xaml).
        -->
        <Style x:Key="HomeCard" TargetType="local:Card" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,13" />
        </Style>
    </UserControl.Resources>

    <!--
        Подложка сплошная, а не прозрачная, как у прочих разделов (Chrome):
        окно кладёт картинку темы под всё, а здесь она своя, сдвинутая
        вправо (ArtLayer), — без сплошной подложки под ней проступал бы
        второй, оконный персонаж (снимок 30.09).
    -->

    <!--
        Компоновка — по макету владельца 30.09: шапка со ссылками, крупная
        карточка состояния, под ней пресет и параметры подключения рядом,
        движки, автозапуск с обновлением, быстрые действия и строка внизу.

        Две колонки: содержимое слева, не шире 940, и арт темы справа
        (SideArt, Themes.cs). Веса 100 к 1, а не две звёздочки поровну:
        поровну они делили окно пополам независимо от MaxWidth, и на среднем
        мониторе карточки сжимались. Так левая берёт всё до своего предела,
        а правой достаётся остаток — на узком окне ноль, и арт просто уходит.

        Отступы по вертикали ужаты 30.09 под окно владельца: 1920×1080
        при масштабе Windows 125 % — это 1536×794 точки, и страница была
        на 28 выше. Полоса прокрутки вставала у края карточек вертикальной
        чертой. Добавляя сюда строку, проверьте, что эта высота держится.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ContentColumn" Width="100*" MinWidth="560" MaxWidth="940" />
            <ColumnDefinition x:Name="ArtColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            Арт сбоку. Картинка одна на всю страницу: без укладки руками — по
            высоте страницы, серединой посередине карточки справа (ArtTile).
            До 20.10 под карточками лежал край той же картинки под затемнением
            темы, сходившим к колонке почти на нет; с карточкой-рамкой слой
            обрезан по ней, и затемнение над персонажем — лёгкое, ровное
            (ArtShade). Раскладывается в коде (PlaceArt): место зависит от
            ширины колонок. Не прокручивается — это фон.
        -->
        <Grid x:Name="ArtLayer" Grid.ColumnSpan="2" IsHitTestVisible="False" SizeChanged="OnArtSize">
            <!-- Градиент под картинкой, уложенной руками (HomePlacement, 15.10). -->
            <Rectangle x:Name="ArtGround" />
            <Rectangle x:Name="Art" />
            <Rectangle x:Name="ArtShade" />
        </Grid>

        <!--
            Картинка — в карточке справа (владелец 20.10: «может для главной
            всё-таки место под картинку сделать тайлом?» — «делай»). Сама она
            лежит, как прежде, по странице (ArtLayer, укладка из редактора тем
            долями страницы), но видна только в этой рамке: слой обрезается по
            ней (PlaceArt). Под остальными карточками — ровный фон, без
            персонажа и без затемнения по нему. Рамка с той же высоты, что шапка,
            до нижнего поля страницы; от карточек — 14, как между ними. Раньше
            прокрутки: появись полоса прокрутки, она ляжет поверх края рамки.
        -->
        <Border x:Name="ArtTile" Grid.Column="1" Margin="-18,12,32,10" IsHitTestVisible="False"
                CornerRadius="14" BorderThickness="2" BorderBrush="{DynamicResource Border}"
                SizeChanged="OnArtSize" />

        <ScrollViewer Grid.Column="0" Style="{StaticResource PageScroll}" Padding="32,12,32,10">
            <!--
                Сетка, а не стопка (владелец 04.10: «на весь экран это очень
                странно выглядит»). Не ниже окна: нижняя строка состояния
                стоит у края, как строка состояния. Зазоры между блоками
                растут не больше чем на 16 — первым заходом они делили всю
                лишнюю высоту, и на весь экран карточки расплывались по
                странице с полосами пустоты; остаток теперь уходит под
                быстрые действия. В окне пониже зазоры сжимаются в ноль,
                и вид тот же, что стопкой.
            -->
            <Grid x:Name="Page" MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MaxHeight="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MaxHeight="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MaxHeight="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MaxHeight="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MaxHeight="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Шапка: заголовок и ссылки. Ссылки справа, как в макете. -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <!-- Без подзаголовка: «Главная» помещается без прокрутки (владелец 04.10). -->
                        <TextBlock Text="Главная" Style="{StaticResource Title}" FontSize="28" />
                    </StackPanel>

                    <!--
                        Канал — кнопкой здесь, а не карточкой внизу страницы:
                        в макете карточки нет, а быть на «Главной» ему велено
                        (владелец, 28.09: в «Ещё» кнопку не находили).
                    -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource Ghost}" Click="OnDocs" Margin="0,0,8,0"
                                ToolTip="Описание программы на GitHub">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE82D;" Margin="0,0,8,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Документация" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Ghost}" Click="OnGitHub" Margin="0,0,8,0"
                                ToolTip="Исходники, выпуски, вопросы и обсуждения">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource LineShape}" Data="{StaticResource GitHubMark}" />
                                <TextBlock Text="GitHub" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Ghost}" Click="OnTelegram"
                                ToolTip="Новости в телеграм-канале: что вышло и зачем обновляться, коротко">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource LineShape}" Data="{StaticResource TelegramPlane}" />
                                <TextBlock Text="Telegram" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!--
                    Вышла новая версия (UpdateNotice). Над состоянием: её видно
                    при первом взгляде на окно, а не только тем, кто дошёл вниз.
                    «Не сейчас» прячет её до следующей версии. Решение владельца
                    23.09: карточка и точка у пункта меню, без уведомлений Windows.
                -->
                <local:Card Grid.Row="1" x:Name="UpdateCard" Style="{StaticResource Card}" Margin="0,18,0,0"
                        BorderBrush="{DynamicResource Accent}" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock x:Name="UpdateWhat" Style="{StaticResource Caption}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Ghost}" Content="Что нового"
                                    Click="OnUpdateNotes" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Ghost}" Content="Не сейчас"
                                    Click="OnUpdateLater" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Primary}" Content="Обновить"
                                    Click="OnUpdateNow" />
                        </StackPanel>
                    </Grid>
                </local:Card>

                <!--
                    Просьба о звезде и канале (владелец, 01.10). Одной строкой
                    и прячется навсегда: «Скрыть» пишет SupportCardHidden.
                    Показывается после мастера первого запуска — до него
                    человеку не до звёзд.
                -->
                <local:Card Grid.Row="2" x:Name="SupportCard" Style="{StaticResource Card}" Margin="0,18,0,0"
                        Padding="18,12,12,12" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource LineGlyph}" Text="&#xE735;"
                                   FontSize="18" Foreground="{DynamicResource Warn}"
                                   VerticalAlignment="Center" Margin="0,0,14,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                                       Text="Нравится NetZapret? Поставьте звезду и подпишитесь на канал" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Ghost}" Click="OnStar" Margin="0,0,8,0"
                                    ToolTip="Страница NetZapret на GitHub — звезда справа вверху">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE734;" Margin="0,0,8,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Звезда на GitHub" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Ghost}" Click="OnTelegram" Margin="0,0,8,0"
                                    ToolTip="Новости в телеграм-канале">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource LineShape}" Data="{StaticResource TelegramPlane}" />
                                    <TextBlock Text="Канал" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Ghost}" Click="OnSupportHide" Content="Скрыть"
                                    ToolTip="Больше не показывать" />
                        </StackPanel>
                    </Grid>
                </local:Card>

                <!--
                    Карточка состояния: первое, зачем окно открывают, — понять,
                    идёт ли обход. С 05.11 по выбору владельца — волны туннельного
                    эффекта (TunnelWave) вместо кольца с шестиугольниками и огоньков
                    на линиях (19–22.10): волна идёт слева и проходит сквозь барьер
                    той долей, какую обход сейчас пропускает. Анимации отдана почти
                    вся карточка; кнопка и счётчики — узкой колонкой справа.
                    Надпись лежит поверх левой части, где волна только проявляется
                    (TunnelShape.Fade). Цвет волны и точки внизу — один ключ (ShowDot).
                -->
                <local:Card Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
                    <Grid Height="128">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <local:TunnelWave x:Name="Wave" Grid.Column="0" ClipToBounds="True" />

                        <!-- Не больше двух строк и трёх строк подсказки: карточка постоянной высоты. -->
                        <StackPanel Grid.Column="0" Margin="24,16,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="340">
                            <TextBlock x:Name="StateLine" FontSize="21" FontWeight="SemiBold" Text="Проверяю…"
                                       FontFamily="{DynamicResource DisplayFont}" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" MaxHeight="58" />
                            <TextBlock x:Name="StateHint" Foreground="{DynamicResource Muted}" FontSize="13.5"
                                       Margin="0,4,0,0" TextWrapping="Wrap" Text=""
                                       TextTrimming="CharacterEllipsis" MaxHeight="56" />
                        </StackPanel>

                        <!--
                            Колонка постоянной ширины (владелец 19.10): счётчики растут
                            с трафиком, и без неё карточка дышала бы от «390.4 КБ»
                            к «1.2 ГБ». С 05.11 — узкая: место отдано волне.
                        -->
                        <Border Grid.Column="1" Margin="0,16" BorderThickness="1.5,0,0,0" BorderBrush="{DynamicResource Border}">
                            <StackPanel x:Name="ActionColumn" Width="232" Margin="16,0,16,0" VerticalAlignment="Center">
                                <!--
                                    Одна плашка с чертой (владелец 19.10: «склей две кнопки»):
                                    слева «Запустить» или «Остановить», справа ▾ — перезапуск
                                    и оба выхода, как в трее. «Запустить» залита цветом кнопки —
                                    это главное действие остановленного обхода; «Остановить»
                                    с 05.11 — рамкой (ShowEngineButtons): у работающего
                                    главное — волна, а не кнопка, которую жмут редко.
                                -->
                                <Border x:Name="EngineButtons" Height="36" CornerRadius="10" BorderThickness="1.5"
                                        Background="{DynamicResource AccentFill}" BorderBrush="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="StartButton" Style="{StaticResource SplitLeft}" Click="OnStart" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE768;" Margin="0,0,10,0" FontSize="14"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="Запустить" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="StopButton" Style="{StaticResource SplitLeft}" Click="OnStop" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE71A;" Margin="0,0,10,0" FontSize="14"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                <TextBlock Text="Остановить" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </StackPanel>
                                        </Button>

                                        <Rectangle x:Name="EngineButtonsSeam" Grid.Column="1" Width="1" Margin="0,10"
                                                   Fill="{DynamicResource OnAccent}" Opacity="0.35" />

                                        <Button Grid.Column="2" x:Name="EngineMenuButton" Style="{StaticResource SplitRight}"
                                                Click="OnEngineMenu" ToolTip="Перезапуск и выход">
                                            <Path Style="{StaticResource Chevron}" Margin="0,1,0,0"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="90" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!--
                                    Счётчики — всегда, а не только при работе (владелец 19.10):
                                    при остановленных движках — прочерки. Получено и отдано —
                                    движком туннеля с его запуска; процессор — в долях одного
                                    ядра: winws2 однопоточный (EngineLoad). С 05.11 — сеткой
                                    2×2, каждый в строку, без подписи над числом: колонка
                                    стала узкой, а карточка не выше 128 — иначе «Главная»
                                    в не развёрнутом окне владельца уходит под прокрутку
                                    (HomeFitTests: на 156 страница 666 при видимых 651).
                                    140 проходило при 125 % впритык (651,2 из 651,2), а при
                                    100 % строки прочих карточек округляются вверх, и страница
                                    660 при видимых 652 — так падала сборка на GitHub.
                                -->
                                <Grid x:Name="Meters" Margin="4,12,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="DownMeter" Grid.Row="0" Grid.Column="0" FontSize="13" Background="Transparent"
                                               ToolTip="Получено через движок туннеля с его запуска. В «Гибриде» — то, что пришло из туннеля; в «Туннеле» — всё, включая «напрямую».">
                                        <Run Text="↓ " Foreground="{DynamicResource Muted}" /><Run x:Name="DownValue" Text="—" />
                                    </TextBlock>
                                    <TextBlock x:Name="UpMeter" Grid.Row="0" Grid.Column="1" FontSize="13" Background="Transparent"
                                               ToolTip="Отдано через движок туннеля с его запуска. В «Гибриде» — то, что ушло в туннель; в «Туннеле» — всё, включая «напрямую».">
                                        <Run Text="↑ " Foreground="{DynamicResource Muted}" /><Run x:Name="UpValue" Text="—" />
                                    </TextBlock>
                                    <TextBlock x:Name="CpuMeter" Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" FontSize="13" Background="Transparent">
                                        <Run Text="ЦП " Foreground="{DynamicResource Muted}" /><Run x:Name="CpuValue" Text="—" />
                                    </TextBlock>
                                    <TextBlock x:Name="RamMeter" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" FontSize="13" Background="Transparent">
                                        <Run Text="Память " Foreground="{DynamicResource Muted}" /><Run x:Name="RamValue" Text="—" />
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </local:Card>

                <!-- Пресет и параметры подключения — рядом, как в макете. -->
                <Grid Grid.Row="6" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <local:Card Grid.Column="0" Style="{StaticResource HomeCard}">
                        <StackPanel>
                            <TextBlock Text="Текущий пресет" Style="{StaticResource Caption}" FontSize="12.5" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource IconTile}" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE9E9;" Foreground="{DynamicResource Accent}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="PresetValue" FontSize="15" FontWeight="SemiBold" Text="—"
                                               TextTrimming="CharacterEllipsis" />

                                    <!--
                                        Первая фраза описания из самого файла пресета
                                        («# Description:»), в две строки. Своих описаний
                                        не придумываем: пресеты меняются выпусками,
                                        и придуманное разошлось бы с файлом.
                                    -->
                                    <TextBlock x:Name="PresetNote" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"
                                               Visibility="Collapsed" />
                                </StackPanel>

                                <!--
                                    Смена пресета — тем же, чем в «Десинке»: запись
                                    PresetName и предложение перезапустить. Список
                                    в том же порядке, что там.
                                -->
                                <Button Grid.Column="2" x:Name="PresetMenu" Style="{StaticResource Ghost}"
                                        Padding="12,7" Margin="10,0,0,0" VerticalAlignment="Top" Click="OnPresetMenu">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Изменить" VerticalAlignment="Center" />
                                        <Path Style="{StaticResource Chevron}" Margin="10,1,0,0">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="90" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </local:Card>

                    <!-- Настройка. Только показ: правка — в своих разделах. -->
                    <local:Card Grid.Column="2" Style="{StaticResource HomeCard}">
                        <StackPanel>
                            <TextBlock Text="Параметры подключения" Style="{StaticResource Caption}" FontSize="12.5" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource LineGlyph}" Text="&#xE8CE;" Margin="0,0,0,7" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Caption}" Text="Сервер"
                                           Margin="0,0,14,7" VerticalAlignment="Center" />
                                <!-- Флаг выхода — картинкой, как на вкладке VPN (FlagImages): Windows флагов не рисует. -->
                                <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ServerFlag" Width="22" Height="15" CornerRadius="3" Margin="0,0,8,0"
                                            VerticalAlignment="Center" ClipToBounds="True" Visibility="Collapsed">
                                        <Image x:Name="ServerFlagImage" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Grid.Column="1" x:Name="ServerValue" Text="—"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Grid.Row="1" Style="{StaticResource LineGlyph}" Text="&#xE774;" Margin="0,0,0,7" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Caption}" Text="DNS"
                                           Margin="0,0,14,7" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="DnsValue" Text="—" Margin="0,0,0,7"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="2" Style="{StaticResource LineGlyph}" Text="&#xE7C3;" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Caption}" Text="Подписки"
                                           Margin="0,0,14,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="SubscriptionValue" Text="—"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </local:Card>
                </Grid>

                <!--
                    Предупреждения: защитник в стеке (стёртый hosts с 24.10 — только
                    в «Диагностике»). Отступ — у самих
                    карточек, а не у списка: у пустого списка его отступ оставался
                    и съедал 10 точек высоты (снимок 20.10, «Главную» снова мотали).
                -->
                <ItemsControl Grid.Row="7" x:Name="Warnings">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:Card Style="{StaticResource Card}" Margin="0,8,0,0"
                                    BorderBrush="{DynamicResource Warn}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Warn}" />
                                    <TextBlock Text="{Binding Body}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </local:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="8" x:Name="Problem" Style="{StaticResource Caption}" Foreground="{DynamicResource Danger}"
                           Margin="4,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                <!--
                    Режим — выбором из трёх (владелец 04.10, docs/ideas.md №12):
                    «Десинк», «Туннель», «Гибрид». С 21.09 до 04.10 здесь были
                    два выключателя движков: осмысленных сочетаний у них три,
                    но третье — ради которого программа и написана — из двух
                    рычагов не читалось. Хранится по-прежнему выключателями
                    (Rules.WorkModes): переносить настройки не нужно.

                    Одной карточкой во всю ширину, а не тремя плитками (владелец
                    04.10, снимок на весь экран: «ширина разная… странно
                    выглядит»): три плитки делили ряд на трети, а все прочие
                    ряды — пополам, и края не сходились; строки движков у
                    выбранной плитки меняли её высоту, и страница прыгала при
                    смене режима. Здесь сегменты наверху, а под ними одна строка —
                    пояснение выбранного режима и его движки, всегда одной высоты.
                -->
                <local:Card Grid.Row="10" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="14,12,14,12">
                    <StackPanel>
                        <!-- Подпись — как «Текущий пресет» у соседних карточек и с тем же отступом слева. -->
                        <TextBlock Text="Режим работы NZ" Style="{StaticResource Caption}" FontSize="12.5" Margin="4,0,0,6" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="ModeDesync" Grid.Column="0" Style="{StaticResource ModeSegment}"
                                         GroupName="WorkMode" Tag="Desync" Click="OnMode">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource LineGlyph}" FontSize="16" Text="&#xE9E9;"
                                               Foreground="{DynamicResource Accent}" Margin="0,0,9,0" />
                                    <TextBlock x:Name="ModeDesyncName" FontWeight="SemiBold" FontSize="14.5" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="winws2: портит рукопожатие TLS так, что фильтр оператора не узнаёт имя. Трафик идёт напрямую, адрес домашний.&#x0a;&#x0a;Лечит блокировки по имени, но не отказы по стране." />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="ModeTunnel" Grid.Column="2" Style="{StaticResource ModeSegment}"
                                         GroupName="WorkMode" Tag="Tunnel" Click="OnMode">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource LineGlyph}" FontSize="16" Text="&#xE774;"
                                               Foreground="{DynamicResource Accent}" Margin="0,0,9,0" />
                                    <TextBlock x:Name="ModeTunnelName" FontWeight="SemiBold" FontSize="14.5" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="sing-box: уводит трафик в VPN через свой сетевой адаптер — адрес зарубежный, это лечит отказы по стране.&#x0a;&#x0a;Забирает всё, кроме поставленного «напрямую». Нужна подписка или WARP." />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="ModeRoute" Grid.Column="4" Style="{StaticResource ModeSegment}"
                                         GroupName="WorkMode" Tag="Route" Click="OnMode">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource LineGlyph}" FontSize="16" Text="&#xE8AB;"
                                               Foreground="{DynamicResource Accent}" Margin="0,0,9,0" />
                                    <TextBlock x:Name="ModeRouteName" FontWeight="SemiBold" FontSize="14.5" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Оба движка сразу: что в «Маршрутах» стоит «через VPN», уходит в туннель, остальное идёт напрямую, и закрытое по имени чинит десинк.&#x0a;&#x0a;Российские сервисы видят домашний адрес." />
                                </StackPanel>
                            </RadioButton>
                        </Grid>

                        <!--
                            Пояснение выбранного режима слева, его движки справа.
                            Место — под две строки всегда: в окне по умолчанию
                            пояснение «Гибрида» в одну не влезает, и обрезанное
                            многоточием читалось хуже, а ряд, растущий только
                            у одного режима, снова дёргал бы страницу.
                        -->
                        <Grid Margin="4,10,0,0" Height="34">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="ModeText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="16"
                                       LineStackingStrategy="BlockLineHeight" MaxHeight="32" Margin="0,0,14,0" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel x:Name="DesyncChip" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="DesyncDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource Faint}" />
                                    <TextBlock Margin="7,0,0,0" FontSize="12" Foreground="{DynamicResource Text}" Text="Десинк" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DesyncState" Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource Muted}" Text="—" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DesyncPid" Margin="6,0,0,0" FontSize="11.5" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource IconGhost}" Content="&#xE713;" Margin="6,0,0,0"
                                            Padding="5,2" MinWidth="0" Click="OnDesyncSettings"
                                            ToolTip="Пресеты и рецепты — раздел «Десинк»" />
                                </StackPanel>

                                <StackPanel x:Name="TunnelChip" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Ellipse x:Name="TunnelDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource Faint}" />
                                    <TextBlock Margin="7,0,0,0" FontSize="12" Foreground="{DynamicResource Text}" Text="Туннель" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TunnelState" Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource Muted}" Text="—" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TunnelPid" Margin="6,0,0,0" FontSize="11.5" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource IconGhost}" Content="&#xE713;" Margin="6,0,0,0"
                                            Padding="5,2" MinWidth="0" Click="OnTunnelSettings"
                                            ToolTip="Настройки туннеля" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </local:Card>

                <!-- Жалоба на сочетание движков; пусто — строки нет вовсе, и отступа тоже. -->
                <TextBlock Grid.Row="11" x:Name="EnginesLine" Style="{StaticResource Caption}"
                           Margin="4,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                <!-- Автозапуск и обновление — рядом, как в макете. -->
                <Grid Grid.Row="13" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <local:Card Grid.Column="0" Style="{StaticResource HomeCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource IconTile}" Margin="0,0,14,0">
                                <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE945;" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Автозапуск" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Задача планировщика с правами администратора — запроса UAC при входе нет. Поднимает то же, что кнопка «Запустить»." />
                                </StackPanel>

                                <!--
                                    Что именно поднимется — теми же словами, какими
                                    это задано выключателями движков. Своего выбора
                                    у автозапуска нет намеренно: он был бы вторым
                                    местом, где решают одно и то же.
                                -->
                                <TextBlock x:Name="AutostartRaises" Style="{StaticResource Caption}"
                                           Margin="0,5,0,0" TextWrapping="Wrap" />

                                <!--
                                    Слова о задаче — только когда с ней не всё
                                    ясно: проверяется, не читается, устарела.
                                    «Заведена» и так говорит выключатель. Встают
                                    на место строки выше (AutostartNote).
                                -->
                                <TextBlock x:Name="AutostartValue" Style="{StaticResource Caption}"
                                           Margin="0,5,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                            </StackPanel>

                            <!--
                                Выключатель, а не кнопка «Завести/Убрать» (макет
                                30.09). Щелчок заводит или убирает задачу, а положение
                                затем ставится по ответу планировщика, не по щелчку:
                                отказал планировщик — выключатель вернётся.
                            -->
                            <ToggleButton Grid.Column="2" x:Name="AutostartSwitch" Style="{StaticResource Switch}"
                                          Click="OnAutostart" VerticalAlignment="Top" />
                        </Grid>
                    </local:Card>

                    <views:UpdatePanel Grid.Column="2" x:Name="Updates" />
                </Grid>

                <!--
                    Быстрые действия (макет 30.09): переходы в разделы разбора
                    и папка настроек — то, за чем идут, когда что-то не так.
                    По той же сетке, что ряды выше: две половины с зазором 14,
                    каждая — пополам. Равные четверти от UniformGrid середину
                    сдвигали, и край кнопки не сходился с краем карточки (04.10).
                -->
                <Grid Grid.Row="15" x:Name="Actions" Margin="0,8,0,0" SizeChanged="OnActionsSize">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--
                        Плитками со значком и подписью (макет 19.10): новичку голое
                        «Диагностика» не говорило, зачем туда идти. Содержимое
                        прижато влево (QuickAction), а не по середине кнопки, —
                        иначе значки четырёх плиток стояли бы вразнобой.
                    -->
                    <Button x:Name="ActionCheck" Grid.Column="0" Style="{StaticResource QuickAction}" Click="OnQuickCheck">
                        <views:HomeAction Glyph="&#xE721;" Title="Проверить блокировки" Note="Что закрыто и чем лечится" />
                    </Button>
                    <Button x:Name="ActionLog" Grid.Column="2" Style="{StaticResource QuickAction}" Click="OnQuickLog">
                        <views:HomeAction Glyph="&#xE8FD;" Title="Открыть журнал" Note="Журналы движков" />
                    </Button>
                    <Button x:Name="ActionDoctor" Grid.Column="4" Style="{StaticResource QuickAction}" Click="OnQuickDoctor">
                        <views:HomeAction Glyph="&#xE756;" Title="Диагностика" Note="Что мешает работе" />
                    </Button>
                    <Button x:Name="ActionConfig" Grid.Column="6" Style="{StaticResource QuickAction}" Click="OnQuickConfig"
                            ToolTip="Папка config в проводнике, файл настроек выделен">
                        <views:HomeAction Glyph="&#xE8B7;" Title="Открыть конфиг" Note="Папка с настройками" />
                    </Button>
                </Grid>

                <!--
                    Строка внизу: сколько работает обход и когда собран конфиг
                    туннеля. В макете — «Подписки обновлены»; но списки серверов
                    берутся при сборке конфига на запуске, и отдельного времени
                    обновления подписок программа не хранит. Время файла конфига —
                    то, что известно наверняка, им и названо.
                -->
                <Grid Grid.Row="17" x:Name="Footer" Margin="4,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Ellipse x:Name="FooterDot" Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{DynamicResource Faint}" />
                        <TextBlock x:Name="FooterState" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" x:Name="FooterConfig" Style="{StaticResource Caption}" Margin="16,0,0,0" />
                </Grid>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
