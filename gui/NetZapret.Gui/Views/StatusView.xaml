<UserControl x:Class="NetZapret.Gui.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NetZapret.Gui.Views"
             Background="{DynamicResource Backdrop}">

    <UserControl.Resources>
        <!--
            Сегмент режима в карточке «Режим»: выбранный обведён цветом темы
            и чуть подсвечен подложкой. Выбор — обводкой (см. Choice в Controls.xaml).
        -->
        <Style x:Key="ModeSegment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shape" Background="Transparent"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1.5"
                                CornerRadius="11" Padding="12,9">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Raised}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Shape" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Raised}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--
        Подложка сплошная, а не прозрачная, как у прочих разделов (Chrome):
        окно кладёт картинку темы под всё, а здесь она своя, сдвинутая
        вправо (ArtLayer), — без сплошной подложки под ней проступал бы
        второй, оконный персонаж (снимок 30.09).
    -->

    <!--
        Компоновка — по макету владельца 30.09: шапка со ссылками, крупная
        карточка состояния, под ней пресет и параметры подключения рядом,
        движки, автозапуск с обновлением, быстрые действия и строка внизу.

        Две колонки: содержимое слева, не шире 940, и арт темы справа
        (SideArt, Themes.cs). Веса 100 к 1, а не две звёздочки поровну:
        поровну они делили окно пополам независимо от MaxWidth, и на среднем
        мониторе карточки сжимались. Так левая берёт всё до своего предела,
        а правой достаётся остаток — на узком окне ноль, и арт просто уходит.

        Отступы по вертикали ужаты 30.09 под окно владельца: 1920×1080
        при масштабе Windows 125 % — это 1536×794 точки, и страница была
        на 28 выше. Полоса прокрутки вставала у края карточек вертикальной
        чертой. Добавляя сюда строку, проверьте, что эта высота держится.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ContentColumn" Width="100*" MinWidth="560" MaxWidth="940" />
            <ColumnDefinition x:Name="ArtColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            Арт сбоку. Картинка одна на всю страницу, но сдвинута так, что её
            середина стоит посередине правой колонки: персонаж справа, а под
            карточками — край той же картинки. Под карточками затемнение
            темы, к колонке оно сходит почти на нет (ArtShade). Так карточки
            остаются полупрозрачными, как на прочих вкладках (владелец, 30.09:
            «где стёклышки, почему всё непрозрачное»), и второго, тусклого
            персонажа под ними нет. Раскладывается в коде (PlaceArt): место
            зависит от ширины колонок. Не прокручивается — это фон.
        -->
        <Grid x:Name="ArtLayer" Grid.ColumnSpan="2" IsHitTestVisible="False" SizeChanged="OnArtSize">
            <Rectangle x:Name="Art" />
            <Rectangle x:Name="ArtShade" />
        </Grid>

        <ScrollViewer Grid.Column="0" Style="{StaticResource PageScroll}" Padding="32,16,32,10">
            <!--
                Сетка, а не стопка (владелец 04.10: «на весь экран это очень
                странно выглядит»). Не ниже окна: нижняя строка состояния
                стоит у края, как строка состояния. Зазоры между блоками
                растут не больше чем на 16 — первым заходом они делили всю
                лишнюю высоту, и на весь экран карточки расплывались по
                странице с полосами пустоты; остаток теперь уходит под
                быстрые действия. В окне пониже зазоры сжимаются в ноль,
                и вид тот же, что стопкой.
            -->
            <Grid x:Name="Page" MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MaxHeight="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MaxHeight="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MaxHeight="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MaxHeight="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MaxHeight="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Шапка: заголовок и ссылки. Ссылки справа, как в макете. -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <!-- Без подзаголовка: «Главная» помещается без прокрутки (владелец 04.10). -->
                        <TextBlock Text="Главная" Style="{StaticResource Title}" FontSize="28" />
                    </StackPanel>

                    <!--
                        Канал — кнопкой здесь, а не карточкой внизу страницы:
                        в макете карточки нет, а быть на «Главной» ему велено
                        (владелец, 28.09: в «Ещё» кнопку не находили).
                    -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource Ghost}" Click="OnDocs" Margin="0,0,8,0"
                                ToolTip="Описание программы на GitHub">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE82D;" Margin="0,0,8,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Документация" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Ghost}" Click="OnGitHub" Margin="0,0,8,0"
                                ToolTip="Исходники, выпуски, вопросы и обсуждения">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE943;" Margin="0,0,8,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="GitHub" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Ghost}" Click="OnTelegram"
                                ToolTip="Новости в телеграм-канале: что вышло и зачем обновляться, коротко">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE724;" Margin="0,0,8,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Telegram" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!--
                    Вышла новая версия (UpdateNotice). Над состоянием: её видно
                    при первом взгляде на окно, а не только тем, кто дошёл вниз.
                    «Не сейчас» прячет её до следующей версии. Решение владельца
                    23.09: карточка и точка у пункта меню, без уведомлений Windows.
                -->
                <Border Grid.Row="1" x:Name="UpdateCard" Style="{StaticResource Card}" Margin="0,18,0,0"
                        BorderBrush="{DynamicResource Accent}" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock x:Name="UpdateWhat" Style="{StaticResource Caption}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Ghost}" Content="Что нового"
                                    Click="OnUpdateNotes" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Ghost}" Content="Не сейчас"
                                    Click="OnUpdateLater" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Primary}" Content="Обновить"
                                    Click="OnUpdateNow" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--
                    Просьба о звезде и канале (владелец, 01.10). Одной строкой
                    и прячется навсегда: «Скрыть» пишет SupportCardHidden.
                    Показывается после мастера первого запуска — до него
                    человеку не до звёзд.
                -->
                <Border Grid.Row="2" x:Name="SupportCard" Style="{StaticResource Card}" Margin="0,18,0,0"
                        Padding="18,12,12,12" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource LineGlyph}" Text="&#xE735;"
                                   FontSize="18" Foreground="{DynamicResource Warn}"
                                   VerticalAlignment="Center" Margin="0,0,14,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                                       Text="Нравится NetZapret? Поставьте звезду и подпишитесь на канал" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="Так о программе узнают другие, а вы — о новых версиях." />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Ghost}" Click="OnStar" Margin="0,0,8,0"
                                    ToolTip="Страница NetZapret на GitHub — звезда справа вверху">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE734;" Margin="0,0,8,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Звезда на GitHub" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Ghost}" Click="OnTelegram" Margin="0,0,8,0"
                                    ToolTip="Новости в телеграм-канале">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE724;" Margin="0,0,8,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Канал" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Ghost}" Click="OnSupportHide" Content="Скрыть"
                                    ToolTip="Больше не показывать" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--
                    Карточка состояния. Крупная точка и одна строка словами:
                    первое, зачем окно открывают, — понять, идёт ли обход.
                    Точка со свечением её же цвета (макет 30.09): свечение
                    красится вместе с точкой, в ShowDot, и разойтись им нечем.
                -->
                <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20,12,20,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse x:Name="Dot" Grid.Column="0" Width="26" Height="26"
                                     VerticalAlignment="Center" Margin="4,0,20,0"
                                     Fill="{DynamicResource Faint}">
                                <Ellipse.Effect>
                                    <DropShadowEffect x:Name="DotGlow" ShadowDepth="0" BlurRadius="22"
                                                      Opacity="0.7" Color="Transparent" />
                                </Ellipse.Effect>
                            </Ellipse>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="StateLine" FontSize="21" FontWeight="SemiBold" Text="Проверяю…"
                                           FontFamily="{DynamicResource DisplayFont}" />
                                <TextBlock x:Name="StateHint" Foreground="{DynamicResource Muted}" FontSize="13.5"
                                           Margin="0,5,0,0" TextWrapping="Wrap" Text="" />
                            </StackPanel>

                            <!--
                                Одна кнопка на месте: «Запустить» или «Остановить».
                                Обе залиты цветом кнопки (макет), а не «Остановить»
                                красной рамкой: это главное действие карточки,
                                а не опасное — остановленный обход поднимается
                                той же кнопкой через секунду.
                            -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button x:Name="StartButton" Style="{StaticResource Primary}" Padding="30,11"
                                        MinWidth="210" Click="OnStart" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE768;" Margin="0,0,12,0" FontSize="16"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="Запустить" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="StopButton" Style="{StaticResource Primary}" Padding="30,11"
                                        MinWidth="210" Click="OnStop" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE71A;" Margin="0,0,12,0" FontSize="16"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="Остановить" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!--
                            Полоса состояния — внизу карточки, во всю её ширину.
                            Внутри, но под строкой с кнопкой и постоянной высоты:
                            прежде появлявшаяся внутри полоса раздвигала карточку,
                            и та прыгала при каждом запуске.

                            Цвет несёт то же, что и точка, — серый «стоит», жёлтый
                            «поднимается», зелёный «работает», красный «беда».
                            Бегущая засечка только при подъёме, и она неопределённая
                            намеренно: сколько он займёт, заранее не известно.
                        -->
                        <Border x:Name="StateBar" Height="4" CornerRadius="2" Margin="0,10,0,0"
                                Background="{DynamicResource Border}" ClipToBounds="True"
                                HorizontalAlignment="Stretch">
                            <Grid>
                                <Rectangle x:Name="StateBarFill" RadiusX="2" RadiusY="2"
                                           Fill="{DynamicResource Faint}" />

                                <Rectangle x:Name="StartProgressMark" Width="140" RadiusX="2" RadiusY="2"
                                           HorizontalAlignment="Left" Visibility="Collapsed"
                                           Fill="{DynamicResource WarnFill}">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="StartProgressShift" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Пресет и параметры подключения — рядом, как в макете. -->
                <Grid Grid.Row="6" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Текущий пресет" Style="{StaticResource Caption}" FontSize="12.5" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource IconTile}" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE9E9;" Foreground="{DynamicResource Accent}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="PresetValue" FontSize="15" FontWeight="SemiBold" Text="—"
                                               TextTrimming="CharacterEllipsis" />

                                    <!--
                                        Первая фраза описания из самого файла пресета
                                        («# Description:»), в две строки. Своих описаний
                                        не придумываем: пресеты меняются выпусками,
                                        и придуманное разошлось бы с файлом.
                                    -->
                                    <TextBlock x:Name="PresetNote" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" />
                                </StackPanel>

                                <!--
                                    Смена пресета — тем же, чем в «Десинке»: запись
                                    PresetName и предложение перезапустить. Список
                                    в том же порядке, что там.
                                -->
                                <Button Grid.Column="2" x:Name="PresetMenu" Style="{StaticResource Ghost}"
                                        Padding="12,7" Margin="10,0,0,0" VerticalAlignment="Top" Click="OnPresetMenu">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Изменить" VerticalAlignment="Center" />
                                        <Path Style="{StaticResource Chevron}" Margin="10,1,0,0">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="90" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Настройка. Только показ: правка — в своих разделах. -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Параметры подключения" Style="{StaticResource Caption}" FontSize="12.5" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource LineGlyph}" Text="&#xE8CE;" Margin="0,0,0,9" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Caption}" Text="Сервер"
                                           Margin="0,0,14,9" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="ServerValue" Text="—" Margin="0,0,0,9"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="1" Style="{StaticResource LineGlyph}" Text="&#xE774;" Margin="0,0,0,9" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Caption}" Text="DNS"
                                           Margin="0,0,14,9" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="DnsValue" Text="—" Margin="0,0,0,9"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="2" Style="{StaticResource LineGlyph}" Text="&#xE7C3;" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Caption}" Text="Подписки"
                                           Margin="0,0,14,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="SubscriptionValue" Text="—"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Предупреждения: защитник в стеке, стёртый hosts. Пусто — не показываем. -->
                <ItemsControl Grid.Row="7" x:Name="Warnings" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8"
                                    BorderBrush="{DynamicResource Warn}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Warn}" />
                                    <TextBlock Text="{Binding Body}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="8" x:Name="Problem" Style="{StaticResource Caption}" Foreground="{DynamicResource Danger}"
                           Margin="4,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                <!--
                    Режим — выбором из трёх (владелец 04.10, docs/ideas.md №12):
                    «Десинк», «Туннель», «Гибрид». С 21.09 до 04.10 здесь были
                    два выключателя движков: осмысленных сочетаний у них три,
                    но третье — ради которого программа и написана — из двух
                    рычагов не читалось. Хранится по-прежнему выключателями
                    (Rules.WorkModes): переносить настройки не нужно.

                    Одной карточкой во всю ширину, а не тремя плитками (владелец
                    04.10, снимок на весь экран: «ширина разная… странно
                    выглядит»): три плитки делили ряд на трети, а все прочие
                    ряды — пополам, и края не сходились; строки движков у
                    выбранной плитки меняли её высоту, и страница прыгала при
                    смене режима. Здесь сегменты наверху, а под ними одна строка —
                    пояснение выбранного режима и его движки, всегда одной высоты.
                -->
                <Border Grid.Row="10" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,12,14,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="ModeDesync" Grid.Column="0" Style="{StaticResource ModeSegment}"
                                         GroupName="WorkMode" Tag="Desync" Click="OnMode">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource LineGlyph}" FontSize="16" Text="&#xE9E9;"
                                               Foreground="{DynamicResource Accent}" Margin="0,0,9,0" />
                                    <TextBlock x:Name="ModeDesyncName" FontWeight="SemiBold" FontSize="14.5" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="winws2: вмешивается в рукопожатие TLS так, что фильтр оператора не опознаёт имя. Трафик идёт напрямую, своим обычным путём, и адрес остаётся домашним.&#x0a;&#x0a;Лечит блокировки по имени и не лечит отказы по стране: сайт видит тот же адрес, что и без него." />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="ModeTunnel" Grid.Column="2" Style="{StaticResource ModeSegment}"
                                         GroupName="WorkMode" Tag="Tunnel" Click="OnMode">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource LineGlyph}" FontSize="16" Text="&#xE774;"
                                               Foreground="{DynamicResource Accent}" Margin="0,0,9,0" />
                                    <TextBlock x:Name="ModeTunnelName" FontWeight="SemiBold" FontSize="14.5" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="sing-box: поднимает сетевой адаптер и уводит через него трафик. Адрес становится зарубежным, и это лечит отказы по стране.&#x0a;&#x0a;В этом режиме забирает всё, кроме поставленного «напрямую», — как обычный VPN. Без исключений (настройки туннеля) — вообще всё.&#x0a;&#x0a;Требует подписки или WARP: без них поднимать нечего." />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="ModeRoute" Grid.Column="4" Style="{StaticResource ModeSegment}"
                                         GroupName="WorkMode" Tag="Route" Click="OnMode">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource LineGlyph}" FontSize="16" Text="&#xE8AB;"
                                               Foreground="{DynamicResource Accent}" Margin="0,0,9,0" />
                                    <TextBlock x:Name="ModeRouteName" FontWeight="SemiBold" FontSize="14.5" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Оба движка сразу. Что названо в маршрутах «через VPN», уходит в туннель; остальное идёт напрямую, и закрытое по имени чинит десинк.&#x0a;&#x0a;Адрес для сайтов из маршрутов — зарубежный, для прочих — домашний: российские сервисы не видят VPN." />
                                </StackPanel>
                            </RadioButton>
                        </Grid>

                        <!--
                            Пояснение выбранного режима слева, его движки справа.
                            Место — под две строки всегда: в окне по умолчанию
                            пояснение «Гибрида» в одну не влезает, и обрезанное
                            многоточием читалось хуже, а ряд, растущий только
                            у одного режима, снова дёргал бы страницу.
                        -->
                        <Grid Margin="4,10,0,0" Height="34">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="ModeText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="16"
                                       LineStackingStrategy="BlockLineHeight" MaxHeight="32" Margin="0,0,14,0" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel x:Name="DesyncChip" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="DesyncDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource Faint}" />
                                    <TextBlock Margin="7,0,0,0" FontSize="12" Foreground="{DynamicResource Text}" Text="Десинк" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DesyncState" Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource Muted}" Text="—" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DesyncPid" Margin="6,0,0,0" FontSize="11.5" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource IconGhost}" Content="&#xE713;" Margin="6,0,0,0"
                                            Padding="5,2" MinWidth="0" Click="OnDesyncSettings"
                                            ToolTip="Пресеты и рецепты — раздел «Десинк»" />
                                </StackPanel>

                                <StackPanel x:Name="TunnelChip" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Ellipse x:Name="TunnelDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource Faint}" />
                                    <TextBlock Margin="7,0,0,0" FontSize="12" Foreground="{DynamicResource Text}" Text="Туннель" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TunnelState" Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource Muted}" Text="—" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TunnelPid" Margin="6,0,0,0" FontSize="11.5" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource IconGhost}" Content="&#xE713;" Margin="6,0,0,0"
                                            Padding="5,2" MinWidth="0" Click="OnTunnelSettings"
                                            ToolTip="Настройки туннеля" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Жалоба на сочетание движков; пусто — строки нет вовсе, и отступа тоже. -->
                <TextBlock Grid.Row="11" x:Name="EnginesLine" Style="{StaticResource Caption}"
                           Margin="4,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                <!-- Автозапуск и обновление — рядом, как в макете. -->
                <Grid Grid.Row="13" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource IconTile}" Margin="0,0,14,0">
                                <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE945;" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Автозапуск" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Info}" Margin="2,0,0,0"
                                                    Content="Задача планировщика, а не служба: правами администратора задача наделяется сразу, запрос UAC при входе не появляется. Запускается та же программа и с теми же ключами, что и кнопка «Запустить», — иначе автозапуск поднимал бы не то, что вы проверили руками." />
                                </StackPanel>

                                <!--
                                    Что именно поднимется — теми же словами, какими
                                    это задано выключателями движков. Своего выбора
                                    у автозапуска нет намеренно: он был бы вторым
                                    местом, где решают одно и то же.
                                -->
                                <TextBlock x:Name="AutostartRaises" Style="{StaticResource Caption}"
                                           Margin="0,5,0,0" TextWrapping="Wrap" />

                                <!--
                                    Слова о задаче — только когда с ней не всё
                                    ясно: проверяется, не читается, устарела.
                                    «Заведена» и так говорит выключатель.
                                -->
                                <TextBlock x:Name="AutostartValue" Style="{StaticResource Caption}"
                                           Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                            </StackPanel>

                            <!--
                                Выключатель, а не кнопка «Завести/Убрать» (макет
                                30.09). Щелчок заводит или убирает задачу, а положение
                                затем ставится по ответу планировщика, не по щелчку:
                                отказал планировщик — выключатель вернётся.
                            -->
                            <ToggleButton Grid.Column="2" x:Name="AutostartSwitch" Style="{StaticResource Switch}"
                                          Click="OnAutostart" VerticalAlignment="Top" />
                        </Grid>
                    </Border>

                    <views:UpdatePanel Grid.Column="2" x:Name="Updates" />
                </Grid>

                <!--
                    Быстрые действия (макет 30.09): переходы в разделы разбора
                    и папка настроек — то, за чем идут, когда что-то не так.
                    По той же сетке, что ряды выше: две половины с зазором 14,
                    каждая — пополам. Равные четверти от UniformGrid середину
                    сдвигали, и край кнопки не сходился с краем карточки (04.10).
                -->
                <Grid Grid.Row="15" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource Ghost}" Padding="10,8" Click="OnQuickCheck">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE721;" Margin="0,0,8,0" />
                            <TextBlock Text="Проверить блокировки" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource Ghost}" Padding="10,8" Click="OnQuickLog">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE8FD;" Margin="0,0,8,0" />
                            <TextBlock Text="Открыть журнал" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource Ghost}" Padding="10,8" Click="OnQuickDoctor">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE756;" Margin="0,0,8,0" />
                            <TextBlock Text="Диагностика" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="6" Style="{StaticResource Ghost}" Padding="10,8" Click="OnQuickConfig"
                            ToolTip="Папка config в проводнике, файл настроек выделен">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource LineGlyph}" Text="&#xE8B7;" Margin="0,0,8,0" />
                            <TextBlock Text="Открыть конфиг" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!--
                    Строка внизу: сколько работает обход и когда собран конфиг
                    туннеля. В макете — «Подписки обновлены»; но списки серверов
                    берутся при сборке конфига на запуске, и отдельного времени
                    обновления подписок программа не хранит. Время файла конфига —
                    то, что известно наверняка, им и названо.
                -->
                <Grid Grid.Row="17" Margin="4,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Ellipse x:Name="FooterDot" Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{DynamicResource Faint}" />
                        <TextBlock x:Name="FooterState" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" x:Name="FooterConfig" Style="{StaticResource Caption}" Margin="16,0,0,0" />
                </Grid>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
