<Window x:Class="NetZapret.Gui.Views.TargetPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Что проверить"
        Width="460" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Backdrop}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource Text}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Точечная проверка" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Один сервис целиком — по четыре имени с каждой его части. Либо своё имя, если нужно проверить что-то, чего в справочнике нет." />
        </StackPanel>

        <!--
            Своё имя стоит выше списка намеренно: кто пришёл сюда с готовым
            именем, не должен сперва пролистывать два десятка чужих.
        -->
        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="Своё имя" Style="{StaticResource Caption}" />
            <TextBox x:Name="Own" Margin="0,6,0,0" Padding="10,8"
                     Background="{StaticResource Surface}"
                     Foreground="{StaticResource Text}"
                     BorderBrush="{StaticResource Border}"
                     CaretBrush="{StaticResource Text}"
                     FontFamily="{StaticResource MonoFont}"
                     TextChanged="OnOwnChanged" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Например example.com. Проверяется ровно это имя, четырьмя пробами." />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="Или сервис из справочника" Style="{StaticResource Caption}" />
            <ListBox x:Name="Services" Margin="0,6,0,0"
                     Background="{StaticResource Surface}"
                     Foreground="{StaticResource Text}"
                     BorderBrush="{StaticResource Border}"
                     SelectionChanged="OnServiceChosen"
                     MouseDoubleClick="OnServiceConfirmed" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Отмена" Style="{StaticResource Ghost}" Margin="0,0,8,0" Click="OnCancel" />
            <Button x:Name="Accept" Content="Проверить" Style="{StaticResource Primary}"
                    IsEnabled="False" Click="OnAccept" />
        </StackPanel>
    </Grid>
</Window>
