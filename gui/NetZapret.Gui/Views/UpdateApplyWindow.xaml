<Window x:Class="NetZapret.Gui.Views.UpdateApplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="clr-namespace:NetZapret.Gui"
        Title="NetZapret — Обновление"
        Width="840" Height="660" MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Backdrop}"
        FontFamily="{DynamicResource UiFont}">
    <!--
        Подмена файлов окном вместо чёрного cmd (владелец 12.10, макет из
        ChatGPT по нашему описанию): пять шагов, «Что нового», ошибка с тем,
        кто держит файл, «Повторить», «Вернуть прежнюю», «Запустить как есть».
        Окно — копия программы из runtime\update\updater (UpdateApplier):
        сама программа к этому времени закрыта.
    -->
    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="Heading" Style="{StaticResource Title}" Text="NetZapret" />
            <TextBlock Text="Обновление" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"
                       Foreground="{DynamicResource Muted}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Шаги. -->
            <gui:Card Grid.Column="0" Style="{StaticResource Card}" Padding="20,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="Steps" VerticalAlignment="Top" />
                </ScrollViewer>
            </gui:Card>

            <!-- Что нового — разделы чейнджлога, первая строка каждого. -->
            <gui:Card Grid.Column="2" Style="{StaticResource Card}" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="NotesTitle" Text="Что нового" FontSize="15" FontWeight="SemiBold" />

                    <StackPanel Grid.Row="1" x:Name="Notes" Margin="0,12,0,0" />

                    <TextBlock Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Hyperlink x:Name="AllNotes" Click="OnAllNotes" Foreground="{DynamicResource Accent}"
                                   TextDecorations="{x:Null}">Весь список</Hyperlink>
                    </TextBlock>
                </Grid>
            </gui:Card>
        </Grid>

        <!-- Низ: подсказка, ошибка с кнопками или итог. -->
        <Grid Grid.Row="2" Margin="0,14,0,0">

            <gui:Card x:Name="InfoPanel" Style="{StaticResource Card}" Padding="20,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE946;" FontSize="18"
                               VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                    <TextBlock x:Name="InfoText" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Не закрывайте окно — это займёт несколько секунд." />
                </StackPanel>
            </gui:Card>

            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                <gui:Card Style="{StaticResource Card}" Padding="20,14" BorderBrush="{DynamicResource Danger}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Danger}"
                                VerticalAlignment="Top" Margin="0,1,14,0">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" FontSize="12"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="ErrorTitle" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Danger}" Text="Не удалось заменить файл" />
                            <TextBlock x:Name="ErrorText" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="ErrorHint" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Style="{StaticResource Caption}" />
                            <TextBlock Margin="0,8,0,0">
                                <Hyperlink Click="OnJournal" Foreground="{DynamicResource Accent}"
                                           TextDecorations="{x:Null}">Открыть журнал</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </gui:Card>

                <StackPanel x:Name="ErrorButtons" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="RetryButton" Style="{StaticResource Primary}" Content="Повторить"
                            Padding="22,9" Margin="0,0,10,0" Click="OnRetry" />
                    <Button x:Name="RollBackButton" Style="{StaticResource Ghost}" Content="Вернуть прежнюю"
                            Padding="18,9" Margin="0,0,10,0" Click="OnRollBack" />
                    <Button x:Name="AsIsButton" Style="{StaticResource Ghost}" Content="Запустить как есть"
                            Padding="18,9" Click="OnAsIs"
                            ToolTip="Часть файлов уже новая, часть осталась прежней — программа может работать неверно" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="DonePanel" Visibility="Collapsed">
                <gui:Card Style="{StaticResource Card}" Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="DoneMark" Width="40" Height="40" CornerRadius="20"
                                Background="{DynamicResource Accent}" VerticalAlignment="Center">
                            <TextBlock x:Name="DoneGlyph" FontFamily="{StaticResource IconFont}" Text="&#xE73E;" FontSize="18"
                                       Foreground="{DynamicResource Backdrop}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DoneTitle" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="DoneText" Margin="0,3,0,0" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="2" x:Name="OpenButton" Style="{StaticResource Primary}"
                                Content="Открыть сейчас" Padding="22,9" VerticalAlignment="Center" Click="OnOpenNow" />
                    </Grid>
                </gui:Card>

                <TextBlock x:Name="CloseNote" Style="{StaticResource Caption}" Margin="4,10,0,0"
                           Text="Окно закроется само через несколько секунд." />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
