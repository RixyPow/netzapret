<UserControl x:Class="NetZapret.Gui.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="clr-namespace:NetZapret.Gui"
             Background="{DynamicResource Chrome}">

    <!--
        Мастер по макетам владельца 08.11: на всё окно (меню на это время
        прячет MainWindow), крупный шрифт, три страницы — «Добро пожаловать»,
        тема, режим. Людям, которые программу видят впервые: текста — строка,
        объяснения режимов — одним сравнением (Zapret, VPN, оба вместе).
        До 08.11 — живая схема путей на первом шаге, выбор DNS на третьем,
        мелкий шрифт и «Пропустить» в шапке на каждом шаге.
    -->
    <UserControl.Resources>
        <!-- Карточка режима: выбранная — зелёной рамкой и галочкой в углу. -->
        <Style x:Key="ModeCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Shape" Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="2"
                                    CornerRadius="14" Padding="18,14">
                                <ContentPresenter />
                            </Border>
                            <Grid x:Name="Check" Width="24" Height="24" Margin="0,10,10,0" Visibility="Collapsed"
                                  HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Ellipse Fill="{DynamicResource Accent}" />
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE73E;" FontSize="12"
                                           Foreground="{DynamicResource OnAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Raised}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <!-- Выбор — цветом рамки, а не толщиной: толщина сдвигала бы подпись. -->
                                <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shape" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="PageNote" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="BlockTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- «Пропустить» — текстом, не кнопкой: рядом с «Начать» она не должна спорить. -->
        <Style x:Key="SkipLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="10,8">
                            <TextBlock x:Name="Word" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource Text}" />
                                <Setter TargetName="Word" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка итога: пустая не занимает места. -->
        <Style x:Key="StatusLine" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Кнопки шагов крупнее обычных: их нажимают первыми и ищут глазами. -->
        <Style x:Key="BigPrimary" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Padding" Value="32,12" />
            <Setter Property="MinWidth" Value="148" />
        </Style>

        <Style x:Key="BigGhost" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Padding" Value="28,12" />
            <Setter Property="MinWidth" Value="128" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шаги: три точки, текущая залита, и подпись под ними. -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,20,0,0">
            <StackPanel x:Name="Progress" Orientation="Horizontal" HorizontalAlignment="Center" />
            <TextBlock x:Name="StepLabel" FontSize="14" Foreground="{DynamicResource Muted}"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>

        <!--
            Кнопки шагов — внизу, вне прокрутки (владелец 06.10: на окне 1330×890
            при 125 % «Начать» уходила под край). Прокручивается только шаг.
        -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}" Padding="48,8,48,8">
            <Grid>

                <!-- Шаг 1: добро пожаловать — посередине, без лишнего. -->
                <StackPanel x:Name="Step1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,24,0,24">
                    <Viewbox Width="112" Height="112" HorizontalAlignment="Center">
                        <Canvas Width="256" Height="256" Clip="{x:Static gui:Emblem.Outline}">
                            <Path Data="{x:Static gui:Emblem.Band}" Fill="{DynamicResource LogoBand}"
                                  Stroke="{DynamicResource LogoBand}" StrokeThickness="5" StrokeLineJoin="Round" />
                            <Path Data="{x:Static gui:Emblem.Top}" Fill="{DynamicResource LogoTop}" />
                            <Path Data="{x:Static gui:Emblem.Bottom}" Fill="{DynamicResource LogoBottom}" />
                        </Canvas>
                    </Viewbox>

                    <TextBlock Text="Добро пожаловать в NetZapret" Style="{StaticResource PageTitle}" FontSize="42"
                               TextAlignment="Center" Margin="0,28,0,0" />
                    <TextBlock Style="{StaticResource PageNote}" FontSize="19" TextAlignment="Center" Margin="0,14,0,0"
                               MaxWidth="560"
                               Text="Открывает заблокированные сайты, игры и Telegram. Настройка займёт минуту." />

                    <Button Style="{StaticResource BigPrimary}" Content="Начать" Click="OnIntroNext"
                            FontSize="19" Width="300" Padding="0,15" Margin="0,36,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <!--
                    Шаг 2: тема. Плитка — та же, что в «Оформлении» (112×84, кружок выбора):
                    08.11 по макету была 216×136, и из восемнадцати тем на экран вставало
                    восемь — владелец вернул прежнюю. Все темы видны без прокрутки.
                -->
                <StackPanel x:Name="Step2" Visibility="Collapsed">
                    <TextBlock Text="Выберите тему" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageNote}" Margin="0,6,0,0" Text="Сменить можно в любой момент" />

                    <ItemsControl x:Name="ThemeList" Margin="0,24,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding Id}" Click="OnTheme" Margin="0,0,14,10" Cursor="Hand"
                                        ToolTip="{Binding Tip}" Opacity="{Binding Fade}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Button.Template>

                                    <StackPanel Width="112">
                                        <Grid Height="84">
                                            <Border Margin="1" CornerRadius="11" Padding="1" Background="{Binding Backdrop}">
                                                <Grid>
                                                    <Rectangle RadiusX="10" RadiusY="10" Fill="{Binding Image}" />
                                                    <Rectangle RadiusX="10" RadiusY="10" Fill="{Binding Backdrop}"
                                                               Opacity="{Binding Dim}" />

                                                    <Border Background="{Binding Surface}" CornerRadius="5"
                                                            Width="52" Height="14" Margin="10,10,0,0"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                    <Border Background="{Binding Fill}" CornerRadius="5"
                                                            Width="44" Height="14" Margin="0,30,10,0"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top" />

                                                    <Grid Width="18" Height="18" Margin="0,0,0,9"
                                                          HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                        <Ellipse Stroke="{Binding Ring}" StrokeThickness="1.5" />
                                                        <Ellipse Width="10" Height="10" Fill="{Binding Dot}"
                                                                 Visibility="{Binding DotShown}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <!--
                                                Рамка — поверх картинки, отдельным слоем (владелец 27.10:
                                                «скругления тонкие… рваные»). Border рисует рамку под своим
                                                содержимым, и картинка со скруглением 10 заходила на неё
                                                изнутри: на углах линия выходила тоньше сторон и с рваным краем.
                                                Подложка — на точку внутри рамки: иначе её сглаженный край
                                                темнил бы снаружи сглаженный край рамки.
                                            -->
                                            <Border CornerRadius="12" BorderThickness="2" BorderBrush="{Binding Edge}" />
                                        </Grid>

                                        <TextBlock Text="{Binding Name}" Foreground="{Binding NameColor}"
                                                   HorizontalAlignment="Center" Margin="0,7,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="ThemeStatus" Style="{StaticResource PageNote}" FontSize="15" Margin="4,0,0,0" />
                </StackPanel>

                <!--
                    Шаг 3, последний: подписка, режим и прокси Telegram. Без выхода
                    «Туннель» и «Гибрид» погашены (03.11) — загрузилась подписка,
                    оживают. Выбор пишется при «Готово» (WorkModes.Choose). DNS
                    здесь с 08.11 нет: новичку он ничего не говорит, путь «авто»
                    стоит по умолчанию, сменить — на вкладке DNS.
                -->
                <StackPanel x:Name="StepMode" Visibility="Collapsed">
                    <TextBlock Text="Как будет работать" Style="{StaticResource PageTitle}" />

                    <gui:Card Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,16">
                        <StackPanel>
                            <TextBlock Text="Есть подписка на VPN?" Style="{StaticResource BlockTitle}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--
                                    Пароль, не текст: ссылка на подписку равносильна
                                    паролю, выдаёт весь список серверов с ключами.
                                -->
                                <PasswordBox x:Name="SubLink" VerticalAlignment="Stretch" FontSize="16" MinHeight="44"
                                             VerticalContentAlignment="Center"
                                             gui:Hint.Text="Вставьте ссылку на подписку"
                                             ToolTip="Та же ссылка, что вставляют в Happ" />
                                <Button Grid.Column="1" x:Name="VpnLoad" Style="{StaticResource BigGhost}" Content="Загрузить"
                                        Margin="10,0,0,0" VerticalAlignment="Stretch" Click="OnAddSubscription" />
                            </Grid>

                            <TextBlock x:Name="VpnHint" Style="{StaticResource PageNote}" FontSize="15" Margin="2,10,0,0"
                                       Text="Нет подписки — не страшно: «Десинк» работает и без неё." />
                            <TextBlock x:Name="VpnStatus" Style="{StaticResource StatusLine}" Margin="2,6,0,0" />
                        </StackPanel>
                    </gui:Card>

                    <TextBlock Text="Режим работы" Style="{StaticResource BlockTitle}" Margin="2,20,0,0" />
                    <TextBlock x:Name="ModesLocked" Style="{StaticResource PageNote}" FontSize="15" Margin="2,6,0,0"
                               Foreground="{DynamicResource Warn}" Visibility="Collapsed"
                               Text="«Туннель» и «Гибрид» станут доступны, когда подписка загрузится." />

                    <UniformGrid Rows="1" Margin="-7,12,-7,0">
                        <RadioButton x:Name="PickDesync" Style="{StaticResource ModeCard}" GroupName="OnboardingMode" Tag="Desync" Margin="7,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9E9;" FontSize="28"
                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,2,16,0" />
                                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                                    <TextBlock x:Name="PickDesyncName" FontSize="21" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource PageNote}" FontSize="15" Margin="0,6,0,0"
                                               Text="Как Zapret: открывает заблокированное без VPN" />
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="PickTunnel" Style="{StaticResource ModeCard}" GroupName="OnboardingMode" Tag="Tunnel" Margin="7,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE774;" FontSize="28"
                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,2,16,0" />
                                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                                    <TextBlock x:Name="PickTunnelName" FontSize="21" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource PageNote}" FontSize="15" Margin="0,6,0,0"
                                               Text="Как обычный VPN: весь интернет через сервер" />
                                </StackPanel>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="PickRoute" Style="{StaticResource ModeCard}" GroupName="OnboardingMode" Tag="Route" Margin="7,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8AB;" FontSize="28"
                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,2,16,0" />
                                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                                    <TextBlock x:Name="PickRouteName" FontSize="21" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource PageNote}" FontSize="15" Margin="0,6,0,0"
                                               Text="Zapret и VPN вместе: каждому сайту своё" />
                                </StackPanel>
                            </Grid>
                        </RadioButton>
                    </UniformGrid>

                    <!--
                        Прокси Telegram — заметнее прочего (владелец 08.11): голубой
                        рамкой и подложкой, значком самого Telegram. Стоит то, что
                        в настройках; пишется при «Готово» (TgWsProxy.Switch).
                    -->
                    <Border Margin="0,16,0,8" CornerRadius="14" BorderThickness="2" Padding="20,14"
                            BorderBrush="#FF2AABEE" Background="#1A2AABEE">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Viewbox Width="56" Height="56" Margin="0,0,18,0" VerticalAlignment="Center">
                                <Canvas Width="1000" Height="1000">
                                    <Ellipse Width="1000" Height="1000">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#FF2AABEE" Offset="0" />
                                                <GradientStop Color="#FF229ED9" Offset="1" />
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Path Data="{StaticResource TelegramPlane}" Fill="White" />
                                </Canvas>
                            </Viewbox>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Прокси для Telegram" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock x:Name="TgPickState" Style="{StaticResource PageNote}" FontSize="15" Margin="0,4,0,0"
                                           Text="Telegram заработает без VPN" />
                            </StackPanel>

                            <ToggleButton Grid.Column="2" x:Name="TgPick" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          ToolTipService.ShowOnDisabled="True">
                                <ToggleButton.LayoutTransform>
                                    <ScaleTransform ScaleX="1.25" ScaleY="1.25" />
                                </ToggleButton.LayoutTransform>
                            </ToggleButton>
                        </Grid>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- Кнопки шага: видна полоса текущего (Show), прочие свёрнуты. -->
        <Grid Grid.Row="2" Margin="48,8,48,24">
            <!--
                На первом шаге — только «Пропустить»: вся настройка остаётся
                как есть, мастер не покажется снова (его можно повторить из «Ещё»).
            -->
            <StackPanel x:Name="Step1Buttons" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SkipLink}" Content="Пропустить" Click="OnSkipAll" />
            </StackPanel>

            <StackPanel x:Name="Step2Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                <Button Style="{StaticResource BigGhost}" Content="Назад" Margin="0,0,12,0" Click="OnBack" />
                <Button Style="{StaticResource BigPrimary}" Content="Далее" Click="OnThemeNext" />
            </StackPanel>

            <StackPanel x:Name="StepModeButtons" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                <Button Style="{StaticResource BigGhost}" Content="Назад" Margin="0,0,12,0" Click="OnBack" />
                <Button x:Name="ModeDone" Style="{StaticResource BigPrimary}" Content="Готово" Click="OnModeDone" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
