<UserControl x:Class="NetZapret.Gui.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Backdrop}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,28">
        <Grid HorizontalAlignment="Left" MaxWidth="640">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Добро пожаловать" Style="{StaticResource Title}" />
                    <TextBlock x:Name="StepLabel" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                </StackPanel>

                <!--
                    Пропускает шаг, на котором сейчас стоите, а не весь
                    мастер — подпись меняется на «Готово» на последнем шаге,
                    где пропускать уже нечего.
                -->
                <Button Grid.Column="1" x:Name="HeaderSkip" Style="{StaticResource Ghost}"
                        Content="Пропустить" Click="OnHeaderSkip" VerticalAlignment="Top" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,24,0,0">

                <!-- Шаг 1: подписка на VPN -->
                <StackPanel x:Name="Step1">
                    <TextBlock Text="Есть подписка на VPN?" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Своя подписка — та же ссылка, что вставляют в Happ или другой клиент. Программа её не выдаёт: десинк работает и без неё, но открывает не всё — то, что закрывается по стране (например ChatGPT), лечится только через VPN." />

                    <TextBlock Text="Ссылка на подписку" Style="{StaticResource Caption}" Margin="4,18,0,4" />

                    <!--
                        Пароль, не текст: ссылка на подписку равносильна
                        паролю, выдаёт весь список серверов с ключами.
                    -->
                    <PasswordBox x:Name="SubLink" Padding="10,8" />

                    <TextBlock x:Name="Step1Status" Style="{StaticResource Caption}"
                               Margin="4,10,0,0" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button x:Name="Step1Next" Style="{StaticResource Primary}"
                                Content="Загрузить и продолжить" Click="OnAddSubscription" />
                    </StackPanel>
                </StackPanel>

                <!-- Шаг 2: пробный запуск -->
                <StackPanel x:Name="Step2" Visibility="Collapsed">
                    <TextBlock Text="Пробный запуск" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="Step2Detail" Style="{StaticResource Caption}"
                               Margin="0,8,0,0" TextWrapping="Wrap" />

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <TextBlock x:Name="Step2Status" TextWrapping="Wrap"
                                   Text="Ничего ещё не запускалось." />
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource Ghost}" Content="Назад"
                                Margin="0,0,8,0" Click="OnStep2Back" />
                        <Button x:Name="Step2Start" Style="{StaticResource Primary}"
                                Content="Запустить" Margin="0,0,8,0" Click="OnStep2Start" />
                        <Button Style="{StaticResource Ghost}" Content="Дальше" Click="OnStep2Next" />
                    </StackPanel>
                </StackPanel>

                <!-- Шаг 3: результат -->
                <StackPanel x:Name="Step3" Visibility="Collapsed">
                    <TextBlock Text="Результат" FontSize="17" FontWeight="SemiBold" />

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock x:Name="ResultTitle" FontWeight="SemiBold" TextWrapping="Wrap" />

                            <TextBlock x:Name="ResultVerdict" Style="{StaticResource Mono}"
                                       Margin="0,8,0,0" />

                            <TextBlock x:Name="ResultBody" Style="{StaticResource Caption}"
                                       Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource Ghost}" Content="Назад"
                                Margin="0,0,8,0" Click="OnStep3Back" />
                        <Button Style="{StaticResource Ghost}" Content="Проверить ещё раз"
                                Margin="0,0,8,0" Click="OnStep3Recheck" />
                        <Button Style="{StaticResource Primary}" Content="Готово" Click="OnFinish" />
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
