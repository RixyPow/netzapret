<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Стили без ключа — то есть по умолчанию для всего окна. Иначе каждый
        элемент пришлось бы помечать вручную, и однажды кто-то забудет,
        а забытая кнопка на тёмном фоне выйдет светлой.
    -->

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!--
        Карточка. Скруглённая поверхность с рамкой на тон светлее фона:
        на тёмном именно рамка задаёт границу, тень почти не видна.
    -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18,16" />
    </Style>

    <!--
        Кнопка. Шаблон переопределён целиком: у стандартной внутри своя
        подложка, которая на тёмном фоне остаётся светлой при наведении.
    -->
    <Style x:Key="Ghost" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Background" Value="{DynamicResource Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shape"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Muted}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Surface}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Главное действие раздела: одно на экран, иначе перестаёт быть главным. -->
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Ghost}">
        <Setter Property="Background" Value="{DynamicResource AccentFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFill}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="26,11" />
    </Style>

    <Style x:Key="Destructive" TargetType="Button" BasedOn="{StaticResource Ghost}">
        <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        <Setter Property="Padding" Value="26,11" />
    </Style>

    <!--
        Выпадающий список. Шаблон переопределён целиком: стандартный тянет
        системные цвета, и на тёмном фоне выходит белый прямоугольник
        с невидимым текстом — ровно это и было видно в «Маршрутах».
    -->
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Background" Value="{DynamicResource Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Shape"
                                            Background="{DynamicResource Raised}"
                                            BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ContentPresenter Grid.Column="0" Margin="12,7"
                                                              VerticalAlignment="Center"
                                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />

                                            <Path Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Muted}"
                                                  StrokeThickness="1.4" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Muted}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    CornerRadius="8" Margin="0,4,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <StackPanel IsItemsHost="True" Margin="4" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Shape" Background="Transparent" CornerRadius="6" Padding="10,7">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Raised}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Raised}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Поле ввода: та же беда со светлой подложкой, что у списка. -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentDim}" />
        <Setter Property="Background" Value="{DynamicResource Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Shape" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Поле для скрытого ввода. Шаблон тот же, что у обычного: без него
        подложка остаётся системной, то есть белой, и точки не видно на белом.
    -->
    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentDim}" />
        <Setter Property="Background" Value="{DynamicResource Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Shape" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Строка выбора: пресет, резолвер, сервер. Рамка задаётся снаружи —
        выбранное обводится зелёным, и это единственное, чем оно отличается
        от прочих. Заливкой отмечать нельзя: на тёмном она читается как ещё
        одна поверхность, а не как выбор.
    -->
    <Style x:Key="Choice" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="Padding" Value="16,13" />
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shape"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Raised}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Заголовок папки. Нажимается строка целиком, а не значок: попасть
        в строку легче, чем в треугольник в её начале, а другого действия
        у заголовка нет — промахнуться не во что.
    -->
    <Style x:Key="Folder" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shape"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,10"
                            MinHeight="64">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Muted}" />
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Raised}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Пункт бокового меню. Выбранный помечается полосой слева, а не заливкой:
        заливка на тёмном спорит с карточками справа и читается как ещё одна
        поверхность, а не как выбор.
    -->
    <Style x:Key="RailItem" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Mark"
                                Width="3" HorizontalAlignment="Left"
                                Margin="0,6" CornerRadius="2"
                                Background="Transparent" />
                        <Border x:Name="Shape" Background="Transparent" CornerRadius="8" Margin="8,0,10,0">
                            <TextBlock x:Name="Label"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{DynamicResource Muted}"
                                       FontSize="13"
                                       Margin="14,10" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text}" />
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Surface}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text}" />
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Surface}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Стрелка сворачивания — фигурой, а не знаком шрифта.

        Знаками она была, и это оказалось ошибкой, которую видно глазом.
        Замер 20.09: «▸» U+25B8 и «▾» U+25BE, которыми рисовали маршруты
        и хосты, в Segoe UI отсутствуют — Windows подменяла их чужим
        шрифтом. «►» U+25BA и «▼» U+25BC, которыми рисовали подписки,
        в нём свои. Один и тот же жест выходил на двух вкладках разной
        гарнитурой: разный размер, разный вес, разная высота над строкой.
        Владелец назвал это «стрелочки кривые», и был прав.

        Фигура ни от какого шрифта не зависит. Одна на все разделы: две
        копии разошлись бы при первой же правке — так уже вышло с парами
        «▸/▾» в маршрутах и «►/▼» в подписках.

        Повёрнута поворотом, а не второй фигурой: угол легко связать
        с состоянием, а две фигуры пришлось бы держать в согласии руками.
    -->
    <Style x:Key="Chevron" TargetType="Path">
        <Setter Property="Data" Value="M 0,0 L 5,4 L 0,8 Z" />
        <Setter Property="Fill" Value="{DynamicResource Muted}" />
        <Setter Property="Width" Value="5" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Stretch" Value="Fill" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0" />
            </Setter.Value>
        </Setter>
    </Style>

<!--
        Значки из Assets: info.svg и pin.svg, обведённые контуром.

        Контуром, а не картинкой, по той же причине, по какой стрелка
        сворачивания перестала быть знаком шрифта: фигура не зависит
        ни от шрифта, ни от разрешения экрана и красится темой заодно
        со всем остальным. Картинка потребовала бы двух файлов на две
        темы и всё равно мылилась бы при увеличении.

        Данные взяты из файлов дословно. Править их руками нельзя —
        перерисуйте svg и извлеките заново, иначе исходник и разметка
        разойдутся молча.
    -->
    <Geometry x:Key="InfoGlyph">M6145 12790 c-38 -5 -144 -13 -235 -20 -1284 -91 -2537 -591 -3550 -1419 -318 -260 -646 -588 -911 -911 -823 -1005 -1328 -2267 -1419 -3545 -6 -88 -15 -201 -21 -252 -12 -117 -12 -369 0 -486 6 -51 15 -164 21 -252 91 -1278 596 -2540 1419 -3545 773 -944 1786 -1642 2936 -2025 496 -165 1013 -269 1520 -305 88 -6 201 -15 252 -21 117 -12 369 -12 486 0 51 6 164 15 252 21 1279 91 2534 593 3545 1419 318 260 646 588 911 911 823 1005 1328 2267 1419 3545 6 88 15 201 21 252 12 117 12 369 0 486 -6 51 -15 164 -21 252 -91 1278 -596 2540 -1419 3545 -773 944 -1786 1642 -2936 2025 -496 165 -1013 269 -1520 305 -88 6 -201 15 -252 21 -106 10 -396 10 -498 -1z m565 -1863 c171 -52 312 -133 437 -251 186 -175 273 -387 273 -665 0 -176 -26 -293 -98 -436 -124 -249 -314 -413 -569 -492 -86 -26 -95 -27 -338 -27 -245 -1 -252 0 -338 27 -274 85 -515 284 -618 512 -54 119 -70 198 -76 361 -6 174 8 270 60 394 111 269 322 477 567 559 124 42 202 51 415 47 181 -3 208 -6 285 -29z m658 -5549 l2 -2838 363 0 c275 0 367 -3 380 -12 16 -12 17 -42 15 -348 l-3 -335 -1725 0 -1725 0 -3 335 c-2 306 -1 336 15 348 13 9 105 12 380 12 l363 0 0 2495 0 2495 -377 2 -378 3 -3 330 c-1 181 0 336 3 342 3 11 274 13 1347 11 l1343 -3 3 -2837z</Geometry>
    <Geometry x:Key="PinGlyph">M31.714 11.864l-11.505-11.563c-0.248-0.249-0.605-0.35-0.948-0.266-0.341 0.083-0.613 0.339-0.717 0.674-0.692 2.228-0.773 4.245-0.244 6.084-0.049 0.034-0.095 0.070-0.138 0.113l-5.347 5.346c-1.725-0.8-3.579-1.233-5.428-1.233-1.175 0-2.327 0.174-3.424 0.515-0.334 0.104-0.59 0.375-0.674 0.714s0.014 0.698 0.261 0.947l6.843 6.887-9.568 9.72-0.832 2.192 2.011-0.777 9.793-9.72 6.932 6.977c0.189 0.192 0.447 0.295 0.709 0.295 0.079 0 0.159-0.010 0.238-0.029 0.341-0.084 0.613-0.34 0.717-0.675 0.905-2.913 0.64-6.042-0.636-8.848l5.459-5.46c0.020-0.020 0.033-0.041 0.051-0.063 0.824 0.236 1.678 0.361 2.564 0.361 1.101 0 2.268-0.158 3.468-0.531 0.334-0.104 0.59-0.375 0.674-0.714s-0.015-0.697-0.262-0.945zM18.849 25.755l-12.587-12.669c3.23-0.377 6.714 0.925 9.236 3.447 2.51 2.509 3.735 5.978 3.351 9.221zM18.757 17.392c-0.526-0.804-1.14-1.568-1.845-2.274-0.702-0.702-1.469-1.321-2.28-1.854l4.504-4.503c0.459 0.799 1.052 1.563 1.782 2.291 0.745 0.745 1.534 1.348 2.363 1.814zM22.332 9.639c-1.923-1.923-2.664-4.067-2.271-6.653l8.966 9.012c-2.583 0.37-4.738-0.403-6.695-2.36z</Geometry>

    <!--
        Подсказка. Своя, потому что стандартная в теме выглядит чужой
        и, главное, не переносит строк: длинное пояснение уезжает одной
        строкой за край экрана — а именно длинные пояснения мы в подсказки
        и убираем.

        Ширина ограничена: строка в полторы тысячи точек читается хуже,
        чем абзац в четыреста, даже если поместилась.
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Значок «подробнее». Пояснения, которые прежде стояли абзацами
        над списком, переехали сюда: список маршрутов занимал треть
        полосы, и владелец 21.09 попросил его удлинить.

        Подсказка берётся из Content, чтобы место применения выглядело
        одной строкой и текст стоял рядом с тем, что объясняет.

        Поле вокруг значка заметно больше его самого: сам он восемь точек
        на восемь, и попасть мышью в такое кольцо нельзя. Наводят
        на область, а видят знак.
    -->
    <Style x:Key="Info" TargetType="ContentControl">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Help" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="Transparent" Padding="6,4">
                        <Border.ToolTip>
                            <ToolTip>
                                <TextBlock TextWrapping="Wrap"
                                           Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}" />
                            </ToolTip>
                        </Border.ToolTip>

                        <Path x:Name="Glyph" Data="{StaticResource InfoGlyph}"
                              Fill="{DynamicResource Muted}" Stretch="Uniform"
                              Width="13" Height="13"
                              RenderTransformOrigin="0.5,0.5">
                            <!--
                                Переворот по вертикали: исходник обведён
                                potrace с отрицательным масштабом по Y,
                                и без этого буква стоит вверх ногами —
                                точка внизу, палочка вверху.
                            -->
                            <Path.RenderTransform>
                                <ScaleTransform ScaleY="-1" />
                            </Path.RenderTransform>
                        </Path>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Fill" Value="{DynamicResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>