<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Стили без ключа — то есть по умолчанию для всего окна. Иначе каждый
        элемент пришлось бы помечать вручную, и однажды кто-то забудет,
        а забытая кнопка на тёмном фоне выйдет светлой.
    -->

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!--
        Карточка. Скруглённая поверхность с рамкой на тон светлее фона:
        на тёмном именно рамка задаёт границу, тень почти не видна.
    -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18,16" />
    </Style>

    <!--
        Кнопка. Шаблон переопределён целиком: у стандартной внутри своя
        подложка, которая на тёмном фоне остаётся светлой при наведении.
    -->
    <Style x:Key="Ghost" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shape"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{StaticResource Muted}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{StaticResource Surface}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Главное действие раздела: одно на экран, иначе перестаёт быть главным. -->
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Ghost}">
        <Setter Property="Background" Value="{StaticResource AccentDim}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="#FF06110A" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="26,11" />
    </Style>

    <Style x:Key="Destructive" TargetType="Button" BasedOn="{StaticResource Ghost}">
        <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
        <Setter Property="Foreground" Value="{StaticResource Danger}" />
        <Setter Property="Padding" Value="26,11" />
    </Style>

    <!--
        Пункт бокового меню. Выбранный помечается полосой слева, а не заливкой:
        заливка на тёмном спорит с карточками справа и читается как ещё одна
        поверхность, а не как выбор.
    -->
    <Style x:Key="RailItem" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Mark"
                                Width="3" HorizontalAlignment="Left"
                                Margin="0,6" CornerRadius="2"
                                Background="Transparent" />
                        <Border x:Name="Shape" Background="Transparent" CornerRadius="8" Margin="8,0,10,0">
                            <TextBlock x:Name="Label"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="13"
                                       Margin="14,10" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Text}" />
                            <Setter TargetName="Shape" Property="Background" Value="{StaticResource Surface}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Text}" />
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Shape" Property="Background" Value="{StaticResource Surface}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
