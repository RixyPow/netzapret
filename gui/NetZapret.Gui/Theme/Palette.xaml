<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Тёмная и одна. Светлой темы нет намеренно: это средство обхода,
        его держат открытым минуту в день, и вторая тема означала бы вдвое
        больше мест, где цвет однажды разойдётся с состоянием.

        Оттенки взяты не с потолка — это палитра, которой уже размечены наши
        пресеты (IconColor #3fb950 у Universal V7). Зелёный значит «работает»,
        красный «закрыто», жёлтый «требует внимания», и в отчёте консоли они
        значат ровно то же самое.
    -->

    <Color x:Key="BackdropColor">#FF0D1117</Color>
    <Color x:Key="SurfaceColor">#FF161B22</Color>
    <Color x:Key="RaisedColor">#FF1C2128</Color>
    <Color x:Key="BorderColor">#FF30363D</Color>

    <Color x:Key="TextColor">#FFE6EDF3</Color>
    <Color x:Key="MutedColor">#FF8B949E</Color>
    <Color x:Key="FaintColor">#FF6E7681</Color>

    <Color x:Key="AccentColor">#FF3FB950</Color>
    <Color x:Key="AccentDimColor">#FF2EA043</Color>
    <Color x:Key="DangerColor">#FFF85149</Color>
    <Color x:Key="WarnColor">#FFD29922</Color>

    <!--
        Заливка кнопки и подпись на ней. На тёмном фоне они почти совпадают
        с обычными, но ключи заведены и здесь: стиль кнопки один на обе темы,
        и без них его пришлось бы писать дважды. На светлом они расходятся
        по-настоящему — там текстовый зелёный обязан быть тёмным, а заливка
        с тёмной подписью сливается в грязь.
    -->
    <Color x:Key="AccentFillColor">#FF2EA043</Color>
    <Color x:Key="OnAccentColor">#FF06110A</Color>
    <Color x:Key="WarnFillColor">#FFD29922</Color>

    <SolidColorBrush x:Key="Backdrop" Color="{StaticResource BackdropColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Faint" Color="{StaticResource FaintColor}" />

    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDim" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />

    <SolidColorBrush x:Key="AccentFill" Color="{StaticResource AccentFillColor}" />
    <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="WarnFill" Color="{StaticResource WarnFillColor}" />

    <!--
        Шрифт назван явно. По умолчанию WPF берёт Segoe UI в начертании,
        которое на тёмном фоне выглядит тоньше, чем задумано, — а цифры
        в таблице проверки должны читаться с одного взгляда.
    -->
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

</ResourceDictionary>
