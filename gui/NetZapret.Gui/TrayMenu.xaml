<Window x:Class="NetZapret.Gui.TrayMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetZapret" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" SizeToContent="WidthAndHeight"
        ShowActivated="True" Deactivated="OnDeactivated" KeyDown="OnKeyDown"
>

    <!--
        Меню значка в трее — карточкой в стиле окна, а не системным меню
        WinForms (владелец 24.09: «дать ему нашего стиля»). Всё на
        DynamicResource — те же ключи, что у карточек окна.

        Подложка — размытый снимок того, что под меню, а не прозрачность
        (владелец 24.09: «сделай в трее размытость, а не прозрачность»).
        Системное размытие Windows (подложка DWM и политика акцента) под этим
        окном давало сплошной тёмный слой — снято на экране поверх ярких
        полос, — поэтому размытие своё: снимок в миг открытия, как у стекла
        под карточками окна (Themes.RenderLayer). Подробности — TrayMenu.Blurred.
    -->
    <Window.Resources>
        <!-- Строка выхода: плоская, подсветка при наведении, как пункт меню. -->
        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="{DynamicResource Raised}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Plate" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Сегмент режима — как на «Главной» (StatusView, ModeSegment), только
            мельче: выбранный обведён цветом темы и чуть подсвечен подложкой.
        -->
        <Style x:Key="ModeSegment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shape" Background="Transparent"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1.2"
                                CornerRadius="8" Padding="4,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Raised}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Shape" Property="BorderThickness" Value="1.6" />
                                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Raised}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shape" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        Поля под тень: у окна без рамки она иначе обрезается по краю.
        Подложку карточки (Card.Background) и оттенок (Plate.Background) ставит
        код при каждом показе — по настройкам «Меню в трее» в оформлении.
    -->
    <Border x:Name="Card" Margin="14" CornerRadius="12" BorderThickness="1.5"
            BorderBrush="{DynamicResource Border}" Background="{DynamicResource Surface}"
            LayoutTransform="{DynamicResource UiScaleTransform}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <!--
            Оттенок темы над размытым: сквозь него видно, текст на нём читается.
            Внутренняя кромка — цвет текста темы, едва заметный: на размытом
            фоне одна рамка терялась (владелец 24.09: «более выраженные края»),
            а кромка отделяет карточку и на тёмной теме, и на светлой.
        -->
        <Border x:Name="Plate" Width="280" CornerRadius="10.5" BorderThickness="1">
            <Border.BorderBrush>
                <SolidColorBrush Color="{DynamicResource TextColor}" Opacity="0.12" />
            </Border.BorderBrush>

            <StackPanel Margin="14,12,14,8" TextElement.FontSize="12.5">
                <DockPanel>
                    <TextBlock x:Name="Version" DockPanel.Dock="Right" VerticalAlignment="Bottom"
                               Foreground="{DynamicResource Faint}" FontSize="10.5" />
                    <TextBlock Text="NetZapret" FontFamily="{DynamicResource DisplayFont}"
                               FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                </DockPanel>

                <!-- Главное — идёт ли обход; ради этого меню и открывают. -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Ellipse x:Name="Dot" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{DynamicResource Faint}" />
                    <TextBlock x:Name="State" Margin="7,0,0,0" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" Text="Проверяю…" />
                </StackPanel>

                <Grid Margin="15,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Туннель" Foreground="{DynamicResource Muted}" FontSize="11.5" />
                    <TextBlock x:Name="Tunnel" Grid.Column="1" Margin="10,0,0,0" FontSize="11.5"
                               Foreground="{DynamicResource Muted}" Text="—" />
                    <TextBlock Grid.Row="1" Text="Десинк" Foreground="{DynamicResource Muted}" FontSize="11.5" />
                    <TextBlock x:Name="Desync" Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" FontSize="11.5"
                               Foreground="{DynamicResource Muted}" Text="—" />
                </Grid>

                <!--
                    Режим работы — тем же выбором из трёх, что на «Главной»
                    (владелец 04.10). Утром 04.10 здесь был один выключатель
                    «Всё через VPN» (обсуждение №17) с возвратом к прежнему
                    сочетанию; с тремя режимами возврат — то же одно нажатие
                    на прежний. Выбор сам перезапускает движки (TrayIcon.ChooseMode):
                    ради этого переключатель в трее и просили — не открывать окно.
                -->
                <TextBlock Text="Режим работы NZ" Margin="0,11,0,6" FontSize="11.5"
                           Foreground="{DynamicResource Muted}" />

                <Grid x:Name="Modes">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <RadioButton x:Name="ModeDesync" Grid.Column="0" Style="{StaticResource ModeSegment}"
                                 GroupName="TrayMode" Tag="Desync" Click="OnMode">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource LineGlyph}" FontSize="12.5" Text="&#xE9E9;"
                                       Foreground="{DynamicResource Accent}" Margin="0,0,5,0" />
                            <TextBlock x:Name="ModeDesyncName" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ModeTunnel" Grid.Column="2" Style="{StaticResource ModeSegment}"
                                 GroupName="TrayMode" Tag="Tunnel" Click="OnMode">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource LineGlyph}" FontSize="12.5" Text="&#xE774;"
                                       Foreground="{DynamicResource Accent}" Margin="0,0,5,0" />
                            <TextBlock x:Name="ModeTunnelName" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ModeRoute" Grid.Column="4" Style="{StaticResource ModeSegment}"
                                 GroupName="TrayMode" Tag="Route" Click="OnMode">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource LineGlyph}" FontSize="12.5" Text="&#xE8AB;"
                                       Foreground="{DynamicResource Accent}" Margin="0,0,5,0" />
                            <TextBlock x:Name="ModeRouteName" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </Grid>

                <TextBlock x:Name="ModeNote" FontSize="10.5" Margin="1,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Muted}" />

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="Toggle" Style="{StaticResource Primary}" Content="Запустить"
                            Padding="10,6" Click="OnToggle" />
                    <Button Grid.Column="2" Style="{StaticResource Ghost}" Content="Открыть окно"
                            Padding="10,6" Click="OnShowWindow" />
                </Grid>

                <Border Height="1" Margin="-4,10,-4,4" Background="{DynamicResource Border}" />

                <!--
                    Два выхода, а не один с оговоркой: «убрать значок» и «выключить
                    обход» — разные желания, и ошибка в любую сторону дорогая.
                -->
                <Button Style="{StaticResource MenuRow}" Margin="-6,0" Click="OnQuitKeep"
                        Content="Выйти, движки остаются работать" />
                <Button Style="{StaticResource MenuRow}" Margin="-6,0" Click="OnQuitStop"
                        Foreground="{DynamicResource Danger}" Content="Выйти и остановить движки" />
            </StackPanel>
        </Border>
    </Border>
</Window>
